{
  "judge": {
    "pre_commit_timeout_ms": 5000,
    "pre_push_timeout_ms": 15000,
    "llm_timeout_ms": 30000,
    "warn_on_exceed": true
  },
  "context": {
    "weights": {
      "exact_keyword": 0.40,
      "domain_tag": 0.25,
      "related_decisions": 0.15,
      "acceptance_status": 0.10,
      "recency": 0.10
    },
    "default_limit": 5,
    "min_relevance_threshold": 0.1
  },
  "retirement": {
    "threshold_days": 90,
    "check_tech_removal": true,
    "check_supersession": true,
    "check_policy_mismatch": true
  }
}
