#!/usr/bin/env bash
# PostToolUse hook for adr-kit plugin (v0.21+).
#
# Runs bin/adr-watch --hook in the current project context after Edit/Write
# tool calls. adr-watch reads the PostToolUse JSON payload from stdin,
# extracts tool_input.file_path, and prints at most three compact nudges
# naming the Accepted ADRs that likely apply to the edited file.
#
# adr-watch self-guards: it exits 0 silently when there is no docs/adr/
# with ADRs in the working directory, so this hook is safe in any project.
# It is advisory only and ALWAYS exits 0; it never blocks an edit.
#
# This wrapper just needs to locate Python, run the bin, and pass stdin
# through. Any failure degrades silently (exit 0).

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/../.." && pwd)"

# Locate Python 3 (mirrors the session-start hook's resolver).
_PYTHON3=""
for _cmd in python3 python py; do
  if command -v "$_cmd" >/dev/null 2>&1; then
    _ver=$("$_cmd" --version 2>&1 | grep -oE '[0-9]+\.[0-9]+' | head -1)
    _major=$(echo "$_ver" | cut -d. -f1)
    if [ "${_major:-0}" -ge 3 ] 2>/dev/null; then
      _PYTHON3="$_cmd"
      break
    fi
  fi
done

if [ -z "$_PYTHON3" ]; then
  # Python not found: degrade gracefully, never disturb the session.
  exit 0
fi

WATCH="$PLUGIN_ROOT/bin/adr-watch"
if [ ! -f "$WATCH" ]; then
  exit 0
fi

# Run the watcher with stdin passed through (the PostToolUse JSON payload).
# It always exits 0; any non-zero would be a bug, so swallow it anyway.
"$_PYTHON3" "$WATCH" --hook 2>/dev/null || true

exit 0
