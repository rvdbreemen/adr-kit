{
  "name": "adr-kit",
  "description": "Architecture Decision Record toolkit for AI coding agents: /adr-kit:init bootstrap; pre-commit verification via bin/adr-judge (declarative Enforcement plus opt-in Sonnet LLM judge); /adr-kit:adr authoring and /adr-kit:judge; the ADR Guardian SessionStart staleness detector; and (v0.31, ADR-004) layered context injection: a PreToolUse edit-tier hook injecting the governing ADR's decision before an edit, plus bin/adr-index for a CLAUDE.md-imported decision map.",
  "version": "0.31.0",
  "author": {
    "name": "Robert van den Breemen",
    "url": "https://github.com/rvdbreemen"
  },
  "homepage": "https://github.com/rvdbreemen/adr-kit",
  "repository": "https://github.com/rvdbreemen/adr-kit.git",
  "license": "MIT",
  "keywords": [
    "adr",
    "architecture-decision-records",
    "claude-code",
    "claude-cowork",
    "cursor",
    "github-copilot",
    "codex",
    "agent-skills",
    "ai-coding-assistant",
    "documentation",
    "decision-records",
    "verification-gates",
    "anti-rationalization",
    "lint",
    "guardian",
    "staleness-detection"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/.claude-plugin/hooks/run-hook.cmd\" session-start",
            "timeout": 10,
            "statusMessage": "Checking ADR health..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/.claude-plugin/hooks/run-hook.cmd\" pre-tool-use",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|MultiEdit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/.claude-plugin/hooks/run-hook.cmd\" post-tool-use",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "dependencies": []
}
