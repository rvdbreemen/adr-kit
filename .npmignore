# Do not publish generated Python bytecode or native debug symbols.
**/__pycache__/
**/*.py[cod]
**/*.pdb

# The OpenCode package calls the shared Python CLIs, not the other client
# distributions or repository-only verification material.
tests/
backlog/
docs/
codex/
copilot/
agents/
prompts/
.github/

# Claude-only native hook payloads are not used by the OpenCode adapter.
hooks/bin/
hooks/native/
hooks/hooks.json
hooks/manifest.json
hooks/run-hook.cmd
