#!/usr/bin/env python3
"""adr-audit: are we still on course? (spec R15, TASK-84)

Two questions, one command, because either answer alone is misleading:

  * **Are the decisions any good?** -- `adr-lint`. A clean judge over vague
    ADRs proves nothing, because a vague rule cannot be violated.
  * **Does the code obey them?** -- `adr-judge`. A sharp ADR set nobody checks
    the code against is documentation, not governance.

The caller should not have to know these come from two binaries, nor that the
guardian already runs a version of this combination on a cadence nobody asked
for. `adr-audit` is the on-demand form: a person, a hook or a CI job can
simply demand it.

Two modes:

  --diff PATH|-        judge that diff (the hook and pull-request case)
  --whole-codebase     judge every tracked file as if it were newly added

Whole-codebase mode answers what no per-diff gate can. A rule added after a
file was written has never been applied to that file, and never will be by a
gate that only ever sees changes. Mechanically it is a diff against the empty
tree, so every line reads as added and `forbid_pattern` applies repository
wide; `require_pattern` already reads a snapshot and needs no help. Such a diff
is large by construction, which is exactly what the separate CI-sized budget
from TASK-73 exists for, so this mode passes it rather than failing closed on
size.

**Exit codes separate the two failures**, because "your ADRs are not good
enough" and "your code violates an ADR" have different owners and different
fixes. One conflated non-zero tells the caller nothing about what to go and do:

  0  both clean
  1  the code violates an Accepted ADR      (fix the code, or supersede the ADR)
  3  the ADR set fails its own gates        (fix the records)
  4  both
  2  the audit could not run at all         (tooling or configuration)

3 and 4 sit above 1 rather than below it so that a caller who only checks
`!= 0` still blocks, while a caller who cares can tell the cases apart. Exit 2
keeps its usual meaning across this toolkit: the tool could not answer, which
is never the same as answering "no".

A note on the name. `bin/adr-audit` used to be the init discovery scanner; it
is now `bin/adr-discover`, which is what it does. Two things called audit that
audit different things is precisely the ambiguity ADRs exist to prevent.
"""

from __future__ import annotations

import argparse
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Dict, List, Optional, Tuple

_BIN_DIR = Path(__file__).resolve().parent

# The branch- and repository-sized budget from TASK-73. Deliberately separate
# from judge.max_diff_bytes so raising it here never weakens the commit gate.
WHOLE_CODEBASE_DIFF_BUDGET = 33_554_432

# The empty tree object, which every Git repository has without creating it.
# Diffing against it turns "the codebase" into "one enormous addition".
EMPTY_TREE = "4b825dc642cb6eb9a060e54bf8d69288fbee4904"

EXIT_OK = 0
EXIT_CODE_VIOLATION = 1
EXIT_TOOLING = 2
EXIT_ADR_QUALITY = 3
EXIT_BOTH = 4


class AuditError(Exception):
    """The audit could not run. Distinct from the audit finding something."""


def _run(argv: List[str], cwd: Path, stdin_text: Optional[str] = None,
         timeout: int = 600) -> subprocess.CompletedProcess:
    return subprocess.run(
        argv,
        cwd=str(cwd),
        input=stdin_text,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        timeout=timeout,
        check=False,
    )


# ---------------------------------------------------------------------------
# Half one: are the decisions any good?
# ---------------------------------------------------------------------------

def run_lint(
    adr_dir: Path, repo_root: Path, strict: bool, gates: Optional[str] = None
) -> Dict:
    """Lint the ADRs, at the gate set the caller asked for.

    The gate selector matters more than it looks. This command's own rationale
    is that "a clean judge over a set of vague ADRs proves nothing, because
    vague rules cannot be violated" -- and vagueness is what the `evidence` and
    `clarity` gates measure. Neither was reachable from here: the argv was
    fixed, `--gates` was never passed, and `--strict` does not help because it
    adds `schema` only. Measured on this repository, the default set reported
    zero failures over a set that `--gates all` reports four failures on.
    """
    script = _BIN_DIR / "adr-lint"
    if not script.is_file():
        raise AuditError(f"adr-lint not found at {script}")
    argv = [sys.executable, str(script), "--format", "json",
            "--repo-root", str(repo_root), str(adr_dir)]
    if gates:
        argv[4:4] = ["--gates", gates]
    if strict:
        argv.insert(3, "--strict")
    try:
        result = _run(argv, repo_root)
    except (OSError, subprocess.SubprocessError) as exc:
        raise AuditError(f"adr-lint did not run ({exc})") from exc
    if result.returncode == 2:
        raise AuditError(
            f"adr-lint could not run: {(result.stderr or result.stdout).strip()[:400]}"
        )
    try:
        payload = json.loads(result.stdout or "{}")
    except (json.JSONDecodeError, ValueError) as exc:
        raise AuditError(f"adr-lint returned unreadable JSON ({exc})") from exc

    summary = payload.get("summary") or {}
    failures = [
        {
            "adr": item.get("file"),
            "gate": finding.get("gate"),
            "code": finding.get("code"),
            "summary": finding.get("summary"),
        }
        for item in payload.get("files", [])
        for finding in item.get("findings", [])
        if finding.get("level") == "FAIL"
    ]
    return {
        "clean": not failures,
        "total": summary.get("total", 0),
        "fail": summary.get("fail", 0),
        "advisory": summary.get("advisory", 0),
        "failures": failures,
    }


# ---------------------------------------------------------------------------
# Half two: does the code obey them?
# ---------------------------------------------------------------------------

def whole_codebase_diff(repo_root: Path) -> str:
    """Every tracked file as one addition, via a diff against the empty tree.

    The right-hand side is the working tree, not HEAD, so a local run answers
    the question the person actually asked -- is the code in front of me on
    course? -- and matches the `worktree` snapshot the require rules read. In a
    CI checkout the two are the same bytes, so nothing changes there. Untracked
    files are outside this by construction: git cannot diff what it does not
    track, and an audit that silently skipped them would be worse than one that
    says so.
    """
    try:
        result = _run(
            ["git", "diff", "--unified=0", "--no-color", EMPTY_TREE],
            repo_root,
        )
    except (OSError, subprocess.SubprocessError) as exc:
        raise AuditError(f"git diff against the empty tree failed ({exc})") from exc
    if result.returncode != 0:
        raise AuditError(
            "git diff against the empty tree failed: "
            f"{(result.stderr or '').strip()[:300]}"
        )
    return result.stdout


def read_diff(source: str) -> str:
    if source == "-":
        return sys.stdin.read()
    try:
        return Path(source).read_text(encoding="utf-8", errors="replace")
    except OSError as exc:
        raise AuditError(f"cannot read diff {source}: {exc}") from exc


def run_judge(
    diff_text: str,
    adr_dir: Path,
    repo_root: Path,
    snapshot: str,
    max_diff_bytes: int,
    llm: bool,
) -> Dict:
    script = _BIN_DIR / "adr-judge"
    if not script.is_file():
        raise AuditError(f"adr-judge not found at {script}")
    if not diff_text.strip():
        return {"clean": True, "violations": [], "empty": True}

    argv = [
        sys.executable, str(script),
        "--diff", "-",
        "--adr-dir", str(adr_dir),
        "--repo-root", str(repo_root),
        "--snapshot", snapshot,
        "--max-diff-bytes", str(max_diff_bytes),
        "--json",
    ]
    if llm:
        argv.append("--llm")
    try:
        result = _run(argv, repo_root, stdin_text=diff_text)
    except (OSError, subprocess.SubprocessError) as exc:
        raise AuditError(f"adr-judge did not run ({exc})") from exc
    if result.returncode == 2:
        raise AuditError(
            f"adr-judge could not run: {(result.stderr or result.stdout).strip()[:400]}"
        )
    try:
        payload = json.loads(result.stdout or "{}")
    except (json.JSONDecodeError, ValueError) as exc:
        raise AuditError(f"adr-judge returned unreadable JSON ({exc})") from exc

    findings = payload.get("findings")
    violations = [
        finding
        for finding in (findings if isinstance(findings, list) else [])
        if isinstance(finding, dict) and finding.get("severity") == "violation"
    ]
    return {"clean": not violations, "violations": violations, "empty": False}


# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------

def exit_code(lint: Dict, judge: Dict) -> int:
    bad_adrs = not lint["clean"]
    bad_code = not judge["clean"]
    if bad_adrs and bad_code:
        return EXIT_BOTH
    if bad_adrs:
        return EXIT_ADR_QUALITY
    if bad_code:
        return EXIT_CODE_VIOLATION
    return EXIT_OK


def render_text(lint: Dict, judge: Dict, mode: str, code: int) -> str:
    lines = [f"[adr-audit] {mode}"]

    if lint["clean"]:
        lines.append(
            f"  decisions: OK   {lint['total']} ADR(s), "
            f"{lint['advisory']} advisory"
        )
    else:
        lines.append(f"  decisions: FAIL {lint['fail']} of {lint['total']} ADR(s)")
        for failure in lint["failures"][:10]:
            lines.append(
                f"    {failure['adr']}  {failure['gate']}  {failure['summary']}"
            )
        if len(lint["failures"]) > 10:
            lines.append(f"    ... and {len(lint['failures']) - 10} more")

    if judge.get("empty"):
        lines.append("  code:      OK   nothing to judge (empty diff)")
    elif judge["clean"]:
        lines.append("  code:      OK   no violations of an Accepted ADR")
    else:
        lines.append(f"  code:      FAIL {len(judge['violations'])} violation(s)")
        for violation in judge["violations"][:10]:
            where = violation.get("path") or "?"
            line = violation.get("line")
            location = f"{where}:{line}" if line else where
            lines.append(
                f"    {violation.get('adr', '?')}  {location}  "
                f"{violation.get('message', '')}".rstrip()
            )
        if len(judge["violations"]) > 10:
            lines.append(f"    ... and {len(judge['violations']) - 10} more")

    lines.append(f"  verdict:   exit {code} ({_VERDICTS[code]})")
    return "\n".join(lines)


_VERDICTS = {
    EXIT_OK: "on course",
    EXIT_CODE_VIOLATION: "the code violates an Accepted ADR",
    EXIT_ADR_QUALITY: "the ADR set fails its own gates",
    EXIT_BOTH: "both the ADRs and the code need work",
}


def main(argv: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(
        prog="adr-audit",
        description="Lint the decisions and judge the code in one command.",
        epilog=(
            "Exit codes: 0 clean, 1 code violation, 3 ADR-quality failure, "
            "4 both, 2 the audit could not run."
        ),
    )
    parser.add_argument("--adr-dir", default="docs/adr")
    parser.add_argument("--repo-root", default=".")
    parser.add_argument("--format", choices=["text", "json"], default="text")
    parser.add_argument(
        "--strict", action="store_true",
        help="Treat every advisory ADR finding as a failure.",
    )
    parser.add_argument(
        "--llm", action="store_true",
        help="Also run the judge's LLM pass for llm_judge ADRs.",
    )
    parser.add_argument(
        "--gates", default=None, metavar="LIST",
        help=(
            "Comma-separated lint gates, or 'all'. Passed through to adr-lint. "
            "The default set answers whether the records are structurally "
            "sound; 'evidence' and 'clarity' answer whether they are sharp "
            "enough to be violated, which is the question this command's own "
            "rationale rests on."
        ),
    )
    scope = parser.add_mutually_exclusive_group()
    scope.add_argument(
        "--diff", default=None, metavar="PATH",
        help="Judge this unified diff ('-' for stdin). The hook and PR case.",
    )
    scope.add_argument(
        "--whole-codebase", action="store_true",
        help=(
            "Judge every tracked file as newly added, so forbid rules reach "
            "code no recent diff touched. Uses the CI-sized diff budget."
        ),
    )
    parser.add_argument(
        "--max-diff-bytes", type=int, default=None,
        help=f"Diff budget. Default {WHOLE_CODEBASE_DIFF_BUDGET} whole-codebase.",
    )
    parser.add_argument(
        "--snapshot", choices=["staged", "worktree", "diff"], default=None,
        help="Post-image source for require_pattern. Default worktree.",
    )
    args = parser.parse_args(argv)

    repo_root = Path(args.repo_root).resolve()
    adr_dir = Path(args.adr_dir)
    if not adr_dir.is_absolute():
        adr_dir = repo_root / adr_dir

    # A scope must be named. Defaulting to stdin looks convenient and is the one
    # shape that can answer wrongly in silence: with stdin closed -- a CI step, a
    # cron job, a script that used to call the old `bin/adr-audit` discovery
    # scanner and was never renamed -- the diff reads empty, nothing is judged,
    # and the command prints "on course" and exits 0. A tool that cannot check
    # must not pretend it did, so it refuses instead and says which flag to add.
    if not args.whole_codebase and args.diff is None:
        print(
            "adr-audit: name a scope. Use --whole-codebase to audit every tracked "
            "file, or --diff PATH ('-' for stdin) to audit one diff.\n"
            "  (Looking for the init discovery scanner? It is now bin/adr-discover.)",
            file=sys.stderr,
        )
        return EXIT_TOOLING

    try:
        if args.whole_codebase:
            mode = "whole codebase"
            diff_text = whole_codebase_diff(repo_root)
            budget = args.max_diff_bytes or WHOLE_CODEBASE_DIFF_BUDGET
        else:
            mode = "diff"
            diff_text = read_diff(args.diff)
            budget = args.max_diff_bytes or WHOLE_CODEBASE_DIFF_BUDGET

        lint = run_lint(adr_dir, repo_root, args.strict, args.gates)
        judge = run_judge(
            diff_text, adr_dir, repo_root,
            args.snapshot or "worktree", budget, args.llm,
        )
    except AuditError as exc:
        print(f"adr-audit: {exc}", file=sys.stderr)
        return EXIT_TOOLING

    code = exit_code(lint, judge)
    if args.format == "json":
        print(json.dumps(
            {
                "mode": mode,
                "decisions": lint,
                "code": judge,
                "exit_code": code,
                "verdict": _VERDICTS[code],
            },
            indent=2, ensure_ascii=False,
        ))
    else:
        print(render_text(lint, judge, mode, code))
    return code


if __name__ == "__main__":
    if hasattr(sys.stdout, "reconfigure"):
        try:
            sys.stdout.reconfigure(encoding="utf-8")
            sys.stderr.reconfigure(encoding="utf-8")
        except (AttributeError, ValueError, OSError):
            pass
    raise SystemExit(main())
