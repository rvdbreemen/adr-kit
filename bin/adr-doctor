#!/usr/bin/env python3
"""Fast, evidence-backed ADR Kit health checks and bounded deep probes."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
for import_root in (ROOT, ROOT / "bin", ROOT / "scripts"):
    if str(import_root) not in sys.path:
        sys.path.insert(0, str(import_root))

from adr_doctor_checks import run_client_checks
from adr_doctor_probes import run_deep_extensions
from adr_doctor_core import render_text as render_adr_text
from adr_doctor_core import run_doctor as run_adr_doctor
from adr_doctor_models import build_report, render_human


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="adr-doctor",
        description="Check ADR state and Claude/Codex/Copilot integration.",
    )
    parser.add_argument("adr_dir", nargs="?", default="docs/adr")
    parser.add_argument("--repo-root")
    parser.add_argument("--plugin-root", type=Path, default=ROOT)
    parser.add_argument("--config")
    parser.add_argument("--global-settings", type=Path)
    parser.add_argument("--stale-days", type=int)
    parser.add_argument("--format", choices=("text", "human", "json"), default="text")
    parser.add_argument("--check", action="store_true", help="Diagnose without repair.")
    parser.add_argument("--fix", action="store_true", help="Permit backed-up managed rewrites.")
    parser.add_argument("--deep", action="store_true", help="Run bounded native, MCP, and model probes.")
    parser.add_argument("--fix-index", action="store_true", help=argparse.SUPPRESS)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    root = Path(args.repo_root).resolve() if args.repo_root else Path.cwd().resolve()
    # Backward compatibility: --fix-index is an explicit safe-repair request.
    # Default mode also repairs safe owned state; --check is the read-only gate.
    args.fix_index = bool(args.fix_index or not args.check)
    adr = run_adr_doctor(args)
    checks, repairs = run_client_checks(
        root,
        args.plugin_root.resolve(),
        global_settings=args.global_settings,
        check_only=args.check,
        allow_fix=args.fix,
    )
    extensions = run_deep_extensions(
        root,
        args.plugin_root.resolve(),
        checks=checks,
        global_settings=args.global_settings,
        check_only=args.check,
    ) if args.deep else []
    report = build_report(
        root=root,
        mode="deep" if args.deep else "fast",
        adr=adr,
        checks=[*checks, *extensions],
        repairs=repairs,
    )
    if args.format == "json":
        print(json.dumps(report, indent=2, sort_keys=True))
    elif args.format == "text" and not checks and not extensions:
        print(render_adr_text(adr))
    else:
        print(render_human(report))
    return int(report["exit_code"])


if __name__ == "__main__":
    raise SystemExit(main())
