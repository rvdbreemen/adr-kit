#!/usr/bin/env python3
"""adr-embed: build and query the ADR vector store (ADR-018, adr-vector-store-v1).

This is the explicit build step ADR-018 requires. It is the only place in the
kit that may call an embedding model, and it is invoked by a human or a CI job
rather than by a prompt. Nothing embeds because someone typed a message.

Subcommands:
  build    embed every ADR and write the store
  status   report presence, model identity, and what has drifted since
  query    semantic search, for checking the store does what it claims

The read paths -- `status` and `query` against an existing store -- touch no
model and no network beyond embedding the query itself, which `query` needs by
definition and `status` does not do at all.
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
import sys
from datetime import date
from pathlib import Path
from typing import Dict, List, Optional

_BIN_DIR = Path(__file__).resolve().parent


def _load_sibling(name: str):
    cached = sys.modules.get(name)
    if cached is not None:
        return cached
    loader = importlib.machinery.SourceFileLoader(name, str(_BIN_DIR / f"{name}.py"))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


_load_sibling("adr_format")
_load_sibling("adr_schema")
_load_sibling("adr_catalog")
store_mod = _load_sibling("adr_vector_store")
llm_mod = _load_sibling("adr_llm")

from adr_catalog import load_adr_records  # noqa: E402

DEFAULT_EMBED_MODEL = "nomic-embed-text"
EMBED_TIMEOUT_S = 120


class EmbedError(Exception):
    """Raised when the build cannot proceed and saying so is the right answer."""


def _read_json(path: Path) -> Dict:
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def _records(adr_dir: Path) -> List[Dict]:
    rows = load_adr_records(adr_dir)
    # adr_catalog names the identifier adr_id; the store speaks the same word.
    return [row for row in rows if row.get("adr_id")]


def _resolve_embed_backend(adr_dir: Path):
    """Reuse the judge registry, as the maintainer decided for TASK-79.

    One registry, one setting, one security rule. The cost of that reuse is
    stated rather than hidden: changing the judge backend changes the embedding
    model, which marks the whole store stale. The recorded model identity is
    what makes that visible instead of silent.
    """
    project = _read_json(adr_dir / ".adr-kit.json")
    local = _read_json(adr_dir / llm_mod.LOCAL_CONFIG_NAME)
    judge_cfg = project.get("judge") or {}
    # cli_cmd is None here on purpose: an embedding build has no --llm-cmd
    # escape hatch, so the backend can only come from the registry.
    backend, warnings = llm_mod.resolve_llm_backend(
        judge_cfg, local, None, dict(os.environ)
    )
    for warning in warnings:
        print(f"[adr-embed] WARN: {warning}", file=sys.stderr)
    if backend is None:
        raise EmbedError(
            "no backend is configured, so there is nothing to embed with. "
            "Run `adr-settings --check-embedding` for the routes forward."
        )
    reason = backend.embed_unavailable_reason()
    if reason:
        raise EmbedError(
            f"{reason}. Point judge.backend at a runtime that embeds "
            "(ollama or openai-compatible); see `adr-settings --check-embedding`."
        )
    return backend


def _configured_model(adr_dir: Path) -> str | None:
    """`embedding.model` from the project config, when it is set.

    Setup asks the user to consent to a download -- `qwen3-embedding:8b` is about
    4.7 GB -- and the model they agreed to had nowhere to be recorded, so the
    next `adr-embed build` silently used the hardcoded default instead. Under
    ADR-018's own rule a model-identity mismatch marks the store stale, so the
    visible outcome was either a wasted download or retrieval quietly falling
    back to lexical: exactly the discover-it-later failure spec R16 exists to
    prevent.

    Fail-soft on purpose. An unreadable or malformed config yields None and the
    caller falls through to the default, because refusing to build a store over
    a typo in an unrelated key would be a worse trade than building it with the
    default model and recording that identity honestly.
    """
    try:
        raw = json.loads((adr_dir / ".adr-kit.json").read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return None
    if not isinstance(raw, dict):
        return None
    block = raw.get("embedding")
    if not isinstance(block, dict):
        return None
    value = block.get("model")
    return value if isinstance(value, str) and value.strip() else None


def command_build(args) -> int:
    adr_dir = Path(args.adr_dir)
    records = _records(adr_dir)
    if not records:
        raise EmbedError(f"no ADRs found in {adr_dir}")

    backend = _resolve_embed_backend(adr_dir)
    model = args.model or _configured_model(adr_dir) or DEFAULT_EMBED_MODEL
    texts = [store_mod.embed_text(record) for record in records]

    print(f"[adr-embed] embedding {len(texts)} ADR(s) with {model} via {backend.kind}...", file=sys.stderr)
    vectors = backend.embed(texts, model, args.timeout)
    if vectors is None or len(vectors) != len(texts):
        raise EmbedError(
            "the backend returned no usable vectors. Nothing was written; "
            "retrieval keeps working on lexical ranking."
        )

    entries = store_mod.build_entries(records, vectors)
    path = store_mod.write_store(adr_dir, entries, model, backend.kind, args.date)
    return _emit(
        args,
        {
            "action": "build",
            "store": str(path),
            "entries": len(entries),
            "dimension": len(vectors[0]),
            "model": model,
            "backend": backend.kind,
        },
        [
            f"built {len(entries)} entries at {len(vectors[0])} dimensions",
            f"model {model} via {backend.kind}",
            f"written to {path}",
        ],
    )


def command_status(args) -> int:
    adr_dir = Path(args.adr_dir)
    store, reason = store_mod.load_store(adr_dir)
    if store is None:
        return _emit(
            args,
            {"action": "status", "usable": False, "reason": reason},
            [
                f"vector store unusable: {reason}",
                "retrieval falls back to lexical ranking, which is not an error",
            ],
        )
    drift = store_mod.staleness(store, _records(adr_dir))
    lines = [
        f"model {store['model']} via {store['backend']}, "
        f"{len(store['entries'])} entries at {store['dimension']} dimensions",
        f"built {store['built_at']}",
    ]
    if drift["stale"]:
        lines.append("STALE - rebuild with `adr-embed build`:")
        for label in ("changed", "missing", "removed"):
            if drift[label]:
                lines.append(f"  {label}: {', '.join(drift[label])}")
    else:
        lines.append("current: every ADR matches its stored vector")

    # Two different problems with two different fixes, so they are reported
    # separately. "The content changed" wants a rebuild. "The index is stale or
    # absent" wants `bin/adr-index`, and until then a search cannot say which
    # decisions still govern -- the store's own copy of status is frozen at
    # build time and a supersession never touches the hashed text.
    authority = store_mod.load_authority(adr_dir)
    if authority is None:
        authority_state = "unavailable"
        lines.append(
            "AUTHORITY UNAVAILABLE - no readable ADR-INDEX.json; run "
            "`bin/adr-index docs/adr`. Until then a search cannot tell a "
            "governing decision from a superseded one."
        )
    else:
        orphaned = sorted(
            str(entry.get("adr_id"))
            for entry in store["entries"]
            if str(entry.get("adr_id")) not in authority
        )
        authority_state = "orphaned-entries" if orphaned else "current"
        if orphaned:
            lines.append(
                "entries with no ADR in the index (dropped from results): "
                + ", ".join(orphaned)
            )
    return _emit(args, {"action": "status", "usable": True, "store": {
        "model": store["model"], "backend": store["backend"],
        "entries": len(store["entries"]), "dimension": store["dimension"],
        "built_at": store["built_at"],
    }, "drift": drift, "authority": authority_state}, lines)


def command_query(args) -> int:
    adr_dir = Path(args.adr_dir)
    store, reason = store_mod.load_store(adr_dir)
    if store is None:
        raise EmbedError(f"{reason}; build it first with `adr-embed build`")
    backend = _resolve_embed_backend(adr_dir)
    vectors = backend.embed([args.query], store["model"], args.timeout)
    if not vectors:
        raise EmbedError("could not embed the query; the backend returned nothing")
    results = store_mod.search(
        store, vectors[0], limit=args.limit,
        include_historical=args.include_historical,
        # The vectors find; the index decides. Without this the store answers
        # from a frozen copy of status that a supersession never invalidates.
        authority=store_mod.load_authority(adr_dir),
    )
    lines = [f"{row['similarity']:.3f}  {row['adr_id']}  [{row['authority']}]  {row['title']}" for row in results]
    return _emit(args, {"action": "query", "query": args.query, "results": results}, lines or ["no results"])


def _emit(args, payload: Dict, lines: List[str]) -> int:
    if args.format == "json":
        print(json.dumps(payload, indent=2, ensure_ascii=False))
    else:
        for line in lines:
            print(line)
    return 0


def main(argv: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(
        prog="adr-embed",
        description="Build and query the ADR vector store (ADR-018).",
    )
    parser.add_argument("--adr-dir", default="docs/adr")
    parser.add_argument("--format", choices=["text", "json"], default="text")
    sub = parser.add_subparsers(dest="command", required=True)

    build = sub.add_parser("build", help="embed every ADR and write the store")
    build.add_argument("--model", default=None, help=f"embedding model (default {DEFAULT_EMBED_MODEL})")
    build.add_argument("--timeout", type=int, default=EMBED_TIMEOUT_S)
    build.add_argument("--date", default=date.today().isoformat())

    sub.add_parser("status", help="report presence, model identity and drift")

    query = sub.add_parser("query", help="semantic search over the store")
    query.add_argument("query")
    query.add_argument("--limit", type=int, default=5)
    query.add_argument("--timeout", type=int, default=EMBED_TIMEOUT_S)
    query.add_argument("--include-historical", action="store_true")

    args = parser.parse_args(argv)
    try:
        if args.command == "build":
            return command_build(args)
        if args.command == "status":
            return command_status(args)
        return command_query(args)
    except EmbedError as exc:
        print(f"adr-embed: {exc}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    if hasattr(sys.stdout, "reconfigure"):
        try:
            sys.stdout.reconfigure(encoding="utf-8")
            sys.stderr.reconfigure(encoding="utf-8")
        except (AttributeError, ValueError, OSError):
            pass
    raise SystemExit(main())
