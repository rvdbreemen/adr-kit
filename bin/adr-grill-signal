#!/usr/bin/env python3
"""Emit bounded, non-blocking ADR grill advisories from the generated index."""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import subprocess
import sys
from pathlib import Path

_BIN_DIR = Path(__file__).resolve().parent


def _load_sibling(name: str):
    """Import bin/<name>.py by explicit path, WITHOUT touching sys.path.

    SEC-HIGH (TASK-62): this script carried no sys.path.insert, but it still
    resolved its siblings through CPython's implicit sys.path[0] -- the script's
    own directory. That is the same shadowing surface the insert created (a
    module committed next to this file wins over the standard library), and it
    meant the script could not run under -P / PYTHONSAFEPATH at all. Siblings
    are registered in sys.modules under their bare name so the plain
    `from adr_* import ...` below resolves from the cache instead of the path.
    bin/adr-judge carries the full rationale.
    """
    cached = sys.modules.get(name)
    if cached is not None:
        return cached
    loader = importlib.machinery.SourceFileLoader(name, str(_BIN_DIR / f"{name}.py"))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


_load_sibling("adr_grill_signal")


from adr_grill_signal import analyze_index, normalize_path


def _staged(root: Path) -> tuple[list[str], str]:
    names = subprocess.run(
        ["git", "diff", "--cached", "--name-only", "-M"],
        cwd=root,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        timeout=5,
    )
    diff = subprocess.run(
        ["git", "diff", "--cached", "--unified=0", "-M"],
        cwd=root,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        timeout=5,
    )
    if names.returncode or diff.returncode:
        raise ValueError(names.stderr.strip() or diff.stderr.strip() or "git diff failed")
    return (
        sorted(
            {normalize_path(line) for line in names.stdout.splitlines() if line.strip()},
            key=str.casefold,
        ),
        diff.stdout,
    )


def _human(report: dict) -> str:
    lines = []
    for item in report["linked_proposed"]:
        lines.append(
            f"[adr-grill] STRONG {item['adr_id']} "
            f"({','.join(item['evidence'])}) -> {item['command']}"
        )
    for item in report["suspected_decisions"]:
        lines.append(
            f"[adr-grill] ADVISORY {item['path']} may contain a durable decision "
            f"-> {item['command']}"
        )
    return "\n".join(lines)


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo-root", default=".")
    parser.add_argument("--index", default="docs/adr/ADR-INDEX.json")
    parser.add_argument("--staged", action="store_true")
    parser.add_argument("--paths", nargs="*", default=[])
    parser.add_argument("--source-text", default="")
    parser.add_argument("--shell", choices=("posix", "powershell"), default="posix")
    parser.add_argument("--format", choices=("human", "json"), default="human")
    args = parser.parse_args()
    try:
        root = Path(args.repo_root).expanduser().resolve()
        index_input = Path(args.index).expanduser()
        index_path = index_input if index_input.is_absolute() else root / index_input
        if not root.is_dir() or not index_path.is_file():
            raise ValueError("repository root or ADR index not found")
        if index_path.stat().st_size > 2 * 1024 * 1024:
            raise ValueError("ADR index exceeds size limit")
        index = json.loads(index_path.read_text(encoding="utf-8"))
        paths, source = _staged(root) if args.staged else (args.paths, args.source_text)
        report = analyze_index(index, paths, source, shell=args.shell)
    except (
        OSError,
        UnicodeError,
        ValueError,
        json.JSONDecodeError,
        subprocess.TimeoutExpired,
    ) as exc:
        print(f"adr-grill-signal: {exc}", file=sys.stderr)
        return 2
    if args.format == "json":
        print(json.dumps(report, indent=2, ensure_ascii=False, sort_keys=True))
    else:
        output = _human(report)
        if output:
            print(output)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
