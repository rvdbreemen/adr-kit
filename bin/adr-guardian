#!/usr/bin/env python3
"""adr-guardian: periodic ADR-set health detector for adr-kit (v0.18.0+).

Three subcommands:

  adr-guardian check
      The SessionStart hook entry point. Reads docs/adr/.adr-kit-state.json and
      docs/adr/.adr-kit.json, computes which health tiers are due, and prints the
      [adr-guardian] block as JSON additionalContext for Claude Code's SessionStart
      hook. ALWAYS exits 0. NEVER runs an LLM. NEVER spawns subprocesses.
      Prints nothing when no tier is due or when the guardian is disabled.

  adr-guardian stamp <cheap|llm> [--violations N] [--retire N] [--suggest N] [--audit N] [--lint STR] [--coverage PCT]
      Record that a sweep tier completed. Updates .adr-kit-state.json and appends
      an entry to the append-only trend list (capped at 52 entries). Called by
      the /adr-kit:guardian skill after a sweep completes. Always exits 0.

  adr-guardian state
      Print the current .adr-kit-state.json as formatted JSON to stdout. Exits 0
      even when the file is missing (prints a default-empty state).

Design invariants (match spec §3 / §12):
  - check: pure read-only on ADRs (just counts files); never spawns; always exit 0.
  - stamp: writes only .adr-kit-state.json; always exit 0.
  - cwd-guard: check exits 0 silently when cwd has no docs/adr/ with ADRs.
  - nudge_cooldown_hours: check skips output if last_nudged is within the window.

Multi-session safety (task-9):
  - .adr-kit-state.json is per-machine ADVISORY data, not a ledger. Concurrent
    sessions may stamp at the same time; a cross-process lock serializes each
    complete read-modify-write transaction so unrelated updates are preserved.
  - Writes are atomic: state is written to a unique temp file in the same
    directory, then moved into place with os.replace (atomic on both POSIX and
    NTFS). A reader can never observe a partial file.
  - Corrupt or partial state files are tolerated on read: they are treated as
    empty state, one warning line goes to stderr, and the next stamp overwrites
    the file with valid JSON. The guardian never crashes on a bad state file.
  - Blocking advisory locking uses fcntl on POSIX and msvcrt on Windows.
    Failure to acquire the lock skips the advisory update instead of writing
    unlocked and risking lost state.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import sys
from datetime import datetime, timezone
from pathlib import Path
import io
from typing import Dict, List, Optional, Tuple

_BIN_DIR = Path(__file__).resolve().parent
if str(_BIN_DIR) not in sys.path:
    sys.path.insert(0, str(_BIN_DIR))

from adr_state import load_state, update_state


# ---------------------------------------------------------------------------
# UTF-8 stream setup (mirrors adr-suggest._ensure_utf8_streams)
# ---------------------------------------------------------------------------


def _ensure_utf8_streams() -> None:
    """Force stdout/stderr to UTF-8 on Windows where the console may default to cp1252."""
    for stream in (sys.stdout, sys.stderr):
        if hasattr(stream, "reconfigure"):
            try:
                stream.reconfigure(encoding="utf-8")
            except (AttributeError, io.UnsupportedOperation):
                pass


# ---------------------------------------------------------------------------
# State-file helpers
# ---------------------------------------------------------------------------

DEFAULT_STATE: Dict = {
    "cheap_tier": {
        "last_run": None,
        "drift_violations": 0,
        "retire_candidates": 0,
        "lint": "0F/0A",
    },
    "llm_tier": {
        "last_run": None,
        "suggest_hits": 0,
        "audit_findings": 0,
    },
    "retire_seen": [],
    "last_nudged": None,
    "trend": [],
}

# Maximum number of entries kept in the append-only trend list (oldest dropped).
TREND_MAX_ENTRIES = 52


def _load_state(state_path: Path) -> Dict:
    """Read .adr-kit-state.json. Returns DEFAULT_STATE when missing or invalid.

    A corrupt or partial file is tolerated: it is treated as empty state and a
    single warning line is written to stderr. The file itself is left in place;
    the next stamp overwrites it with valid JSON (last-writer-wins).
    """
    return load_state(
        state_path,
        lambda: json.loads(json.dumps(DEFAULT_STATE)),
        lambda message: sys.stderr.write(f"[adr-guardian] warning: {message}\n"),
    )


def _update_state(state_path: Path, mutation):
    return update_state(
        state_path,
        lambda: json.loads(json.dumps(DEFAULT_STATE)),
        mutation,
        lambda message: sys.stderr.write(f"[adr-guardian] warning: {message}\n"),
    )


def _load_config(config_path: Path) -> Dict:
    """Read .adr-kit.json. Returns {} when missing or invalid."""
    if not config_path.exists():
        return {}
    try:
        data = json.loads(config_path.read_text(encoding="utf-8"))
        if not isinstance(data, dict):
            return {}
        return data
    except (json.JSONDecodeError, OSError):
        return {}


def _guardian_config(cfg: Dict) -> Dict:
    """Return the guardian sub-block with defaults filled in."""
    defaults = {
        "enabled": True,
        "drift_stale_days": 1,
        "llm_stale_days": 14,
        "nudge_cooldown_hours": 24,
        "llm_autorun": False,
    }
    guardian = cfg.get("guardian") or {}
    merged = {**defaults, **guardian}
    return merged


# ---------------------------------------------------------------------------
# Time helpers
# ---------------------------------------------------------------------------

def _now_utc() -> datetime:
    return datetime.now(tz=timezone.utc)


def _parse_iso(s: Optional[str]) -> Optional[datetime]:
    """Parse an ISO-8601 timestamp string, returning None on failure."""
    if not s:
        return None
    try:
        # Python 3.11+ handles Z; for 3.9/3.10 replace Z with +00:00
        s_clean = s.replace("Z", "+00:00")
        return datetime.fromisoformat(s_clean)
    except (ValueError, AttributeError):
        return None


def _hours_since(ts: Optional[datetime]) -> Optional[float]:
    """Return hours elapsed since ts (UTC), or None when ts is None."""
    if ts is None:
        return None
    delta = _now_utc() - ts
    return delta.total_seconds() / 3600.0


def _days_since(ts: Optional[datetime]) -> Optional[float]:
    """Return days elapsed since ts (UTC), or None when ts is None."""
    if ts is None:
        return None
    delta = _now_utc() - ts
    return delta.total_seconds() / 86400.0


# ---------------------------------------------------------------------------
# CWD guard
# ---------------------------------------------------------------------------

def _find_adr_dir() -> Optional[Path]:
    """Return docs/adr/ relative to the project root, or None if absent/empty.

    Checks CLAUDE_PROJECT_DIR first (set by Claude Code for plugin-level hooks),
    then falls back to cwd. A directory is valid when it exists and contains at
    least one ADR-*.md file.
    """
    project_dir = os.environ.get("CLAUDE_PROJECT_DIR") or ""
    candidates = []
    if project_dir:
        candidates.append(Path(project_dir) / "docs" / "adr")
    candidates.append(Path.cwd() / "docs" / "adr")

    for adr_dir in candidates:
        if adr_dir.is_dir():
            # Quick check: at least one ADR file present.
            try:
                has_adrs = any(True for _ in adr_dir.glob("ADR-*.md"))
            except OSError:
                continue
            if has_adrs:
                return adr_dir
    return None


def _count_adrs(adr_dir: Path) -> int:
    """Count ADR-*.md files in adr_dir."""
    try:
        return sum(1 for _ in adr_dir.glob("ADR-*.md"))
    except OSError:
        return 0


# ---------------------------------------------------------------------------
# Copied-artifact staleness (task-15, v0.27.0+)
#
# Plugin-level hooks refresh automatically on plugin update, but artifacts
# COPIED into a project freeze at install time: the git pre-commit wrapper
# and the project-scoped guardian hook entry in .claude/settings.json. Their
# engines self-upgrade (they resolve the newest plugin cache version per
# run), but the wrapper's own feature surface lags until refreshed. The
# checks below are pure file reads (no subprocesses, per the check
# invariant) and compare embedded version stamps against this plugin's own
# version.
#
# Staleness rules (no false positives when up to date, AC#3):
#   - git wrapper stamped older than the plugin        -> stale
#   - git wrapper clearly adr-kit's but unstamped      -> stale (pre-0.27)
#   - non-adr-kit pre-commit hook                      -> ignored
#   - settings entry stamped older than the plugin     -> stale
#   - settings entry without a stamp                   -> ignored (it only
#     re-resolves engines; entry-shape changes are rare and nagging every
#     pre-0.27 install from a settings snapshot would be noise)
# ---------------------------------------------------------------------------

_WRAPPER_STAMP_RE = re.compile(r'^ADR_KIT_WRAPPER_VERSION="([0-9]+\.[0-9]+\.[0-9]+)"', re.MULTILINE)
_ARTIFACT_READ_CAP = 64 * 1024  # wrappers are a few KB; cap defends against odd files


def _own_version() -> Optional[str]:
    """Version of the native client plugin this script ships with.

    The hook resolvers always execute the newest installed adr-guardian, so
    this is the newest installed plugin version by construction.
    """
    root = Path(__file__).resolve().parent.parent
    for manifest in (
        root / ".claude-plugin" / "plugin.json",
        root / ".codex-plugin" / "plugin.json",
        root / "plugin.json",
    ):
        try:
            data = json.loads(manifest.read_text(encoding="utf-8"))
            version = data.get("version")
            if isinstance(version, str):
                return version
        except (OSError, json.JSONDecodeError, ValueError):
            continue
    return None


def _parse_semver(s: Optional[str]) -> Optional[Tuple[int, int, int]]:
    """Parse 'X.Y.Z' into an int tuple; None for anything else."""
    if not s:
        return None
    m = re.fullmatch(r"([0-9]+)\.([0-9]+)\.([0-9]+)", s.strip())
    if not m:
        return None
    return (int(m.group(1)), int(m.group(2)), int(m.group(3)))


def _read_capped(path: Path) -> Optional[str]:
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            return fh.read(_ARTIFACT_READ_CAP)
    except OSError:
        return None


def _check_git_wrapper(path: Path, plugin_semver: Tuple[int, int, int]) -> Optional[Dict]:
    """Inspect one candidate pre-commit file. None when absent or not ours."""
    content = _read_capped(path)
    if content is None:
        return None
    if "adr-kit" not in content and "adr-judge" not in content:
        return None  # someone else's hook; never report it
    m = _WRAPPER_STAMP_RE.search(content)
    version = m.group(1) if m else None
    wrapper_semver = _parse_semver(version)
    stale = wrapper_semver is None or wrapper_semver < plugin_semver
    return {
        "kind": "git-pre-commit-wrapper",
        "path": str(path),
        "version": version,
        "stale": stale,
    }


def _check_settings_entry(path: Path, plugin_semver: Tuple[int, int, int]) -> Optional[Dict]:
    """Inspect .claude/settings.json for a stamped guardian hook entry."""
    content = _read_capped(path)
    if content is None or "adr-guardian" not in content:
        return None
    try:
        data = json.loads(content)
    except json.JSONDecodeError:
        return None

    def _walk(node) -> Optional[str]:
        if isinstance(node, dict):
            cmd = node.get("command")
            if isinstance(cmd, str) and "adr-guardian" in cmd:
                wv = node.get("_wrapper_version")
                return wv if isinstance(wv, str) else ""
            for value in node.values():
                found = _walk(value)
                if found is not None:
                    return found
        elif isinstance(node, list):
            for item in node:
                found = _walk(item)
                if found is not None:
                    return found
        return None

    stamp = _walk(data)
    if stamp is None:
        return None  # no guardian entry in this settings file
    if stamp == "":
        # Unstamped entry: pre-0.27 snapshot, but it self-resolves engines.
        # Reported as present, never as stale (AC#3: no noise).
        return {
            "kind": "settings-guardian-entry",
            "path": str(path),
            "version": None,
            "stale": False,
        }
    entry_semver = _parse_semver(stamp)
    stale = entry_semver is None or entry_semver < plugin_semver
    return {
        "kind": "settings-guardian-entry",
        "path": str(path),
        "version": stamp,
        "stale": stale,
    }


def _artifact_report(project_root: Path) -> Dict:
    """Compare copied artifacts in project_root against the plugin version."""
    plugin_version = _own_version()
    plugin_semver = _parse_semver(plugin_version)
    report: Dict = {"plugin_version": plugin_version, "artifacts": []}
    if plugin_semver is None:
        return report  # cannot judge staleness without our own version
    for candidate in (
        project_root / ".githooks" / "pre-commit",
        project_root / ".git" / "hooks" / "pre-commit",
    ):
        found = _check_git_wrapper(candidate, plugin_semver)
        if found is not None:
            report["artifacts"].append(found)
    settings = _check_settings_entry(project_root / ".claude" / "settings.json", plugin_semver)
    if settings is not None:
        report["artifacts"].append(settings)
    return report


def _stale_artifact_lines(report: Dict) -> List[str]:
    """Nudge lines for stale artifacts; empty list when everything is fresh."""
    lines: List[str] = []
    plugin_version = report.get("plugin_version") or "?"
    for art in report.get("artifacts", []):
        if not art.get("stale"):
            continue
        version_label = art.get("version") or "pre-0.27 (unstamped)"
        rel = art.get("path", "")
        lines.append(
            f"  • wrapper:   {rel} is {version_label}, plugin is {plugin_version}"
            "   STALE → /adr-kit:upgrade"
        )
    return lines


# ---------------------------------------------------------------------------
# Due-tier computation
# ---------------------------------------------------------------------------

def _compute_due_tiers(
    state: Dict,
    gcfg: Dict,
    now: datetime,
) -> Tuple[bool, bool]:
    """Return (cheap_due, llm_due) booleans.

    cheap_due: True when cheap-tier has never run OR last_run > drift_stale_days ago.
    llm_due:   True when llm-tier has never run OR last_run > llm_stale_days ago.
    """
    cheap_tier = state.get("cheap_tier") or {}
    llm_tier = state.get("llm_tier") or {}

    drift_stale_days = float(gcfg.get("drift_stale_days", 1))
    llm_stale_days = float(gcfg.get("llm_stale_days", 14))

    cheap_last_run = _parse_iso(cheap_tier.get("last_run"))
    llm_last_run = _parse_iso(llm_tier.get("last_run"))

    cheap_days = _days_since(cheap_last_run)
    llm_days = _days_since(llm_last_run)

    cheap_due = cheap_days is None or cheap_days >= drift_stale_days
    llm_due = llm_days is None or llm_days >= llm_stale_days

    return cheap_due, llm_due


def _is_throttled(state: Dict, gcfg: Dict) -> bool:
    """Return True if we nudged within nudge_cooldown_hours."""
    cooldown_h = float(gcfg.get("nudge_cooldown_hours", 24))
    last_nudged = _parse_iso(state.get("last_nudged"))
    h = _hours_since(last_nudged)
    if h is None:
        return False
    return h < cooldown_h


# ---------------------------------------------------------------------------
# Trend history helpers
# ---------------------------------------------------------------------------

def _trend_list(state: Dict) -> List:
    """Return state['trend'] as a list, tolerating corrupt or missing values."""
    trend = state.get("trend")
    if not isinstance(trend, list):
        return []
    return trend


def _is_number(v) -> bool:
    """True for int/float metric values (bool excluded)."""
    return isinstance(v, (int, float)) and not isinstance(v, bool)


def _fmt_pct(v) -> str:
    """Format a coverage percent compactly: 40.0 -> '40%', 45.5 -> '45.5%'."""
    return f"{v:g}%"


def _format_trend_delta(state: Dict) -> Optional[str]:
    """One-line delta vs the previous sweep, or None when not enough trend data.

    Example: 'trend: drift 2 -> 0, retire 1 -> 2, coverage 40% -> 45%'
    Requires at least two well-formed trend entries; corrupt entries are skipped.
    """
    trend = _trend_list(state)
    if len(trend) < 2:
        return None
    prev, last = trend[-2], trend[-1]
    if not isinstance(prev, dict) or not isinstance(last, dict):
        return None

    parts: List[str] = []
    for label, key in (
        ("drift", "drift_violations"),
        ("retire", "retire_candidates"),
        ("suggest", "suggest_hits"),
        ("audit", "audit_findings"),
    ):
        a, b = prev.get(key), last.get(key)
        if _is_number(a) and _is_number(b):
            parts.append(f"{label} {a} -> {b}")
    a, b = prev.get("coverage_percent"), last.get("coverage_percent")
    if _is_number(a) and _is_number(b):
        parts.append(f"coverage {_fmt_pct(a)} -> {_fmt_pct(b)}")

    if not parts:
        return None
    return "trend: " + ", ".join(parts)


def _append_trend_entry(
    state: Dict,
    tier: str,
    now_iso: str,
    total_adrs: Optional[int],
    coverage: Optional[float],
) -> None:
    """Append a sweep entry to the append-only trend list (capped at 52).

    Fields for the tier that did not run are carried from the last known
    tier-state values; coverage and total_adrs carry from the previous trend
    entry when not freshly supplied. Corrupt trend values are reset to [].
    """
    trend = _trend_list(state)
    prev = trend[-1] if trend and isinstance(trend[-1], dict) else {}

    cheap = state.get("cheap_tier") or {}
    llm = state.get("llm_tier") or {}

    if total_adrs is None:
        total_adrs = prev.get("total_adrs")
    if coverage is None:
        coverage = prev.get("coverage_percent")

    entry = {
        "date": now_iso,
        "tier": tier,
        "total_adrs": total_adrs,
        "drift_violations": cheap.get("drift_violations"),
        "retire_candidates": cheap.get("retire_candidates"),
        "suggest_hits": llm.get("suggest_hits"),
        "audit_findings": llm.get("audit_findings"),
        "coverage_percent": coverage,
    }
    trend.append(entry)
    state["trend"] = trend[-TREND_MAX_ENTRIES:]


# ---------------------------------------------------------------------------
# Block formatting (spec §9)
# ---------------------------------------------------------------------------

def _format_guardian_block(
    cheap_due: bool,
    llm_due: bool,
    state: Dict,
    adr_count: int,
    now: datetime,
) -> str:
    """Return the [adr-guardian] block as a plain string.

    Format:
      [adr-guardian] ADR health — N item(s) due
        • drift:     last Xd ago (daily)      DUE
        • llm-tier:  last Xd ago (bi-weekly) DUE   (suggest + audit, costs $)
        state: NN ADRs · last sweep: D drift · S suggestion · R retire candidates
        → /adr-kit:guardian   (LLM tier asks before spending)
    """
    due_count = (1 if cheap_due else 0) + (1 if llm_due else 0)

    cheap_tier = state.get("cheap_tier") or {}
    llm_tier = state.get("llm_tier") or {}

    cheap_last_run = _parse_iso(cheap_tier.get("last_run"))
    llm_last_run = _parse_iso(llm_tier.get("last_run"))

    cheap_days = _days_since(cheap_last_run)
    llm_days = _days_since(llm_last_run)

    def _age_label(days: Optional[float]) -> str:
        if days is None:
            return "never"
        if days < 1.0:
            h = days * 24.0
            return f"{h:.0f}h ago"
        return f"{days:.0f}d ago"

    lines = [f"[adr-guardian] ADR health — {due_count} item(s) due"]

    cheap_tag = "DUE" if cheap_due else "ok"
    llm_tag = "DUE" if llm_due else "ok"

    lines.append(
        f"  • drift:     last {_age_label(cheap_days)} (daily)      {cheap_tag}"
    )
    lines.append(
        f"  • llm-tier:  last {_age_label(llm_days)} (bi-weekly) {llm_tag}"
        + ("   (suggest + audit, costs $)" if llm_due else "")
    )

    drift_violations = cheap_tier.get("drift_violations", 0)
    retire_candidates = cheap_tier.get("retire_candidates", 0)
    suggest_hits = llm_tier.get("suggest_hits", 0)

    lines.append(
        f"  state: {adr_count} ADRs · last sweep: {drift_violations} drift"
        f" · {suggest_hits} suggestion · {retire_candidates} retire candidates"
    )
    delta_line = _format_trend_delta(state)
    if delta_line is not None:
        lines.append(f"  {delta_line}")
    lines.append("  → /adr-kit:guardian   (LLM tier asks before spending)")

    return "\n".join(lines)


# ---------------------------------------------------------------------------
# JSON envelope (SessionStart additionalContext contract)
# ---------------------------------------------------------------------------

def _escape_for_json(s: str) -> str:
    """Escape a plain string for embedding as a JSON string value."""
    s = s.replace("\\", "\\\\")
    s = s.replace('"', '\\"')
    s = s.replace("\n", "\\n")
    s = s.replace("\r", "\\r")
    s = s.replace("\t", "\\t")
    return s


def _emit_context(text: str) -> None:
    """Print the SessionStart context-injection JSON envelope.

    Mirrors the superpowers session-start hook logic:
      CURSOR_PLUGIN_ROOT set  → Cursor format (additional_context, snake_case)
      CLAUDE_PLUGIN_ROOT set, no COPILOT_CLI → Claude Code format (nested hookSpecificOutput)
      otherwise               → SDK standard (top-level additionalContext)
    """
    escaped = _escape_for_json(text)
    if os.environ.get("CURSOR_PLUGIN_ROOT"):
        out = f'{{"additional_context": "{escaped}"}}'
    elif os.environ.get("CLAUDE_PLUGIN_ROOT") and not os.environ.get("COPILOT_CLI"):
        out = (
            '{"hookSpecificOutput": {'
            '"hookEventName": "SessionStart", '
            f'"additionalContext": "{escaped}"'
            "}}"
        )
    else:
        out = f'{{"additionalContext": "{escaped}"}}'
    sys.stdout.write(out + "\n")
    sys.stdout.flush()


# ---------------------------------------------------------------------------
# Subcommand: check
# ---------------------------------------------------------------------------

def cmd_check(args: argparse.Namespace) -> int:
    """Staleness detector. Always exits 0. Prints nothing when nothing is due."""
    # cwd-guard: bail silently when there are no ADRs in this project.
    adr_dir = _find_adr_dir()
    if adr_dir is None:
        return 0

    state_path = adr_dir / ".adr-kit-state.json"
    config_path = adr_dir / ".adr-kit.json"

    cfg = _load_config(config_path)
    gcfg = _guardian_config(cfg)

    # Respect guardian.enabled (default True).
    if not gcfg.get("enabled", True):
        return 0

    # Copied-artifact staleness (task-15): pure file reads, never subprocesses.
    # A stale wrapper counts as a due item so it surfaces even when both
    # sweep tiers are fresh; it rides the same nudge cooldown as the tiers.
    artifact_lines = _stale_artifact_lines(_artifact_report(adr_dir.parent.parent))
    now = _now_utc()
    adr_count = _count_adrs(adr_dir)

    def check_and_stamp_nudge(state):
        cheap_due, llm_due = _compute_due_tiers(state, gcfg, now)
        if not cheap_due and not llm_due and not artifact_lines:
            return False, False
        if _is_throttled(state, gcfg):
            return False, False

        block = _format_guardian_block(
            cheap_due, llm_due, state, adr_count, now
        )
        if artifact_lines:
            block_lines = block.split("\n")
            due_count = (
                (1 if cheap_due else 0)
                + (1 if llm_due else 0)
                + len(artifact_lines)
            )
            head = f"[adr-guardian] ADR health — {due_count} item(s) due"
            block = "\n".join(
                [head] + block_lines[1:-1] + artifact_lines + [block_lines[-1]]
            )
        _emit_context(block)
        state["last_nudged"] = now.isoformat()
        return True, True

    _update_state(state_path, check_and_stamp_nudge)

    return 0


# ---------------------------------------------------------------------------
# Subcommand: stamp
# ---------------------------------------------------------------------------

def cmd_stamp(args: argparse.Namespace) -> int:
    """Record completion of a sweep tier. Always exits 0."""
    tier = args.tier  # "cheap" or "llm"

    adr_dir = _find_adr_dir()
    if adr_dir is None:
        # No ADR dir — can happen if skill is invoked outside a project context.
        # Honour the state-dir flag if provided.
        if args.state_dir:
            state_path = Path(args.state_dir) / ".adr-kit-state.json"
        else:
            return 0
    else:
        state_path = adr_dir / ".adr-kit-state.json"
        if args.state_dir:
            state_path = Path(args.state_dir) / ".adr-kit-state.json"

    now_iso = _now_utc().isoformat()
    total_adrs = _count_adrs(adr_dir) if adr_dir is not None else None

    def stamp_state(state):
        if tier == "cheap":
            cheap = dict(state.get("cheap_tier") or {})
            cheap["last_run"] = now_iso
            if args.violations is not None:
                cheap["drift_violations"] = args.violations
            if args.retire is not None:
                cheap["retire_candidates"] = args.retire
            if args.lint is not None:
                cheap["lint"] = args.lint
            state["cheap_tier"] = cheap
            if args.retire_seen is not None:
                try:
                    seen_list = json.loads(args.retire_seen)
                    if isinstance(seen_list, list):
                        state["retire_seen"] = seen_list
                except json.JSONDecodeError:
                    pass
        elif tier == "llm":
            llm = dict(state.get("llm_tier") or {})
            llm["last_run"] = now_iso
            if args.suggest is not None:
                llm["suggest_hits"] = args.suggest
            if args.audit is not None:
                llm["audit_findings"] = args.audit
            state["llm_tier"] = llm

        _append_trend_entry(state, tier, now_iso, total_adrs, args.coverage)
        return True, None

    _update_state(state_path, stamp_state)
    return 0


# ---------------------------------------------------------------------------
# Subcommand: artifacts
# ---------------------------------------------------------------------------

def cmd_artifacts(args: argparse.Namespace) -> int:
    """Report copied-artifact freshness vs the installed plugin. Always exits 0.

    Used by /adr-kit:upgrade as its detection step and available for manual
    inspection. Pure file reads.
    """
    if args.project_root:
        project_root = Path(args.project_root)
    else:
        adr_dir = _find_adr_dir()
        project_root = adr_dir.parent.parent if adr_dir is not None else Path.cwd()

    report = _artifact_report(project_root)

    if args.format == "json":
        json.dump(report, sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0

    plugin_version = report.get("plugin_version") or "unknown"
    sys.stdout.write(f"[adr-guardian] plugin version: {plugin_version}\n")
    artifacts = report.get("artifacts", [])
    if not artifacts:
        sys.stdout.write("  no copied adr-kit artifacts found in this project\n")
        return 0
    for art in artifacts:
        version_label = art.get("version") or "unstamped"
        tag = "STALE" if art.get("stale") else "ok"
        sys.stdout.write(
            f"  {art.get('kind')}: {art.get('path')} ({version_label}) {tag}\n"
        )
    if any(a.get("stale") for a in artifacts):
        sys.stdout.write("  → refresh with /adr-kit:upgrade (or /adr-kit:install-hooks)\n")
    return 0


# ---------------------------------------------------------------------------
# Subcommand: state
# ---------------------------------------------------------------------------

def cmd_state(args: argparse.Namespace) -> int:
    """Print current state JSON to stdout. Always exits 0."""
    adr_dir = _find_adr_dir()
    if adr_dir is None:
        if args.state_dir:
            state_path = Path(args.state_dir) / ".adr-kit-state.json"
        else:
            json.dump(json.loads(json.dumps(DEFAULT_STATE)), sys.stdout, indent=2)
            sys.stdout.write("\n")
            return 0
    else:
        state_path = adr_dir / ".adr-kit-state.json"
        if args.state_dir:
            state_path = Path(args.state_dir) / ".adr-kit-state.json"

    state = _load_state(state_path)
    json.dump(state, sys.stdout, indent=2)
    sys.stdout.write("\n")
    return 0


# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------

def main() -> int:
    _ensure_utf8_streams()
    p = argparse.ArgumentParser(
        prog="adr-guardian",
        description=(
            "ADR-set health detector for adr-kit (v0.18.0+). "
            "Three subcommands: check (SessionStart hook), stamp (record sweep), state (inspect)."
        ),
    )
    sub = p.add_subparsers(dest="command")

    # check
    check_p = sub.add_parser(
        "check",
        help=(
            "Staleness detector for SessionStart hook. Prints nothing when nothing is due. "
            "Always exits 0."
        ),
    )
    check_p.add_argument(
        "--adr-dir",
        default=None,
        help="Override docs/adr directory (default: auto-detect from CLAUDE_PROJECT_DIR or cwd).",
    )

    # stamp
    stamp_p = sub.add_parser(
        "stamp",
        help="Record that a sweep tier completed. Updates .adr-kit-state.json.",
    )
    stamp_p.add_argument(
        "tier",
        choices=["cheap", "llm"],
        help="Which tier completed.",
    )
    stamp_p.add_argument("--violations", type=int, default=None,
                         help="Number of drift violations found (cheap tier).")
    stamp_p.add_argument("--retire", type=int, default=None,
                         help="Number of retire candidates found (cheap tier).")
    stamp_p.add_argument("--retire-seen", dest="retire_seen", default=None,
                         help="JSON array of ADR ids in the retire candidate set (cheap tier).")
    stamp_p.add_argument("--lint", default=None,
                         help="Lint summary string, e.g. '2F/5A' (cheap tier).")
    stamp_p.add_argument("--suggest", type=int, default=None,
                         help="Number of missing-ADR suggestions (llm tier).")
    stamp_p.add_argument("--audit", type=int, default=None,
                         help="Number of audit findings (llm tier).")
    stamp_p.add_argument("--coverage", type=float, default=None,
                         help="Enforcement coverage percent of Accepted ADRs "
                              "(from adr-status --format json, summary.coverage_pct). "
                              "Carried from the previous trend entry when omitted.")
    stamp_p.add_argument("--state-dir", dest="state_dir", default=None,
                         help="Override directory for .adr-kit-state.json (tests/CI).")

    # state
    state_p = sub.add_parser(
        "state",
        help="Print current .adr-kit-state.json as formatted JSON. Always exits 0.",
    )
    state_p.add_argument("--state-dir", dest="state_dir", default=None,
                         help="Override directory for .adr-kit-state.json (tests/CI).")

    # artifacts
    artifacts_p = sub.add_parser(
        "artifacts",
        help=(
            "Report copied-artifact freshness (git pre-commit wrapper, settings "
            "guardian entry) vs the installed plugin version. Always exits 0."
        ),
    )
    artifacts_p.add_argument("--project-root", dest="project_root", default=None,
                             help="Project root to inspect (default: auto-detect).")
    artifacts_p.add_argument("--format", choices=["human", "json"], default="human",
                             help="Output format (default: human).")

    args = p.parse_args()

    if args.command is None:
        p.print_help(sys.stderr)
        return 2

    # Apply --adr-dir override for check (patch env var so _find_adr_dir picks it up).
    if args.command == "check" and getattr(args, "adr_dir", None):
        os.environ["CLAUDE_PROJECT_DIR"] = str(Path(args.adr_dir).resolve().parent.parent)

    try:
        if args.command == "check":
            return cmd_check(args)
        elif args.command == "stamp":
            return cmd_stamp(args)
        elif args.command == "state":
            return cmd_state(args)
        elif args.command == "artifacts":
            return cmd_artifacts(args)
    except KeyboardInterrupt:
        return 0
    except Exception:
        # The check subcommand must NEVER propagate an exception — guardian must
        # not block a session start. Other subcommands: same policy for safety.
        return 0

    return 0


if __name__ == "__main__":
    sys.exit(main())
