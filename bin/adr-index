#!/usr/bin/env python3
"""adr-index: generate a compact index of every ADR for context injection.

Part of ADR-004's session tier. Emits one row per ADR (id, status, scope,
one-line decision) so the whole decision set can be `@`-imported into
`CLAUDE.md` at a fixed low token cost, instead of dumping every ADR in full.

Design invariants (same posture as bin/adr-watch and bin/adr-guardian):
  - Read-only on ADRs. Deterministic. No LLM, no network. stdlib only.
  - ALWAYS exits 0. Self-guard: an empty/absent adr-dir yields an empty index,
    never an error.
  - Reads only the pinned canonical fields (ADR-004): status from the ## Status
    line, scope from the ## Enforcement path_glob values. The status/enforcement
    regexes are byte-for-byte the ones bin/adr-watch uses (which in turn mirror
    bin/adr-judge), so the index never drifts from the judge. tests/test_adr_index
    locks this agreement.
  - Output carries no timestamp so a regenerate is reproducible and CI can diff
    the committed index against a fresh run.

Usage:
  adr-index                       # markdown table to stdout
  adr-index --format json         # machine-readable
  adr-index --adr-dir docs/adr    # explicit dir
  adr-index -o docs/adr/ADR-INDEX.md   # write to a file
"""

from __future__ import annotations

import argparse
import io
import json
import re
import sys
from pathlib import Path
from typing import Dict, List, Optional

# ---------------------------------------------------------------------------
# Precompiled regexes -- identical semantics to bin/adr-watch (which mirrors
# bin/adr-judge). Keep these in lockstep; tests/test_adr_index asserts it.
# ---------------------------------------------------------------------------

ENFORCEMENT_BLOCK_RE = re.compile(
    r"^##\s+Enforcement\s*$\n+.*?```json\s*\n(.*?)\n```",
    re.IGNORECASE | re.MULTILINE | re.DOTALL,
)
STATUS_HEADING_RE = re.compile(
    r"^##\s+Status\s*$\n+([^\n]+)", re.IGNORECASE | re.MULTILINE
)
STATUS_LINE_RE = re.compile(
    r"^\s*Status\s*:\s*([A-Za-z]+)", re.IGNORECASE | re.MULTILINE
)
STATUS_BOLD_INLINE_RE = re.compile(
    r"^\s*\*\*\s*Status\s*:?\s*\*\*\s*:?\s*([A-Za-z]+)|^\s*\*\*\s*Status\s*:?\s*([A-Za-z]+)\s*\*\*",
    re.IGNORECASE | re.MULTILINE,
)
TITLE_RE = re.compile(r"^#\s+ADR-\d+[:\s]\s*(.+)$", re.MULTILINE)
DECISION_SECTION_RE = re.compile(
    r"^##\s+Decision(.*?)(?=^##|\Z)", re.IGNORECASE | re.MULTILINE | re.DOTALL
)
ADR_FILENAME_RE = re.compile(r"ADR-(\d{1,4})", re.IGNORECASE)

DECISION_ONELINE_MAX = 120  # chars of the one-line decision summary


def _ensure_utf8_streams() -> None:
    for stream_name in ("stdout", "stderr"):
        stream = getattr(sys, stream_name, None)
        if stream is None:
            continue
        buffer = getattr(stream, "buffer", None)
        if buffer is None:
            continue
        try:
            setattr(sys, stream_name,
                    io.TextIOWrapper(buffer, encoding="utf-8", newline="\n"))
        except (AttributeError, ValueError):
            pass


def adr_status(text: str) -> Optional[str]:
    """Return the ADR status word, recognising the same forms as adr-watch."""
    m = STATUS_HEADING_RE.search(text)
    if m:
        wm = re.match(r"\s*([A-Za-z]+)", m.group(1))
        return wm.group(1) if wm else None
    m = STATUS_BOLD_INLINE_RE.search(text)
    if m:
        return m.group(1) or m.group(2)
    m = STATUS_LINE_RE.search(text)
    if m:
        return m.group(1)
    return None


def enforcement_globs(text: str) -> List[str]:
    """Return all path_glob strings from the ADR's Enforcement block.

    Tolerant: malformed JSON or unexpected shapes yield an empty list. A rule
    without a path_glob applies everywhere; represented as "**".
    """
    m = ENFORCEMENT_BLOCK_RE.search(text)
    if not m:
        return []
    try:
        data = json.loads(m.group(1))
    except json.JSONDecodeError:
        return []
    if not isinstance(data, dict):
        return []
    globs: List[str] = []
    for kind in ("forbid_pattern", "forbid_import", "require_pattern"):
        rules = data.get(kind)
        if not isinstance(rules, list):
            continue
        for rule in rules:
            if not isinstance(rule, dict):
                continue
            glob = rule.get("path_glob")
            if isinstance(glob, str) and glob:
                globs.append(glob)
            else:
                globs.append("**")
    # De-duplicate while preserving first-seen order.
    seen: Dict[str, None] = {}
    for g in globs:
        seen.setdefault(g, None)
    return list(seen.keys())


def decision_oneline(text: str) -> str:
    """One-line summary of the Decision section: first meaningful sentence."""
    m = DECISION_SECTION_RE.search(text)
    if not m:
        return ""
    body = m.group(1)
    for raw_line in body.splitlines():
        line = raw_line.strip()
        if not line or line.startswith(("#", "```", "<!--", "-->")):
            continue
        # Strip list/enumeration and emphasis markers from the lead line.
        line = re.sub(r"^([-*]|\d+\.)\s+", "", line)
        line = line.lstrip("*").strip()
        if not line:
            continue
        # Prefer the first sentence when the lead line runs long.
        sentence = re.split(r"(?<=[.!?])\s", line, maxsplit=1)[0].strip()
        summary = sentence if sentence else line
        if len(summary) > DECISION_ONELINE_MAX:
            summary = summary[: DECISION_ONELINE_MAX - 1].rstrip() + "…"
        return summary
    return ""


def load_index(adr_dir: Path) -> List[Dict]:
    """Load every ADR in adr_dir as an index row. One read per file."""
    rows: List[Dict] = []
    for adr_file in sorted(adr_dir.glob("ADR-*.md")):
        try:
            text = adr_file.read_text(encoding="utf-8")
        except OSError:
            continue
        id_match = ADR_FILENAME_RE.search(adr_file.name)
        adr_num = int(id_match.group(1)) if id_match else 0
        adr_id = f"ADR-{adr_num:03d}" if id_match else adr_file.stem
        title_match = TITLE_RE.search(text)
        title = title_match.group(1).strip() if title_match else adr_file.stem
        rows.append({
            "num": adr_num,
            "adr_id": adr_id,
            "title": title,
            "status": adr_status(text) or "Unknown",
            "scope": enforcement_globs(text),
            "decision": decision_oneline(text),
            "path": adr_file.name,
        })
    rows.sort(key=lambda r: (r["num"], r["adr_id"]))
    return rows


def _escape_cell(value: str) -> str:
    return value.replace("|", "\\|").replace("\n", " ").strip()


def render_markdown(rows: List[Dict]) -> str:
    lines = [
        "<!-- Generated by bin/adr-index. Do not edit by hand; regenerate with: bin/adr-index -o docs/adr/ADR-INDEX.md -->",
        "",
        "# ADR Index",
        "",
        "One row per Architecture Decision Record. Scope is the Enforcement "
        "`path_glob` set that governs where the decision applies; only "
        "`Accepted` ADRs are injected at edit time (ADR-004).",
        "",
        "| ADR | Status | Scope | Decision |",
        "| --- | --- | --- | --- |",
    ]
    for r in rows:
        scope = ", ".join(f"`{g}`" for g in r["scope"]) if r["scope"] else "-"
        decision = _escape_cell(r["decision"]) or "-"
        lines.append(
            f"| {r['adr_id']} | {r['status']} | {scope} | {decision} |"
        )
    if not rows:
        lines.append("| _(none)_ | | | |")
    return "\n".join(lines) + "\n"


def render_json(rows: List[Dict]) -> str:
    payload = [
        {
            "adr_id": r["adr_id"],
            "status": r["status"],
            "scope": r["scope"],
            "decision": r["decision"],
            "path": r["path"],
        }
        for r in rows
    ]
    return json.dumps(payload, indent=2, ensure_ascii=False) + "\n"


def _find_adr_dir(explicit: Optional[str]) -> Optional[Path]:
    if explicit:
        p = Path(explicit)
        return p if p.is_dir() else None
    for candidate in (Path("docs/adr"), Path("adr"), Path(".")):
        if candidate.is_dir() and any(candidate.glob("ADR-*.md")):
            return candidate
    return None


def main() -> int:
    _ensure_utf8_streams()
    parser = argparse.ArgumentParser(
        prog="adr-index",
        description="Generate a compact index of every ADR (id, status, scope, "
                    "one-line decision). Deterministic; always exits 0.",
    )
    parser.add_argument("--adr-dir", default=None,
                        help="Directory holding ADR-*.md (default: auto-detect).")
    parser.add_argument("--format", choices=("md", "json"), default="md",
                        help="Output format (default: md).")
    parser.add_argument("-o", "--output", default=None,
                        help="Write to this file instead of stdout.")
    args = parser.parse_args()

    adr_dir = _find_adr_dir(args.adr_dir)
    rows = load_index(adr_dir) if adr_dir is not None else []

    text = render_json(rows) if args.format == "json" else render_markdown(rows)

    if args.output:
        try:
            Path(args.output).write_text(text, encoding="utf-8")
        except OSError as exc:
            sys.stderr.write(f"adr-index: cannot write {args.output}: {exc}\n")
            return 0
    else:
        sys.stdout.write(text)
    return 0


if __name__ == "__main__":
    sys.exit(main())
