#!/usr/bin/env python3
"""adr-migrate: add canonical adr-kit frontmatter to ADR files.

The migration preserves the markdown body exactly. It only prepends or repairs
frontmatter metadata so local tools can recall and validate ADRs reliably.

Usage:
  adr-migrate                         # migrate docs/adr/
  adr-migrate docs/decisions/         # migrate a directory
  adr-migrate docs/adr/ADR-001-x.md   # migrate one file
  adr-migrate --check docs/adr/       # exit 1 when any file needs migration
  adr-migrate --dry-run --format json docs/adr/
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path
from typing import Dict, List

from adr_schema import migrate_text


ADR_FILE_RE = re.compile(r"(?i)^ADR-\d{1,4}-.*\.md$")


def discover_files(target: Path) -> List[Path]:
    if target.is_file():
        return [target]
    if not target.is_dir():
        return []
    return sorted(
        (path for path in target.glob("ADR-*.md") if ADR_FILE_RE.match(path.name)),
        key=lambda p: p.name.lower(),
    )


def migrate_file(path: Path, write: bool) -> Dict:
    try:
        before = path.read_text(encoding="utf-8")
    except OSError as exc:
        return {
            "file": str(path),
            "changed": False,
            "ok": False,
            "issues": [str(exc)],
        }

    after, changed, issues = migrate_text(before, path)
    if not issues and changed and write:
        try:
            path.write_text(after, encoding="utf-8")
        except OSError as exc:
            return {
                "file": str(path),
                "changed": False,
                "ok": False,
                "issues": [str(exc)],
            }

    return {
        "file": str(path),
        "changed": changed,
        "ok": not issues,
        "issues": issues,
    }


def render_text(target: Path, results: List[Dict], check: bool, dry_run: bool) -> str:
    changed = [r for r in results if r["changed"]]
    failed = [r for r in results if not r["ok"]]
    mode = "check" if check else ("dry-run" if dry_run else "write")
    lines = [
        f"adr-migrate {mode}: {target}",
        f"Files: {len(results)}; changed: {len(changed)}; failed: {len(failed)}",
    ]
    for result in results:
        if result["changed"]:
            prefix = "needs migration" if check or dry_run else "migrated"
            lines.append(f"  {prefix}: {result['file']}")
        if result["issues"]:
            lines.append(f"  failed: {result['file']}")
            for issue in result["issues"]:
                lines.append(f"    {issue}")
    if not results:
        lines.append("No ADR files found.")
    return "\n".join(lines)


def main(argv: List[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="adr-migrate",
        description="Add canonical adr-kit frontmatter to ADR files.",
    )
    parser.add_argument(
        "path",
        nargs="?",
        default="docs/adr",
        help="ADR file or directory (default: docs/adr)",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="do not write; exit 1 if any ADR needs migration",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="do not write; report what would change",
    )
    parser.add_argument(
        "--format",
        choices=["text", "json"],
        default="text",
        help="output format (default: text)",
    )
    args = parser.parse_args(argv)

    target = Path(args.path)
    files = discover_files(target)
    write = not args.check and not args.dry_run
    results = [migrate_file(path, write=write) for path in files]

    failed = [r for r in results if not r["ok"]]
    changed = [r for r in results if r["changed"]]
    payload = {
        "target": str(target),
        "mode": "check" if args.check else ("dry-run" if args.dry_run else "write"),
        "summary": {
            "total": len(results),
            "changed": len(changed),
            "failed": len(failed),
        },
        "files": results,
    }

    if args.format == "json":
        print(json.dumps(payload, indent=2))
    else:
        print(render_text(target, results, check=args.check, dry_run=args.dry_run))

    if failed:
        return 2
    if args.check and changed:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())

