#!/usr/bin/env python3
"""adr-quality: Score an ADR file on quality via 4 gates, each 0.0-1.0.

Usage:
  adr-quality docs/adr/ADR-042-foo.md
  adr-quality --format json docs/adr/ADR-042-foo.md
  adr-quality --format text docs/adr/ADR-042-foo.md   # default

Exit codes:
  0  overall >= 0.70 (grade B or better)
  1  overall < 0.70 (grade C or D)
  2  file not found or unreadable
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import re
import sys
from dataclasses import dataclass
from pathlib import Path
from typing import Dict, List, Optional

_BIN_DIR = Path(__file__).resolve().parent


def _load_sibling(name: str):
    """Import bin/<name>.py by explicit path, WITHOUT touching sys.path.

    SEC-HIGH (TASK-62): `sys.path.insert(0, _BIN_DIR)` put this directory ahead
    of the standard library for every import, so a module committed next to
    this script executed as code -- and it re-added the very directory
    CPython's -P / PYTHONSAFEPATH removes. Siblings are registered in
    sys.modules under their bare name, so the plain `from adr_* import ...`
    statements below (and the lazy ones inside functions) resolve from the
    cache instead of the path. bin/adr-judge carries the full rationale.
    """
    cached = sys.modules.get(name)
    if cached is not None:
        return cached
    loader = importlib.machinery.SourceFileLoader(name, str(_BIN_DIR / f"{name}.py"))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


_load_sibling("adr_format")

from adr_format import detect_profile, required_headings, section_text

_load_sibling("adr_quality_core")

from adr_quality_core import (  # noqa: E402
    QUALITY_THRESHOLD,
    REQUIRED_SECTIONS,
    QualityIssue,
    _extract_adr_id,
    _grade,
    _recommendations_from_issues,
    _section_text,
    gate_clarity,
    gate_completeness,
    gate_consistency,
    gate_evidence,
    score_adr_quality,
    score_directory,
    score_path,
)


def _count_checks_passed(gate_result: Dict) -> str:
    checks = gate_result.get("checks", {})
    if not checks:
        return "0/0"
    passed = sum(1 for v in checks.values() if v)
    total = len(checks)
    return f"{passed}/{total}"


def _render_text(adr_id: str, result: Dict) -> str:
    overall = result["overall"]
    grade = result["grade"]
    gates = result["gates"]

    lines = [
        f"Quality Score: {adr_id} -- {overall:.2f} ({grade})",
        "=" * 46,
    ]

    gate_order = [
        ("completeness", "Completeness"),
        ("evidence", "Evidence"),
        ("clarity", "Clarity"),
        ("consistency", "Consistency"),
    ]
    for key, label in gate_order:
        g = gates[key]
        score_str = f"{g['score']:.2f}"
        checks_str = _count_checks_passed(g)
        if g["issues"]:
            issue_msgs = [issue.message() for issue in g["issues"][:2]]
            issue_summary = "; ".join(issue_msgs)
        else:
            issue_summary = "ok"
        if len(issue_summary) > 50:
            issue_summary = issue_summary[:47] + "..."
        lines.append(f"  {label:<16} {score_str}  [{checks_str} checks passed]  {issue_summary}")

    if result["issues"]:
        lines.append("")
        lines.append("Issues:")
        for issue in result["issues"]:
            lines.append(f"  [{issue.severity.upper()}] {issue.message()}")

    if result["recommendations"]:
        lines.append("")
        lines.append("Recommendations:")
        for rec in result["recommendations"]:
            lines.append(f"  - {rec}")

    return "\n".join(lines)


def _serialize_gates(gates: Dict) -> Dict:
    """Convert QualityIssue objects in each gate to plain dicts for JSON."""
    out: Dict = {}
    for name, gate_result in gates.items():
        out[name] = {
            "score": gate_result["score"],
            "issues": [issue.to_dict() for issue in gate_result["issues"]],
            "checks": gate_result["checks"],
        }
    return out


def _render_json(adr_id: str, result: Dict) -> str:
    output = {
        "adr_id": adr_id,
        "overall": result["overall"],
        "grade": result["grade"],
        "gates": _serialize_gates(result["gates"]),
        "issues": [issue.to_dict() for issue in result["issues"]],
        "recommendations": result["recommendations"],
    }
    return json.dumps(output, indent=2, ensure_ascii=False)


def _run_sweep(args) -> int:
    """Score a whole directory and report what has decayed.

    Quality is checked once, at acceptance, and then frozen. An ADR does not
    stay sharp on its own: the code moves, the references rot, the alternatives
    stop being the live ones. This is how that becomes visible instead of
    assumed, and it is free -- four deterministic gates, no model.

    Exit 1 when anything is under the threshold, so a caller can gate on it.
    """
    adr_dir = Path(args.adr_dir)
    if not adr_dir.is_dir():
        print(f"adr-quality: not a directory: {adr_dir}", file=sys.stderr)
        return 2
    threshold = args.below if args.below is not None else QUALITY_THRESHOLD
    scores = score_directory(adr_dir, statuses=args.status)
    rows = sorted(
        (
            {
                "adr_id": adr_id,
                "overall": round(float(result["overall"]), 3),
                "grade": result["grade"],
                "below_threshold": float(result["overall"]) < threshold,
            }
            for adr_id, result in scores.items()
        ),
        key=lambda row: (row["overall"], row["adr_id"]),
    )
    decayed = [row for row in rows if row["below_threshold"]]

    if args.format == "json":
        print(json.dumps(
            {
                "adr_dir": str(adr_dir),
                "threshold": threshold,
                "statuses": args.status,
                "scored": len(rows),
                "below_threshold": len(decayed),
                "results": rows,
            },
            indent=2, ensure_ascii=False,
        ))
    else:
        scope = ", ".join(args.status) if args.status else "every status"
        print(f"adr-quality sweep: {len(rows)} ADR(s) ({scope}), threshold {threshold:.2f}")
        for row in rows:
            marker = "DECAYED" if row["below_threshold"] else "ok     "
            print(f"  {marker} {row['adr_id']}  {row['overall']:.2f}  {row['grade']}")
        if decayed:
            print(
                f"  {len(decayed)} record(s) below threshold: grill or supersede them."
            )
    return 1 if decayed else 0


def main(argv: Optional[List[str]] = None) -> int:
    parser = argparse.ArgumentParser(
        prog="adr-quality",
        description="Score an ADR file on quality via 4 gates.",
    )
    parser.add_argument(
        "file",
        nargs="?",
        help="Path to the ADR file to score",
    )
    parser.add_argument(
        "--adr-dir",
        default=None,
        help=(
            "Score every ADR in this directory instead of one file. This is the "
            "decay sweep: an Accepted record is scored once, at acceptance, and "
            "then never again unless something asks."
        ),
    )
    parser.add_argument(
        "--status",
        action="append",
        default=None,
        help="With --adr-dir, restrict to these statuses. Repeatable.",
    )
    parser.add_argument(
        "--below",
        type=float,
        default=None,
        help=f"With --adr-dir, report only scores under this (default {QUALITY_THRESHOLD}).",
    )
    parser.add_argument(
        "--format", choices=["text", "json"], default="text",
        help="Output format (default: text)",
    )
    parser.add_argument(
        "--version", action="version", version="adr-quality 0.15.0",
    )
    args = parser.parse_args(argv)

    if args.adr_dir:
        return _run_sweep(args)
    if not args.file:
        parser.error("give a file, or --adr-dir to sweep a directory")

    adr_path = Path(args.file)
    if not adr_path.exists():
        print(f"adr-quality: file not found: {adr_path}", file=sys.stderr)
        return 2
    try:
        content = adr_path.read_text(encoding="utf-8", errors="replace")
    except OSError as e:
        print(f"adr-quality: cannot read {adr_path}: {e}", file=sys.stderr)
        return 2

    adr_id = _extract_adr_id(adr_path)
    result = score_adr_quality(content, adr_path)

    if args.format == "json":
        print(_render_json(adr_id, result))
    else:
        print(_render_text(adr_id, result))

    return 0 if result["overall"] >= 0.70 else 1


if __name__ == "__main__":
    sys.exit(main())
