#!/usr/bin/env python3
"""bump-version: thin delegation to the canonical release writer.

Usage: bin/bump-version <new-version>
  e.g. bin/bump-version 0.16.0
  (on Windows: python bin/bump-version 0.16.0)

**This script implements nothing.** `scripts/bump-version.py` is the canonical
writer named by ADR-013 and `docs/RELEASING.md`; this entry point exists only
because `bin/` is where every other adr-kit command lives, and removing a path
people have in their shell history is a worse outcome than keeping four lines
that forward.

Why it stopped being a second implementation (TASK-139). Both scripts bumped the
version, and they did not do the same thing. This one knew how to rewrite the
CHANGELOG compare-link block; the one the runbook names did not. So the runbook
ran the weaker tool and the link block went stale on every single release --
after v0.46.0 the block still read `compare/v0.45.0...HEAD`, and checking the
rest of it found seven further headings with no target at all. Two files that
both claim to bump the version is the defect underneath the missing links, and
deleting one implementation is the only fix that does not reproduce it.

The link logic, the plugin-identity preflight and the marketplace-entry
validation that used to live here now live in `scripts/bump-version.py`, so the
runbook's tool performs them.

History: this was a bash script until v0.31.0. It shelled out to python3 for
each file edit, and on Windows the `python3` Store alias routes through the
Python Install Manager, which scans argv for a script file and dispatches on
ITS shebang: passing the bash-shebanged pre-commit template as an argument made
the launcher exec bash instead of python. Pure stdlib Python avoids the
launcher's argv scanning entirely, needs no Git Bash, and matches every other
bin in this repo.
"""

from __future__ import annotations

import importlib.machinery
import importlib.util
import sys
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent


def _load_writer():
    """Load scripts/bump-version.py by explicit path, WITHOUT touching sys.path.

    SEC-HIGH (TASK-62): `sys.path.insert` from a file in bin/ puts that
    directory ahead of the standard library for every import that follows, so
    anything committed next to this script executes as code. Loading by file
    location keeps bin/ non-importable. Same shape as bin/adr-judge._load_sibling,
    aimed at scripts/ because the writer is shared with the release gate and must
    not be mirrored into the client trees (bin/ is a copy root; scripts/ is not).
    """
    name = "adr_kit_bump_version"
    cached = sys.modules.get(name)
    if cached is not None:
        return cached
    loader = importlib.machinery.SourceFileLoader(
        name, str(REPO_ROOT / "scripts" / "bump-version.py")
    )
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


if __name__ == "__main__":
    sys.exit(_load_writer().main(sys.argv[1:]))
