#!/usr/bin/env bash
# bump-version — adr-kit release helper
#
# Usage: bin/bump-version <new-version>
#   e.g. bin/bump-version 0.16.0
#
# What it does:
#   1. Validates semver format of the argument
#   2. Updates .claude-plugin/plugin.json "version" field
#   3. Updates .claude-plugin/marketplace.json plugin "version" field
#      (the field the Claude Code plugin update system compares against; a bump
#      that misses it ships to the repo but is never picked up by clients)
#   4. Replaces "## [Unreleased]" in CHANGELOG.md with "## [<version>] - <today>"
#      and inserts a fresh "## [Unreleased]" block above it
#   5. Prints what changed; does NOT commit or tag (do that yourself)
#
# After running:
#   git add .claude-plugin/plugin.json .claude-plugin/marketplace.json CHANGELOG.md
#   git commit -m "chore(release): v<version>"
#   git tag v<version>
#   git push origin main --tags

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && git rev-parse --show-toplevel)"
PLUGIN_JSON="$REPO_ROOT/.claude-plugin/plugin.json"
MARKETPLACE_JSON="$REPO_ROOT/.claude-plugin/marketplace.json"
CHANGELOG="$REPO_ROOT/CHANGELOG.md"

usage() {
  echo "Usage: $(basename "$0") <new-version>" >&2
  echo "  e.g. $(basename "$0") 0.16.0" >&2
  exit 1
}

[[ $# -eq 1 ]] || usage

NEW_VERSION="$1"

# Validate semver (major.minor.patch)
if ! [[ "$NEW_VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  echo "ERROR: version must be semver (e.g. 0.16.0), got: $NEW_VERSION" >&2
  exit 1
fi

# Check required files exist
[[ -f "$PLUGIN_JSON" ]]      || { echo "ERROR: $PLUGIN_JSON not found" >&2; exit 1; }
[[ -f "$MARKETPLACE_JSON" ]] || { echo "ERROR: $MARKETPLACE_JSON not found" >&2; exit 1; }
[[ -f "$CHANGELOG" ]]        || { echo "ERROR: $CHANGELOG not found" >&2; exit 1; }

CURRENT_VERSION=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1]))['version'])" "$PLUGIN_JSON")
TODAY=$(date +%Y-%m-%d)

echo "Bumping adr-kit: $CURRENT_VERSION -> $NEW_VERSION (date: $TODAY)"

# 1. Update plugin.json version
python3 - "$PLUGIN_JSON" "$NEW_VERSION" <<'PYEOF'
import json, sys
path, version = sys.argv[1], sys.argv[2]
with open(path) as f:
    data = json.load(f)
data['version'] = version
with open(path, 'w') as f:
    json.dump(data, f, indent=2)
    f.write('\n')
PYEOF
echo "  ✓ .claude-plugin/plugin.json -> $NEW_VERSION"

# 2. Update marketplace.json version (the field the Claude Code plugin update
#    system actually compares against). Bump the entry whose "name" matches
#    plugin.json's name; error out if no such entry exists so a silent miss
#    cannot ship.
PLUGIN_NAME=$(python3 -c "import json,sys; print(json.load(open(sys.argv[1]))['name'])" "$PLUGIN_JSON")
python3 - "$MARKETPLACE_JSON" "$NEW_VERSION" "$PLUGIN_NAME" <<'PYEOF'
import json, sys
path, version, name = sys.argv[1], sys.argv[2], sys.argv[3]
with open(path) as f:
    data = json.load(f)
plugins = data.get('plugins', [])
matched = [p for p in plugins if p.get('name') == name]
if not matched:
    sys.stderr.write(
        f"ERROR: no plugin named {name!r} in {path}; cannot bump marketplace version\n"
    )
    sys.exit(1)
for p in matched:
    p['version'] = version
with open(path, 'w') as f:
    json.dump(data, f, indent=2)
    f.write('\n')
PYEOF
echo "  ✓ .claude-plugin/marketplace.json ($PLUGIN_NAME) -> $NEW_VERSION"

# 3. Update CHANGELOG.md:
#    Replace first occurrence of "## [Unreleased]" with
#    "## [Unreleased]\n\n## [<version>] - <today>"
if ! grep -q "^## \[Unreleased\]" "$CHANGELOG"; then
  echo "WARNING: no '## [Unreleased]' section found in CHANGELOG.md; skipping CHANGELOG update" >&2
else
  # Use python for reliable multiline replacement
  python3 - "$CHANGELOG" "$NEW_VERSION" "$TODAY" <<'PYEOF'
import sys, re
path, version, today = sys.argv[1], sys.argv[2], sys.argv[3]
with open(path) as f:
    content = f.read()
replacement = f"## [Unreleased]\n\n## [{version}] - {today}"
new_content = content.replace("## [Unreleased]", replacement, 1)
with open(path, 'w') as f:
    f.write(new_content)
PYEOF
  echo "  ✓ CHANGELOG.md: [Unreleased] -> [$NEW_VERSION] - $TODAY"
fi

echo ""
echo "Done. Verify the changes, then:"
echo "  git add .claude-plugin/plugin.json .claude-plugin/marketplace.json CHANGELOG.md"
echo "  git commit -m \"chore(release): v$NEW_VERSION\""
echo "  git tag v$NEW_VERSION"
echo "  git push origin main --tags"
