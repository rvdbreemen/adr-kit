#!/usr/bin/env python3
"""adr: local lifecycle commands for adr-kit ADRs."""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
from datetime import date
from pathlib import Path
from typing import Dict, List, Optional, Tuple

_BIN_DIR = Path(__file__).resolve().parent


def _load_sibling(name: str):
    """Import bin/<name>.py by explicit path, WITHOUT touching sys.path.

    SEC-HIGH (TASK-62): `sys.path.insert(0, _BIN_DIR)` put this directory ahead
    of the standard library for every import, so a module committed next to
    this script executed as code -- and it re-added the very directory
    CPython's -P / PYTHONSAFEPATH removes. Siblings are registered in
    sys.modules under their bare name, so the plain `from adr_* import ...`
    statements below (and the lazy ones inside functions) resolve from the
    cache instead of the path. bin/adr-judge carries the full rationale.
    """
    cached = sys.modules.get(name)
    if cached is not None:
        return cached
    loader = importlib.machinery.SourceFileLoader(name, str(_BIN_DIR / f"{name}.py"))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


# Dependency order: adr_schema imports adr_format.
_load_sibling("adr_format")
_load_sibling("adr_schema")

from adr_format import (
    DEFAULT_PROFILE,
    SUPPORTED_PROFILES,
    AdrFormatError,
    configured_profile,
    normalize_profile,
    profile_catalog,
    profile_template_path,
    unresolved_open_questions,
)
from adr_schema import (
    DATE_RE,
    VALID_STATUSES,
    migrate_text,
    parse_frontmatter,
    render_frontmatter,
    split_frontmatter,
)


STATUS_RE = re.compile(
    r"(^##\s+Status(?!\s+History)\s*$\n+)([^\n]*)",
    re.IGNORECASE | re.MULTILINE,
)
HISTORY_START_RE = re.compile(r"^\s*status_history\s*:\s*$", re.IGNORECASE | re.MULTILINE)
LEGAL_TRANSITIONS = {
    "Proposed": {"Proposed", "Accepted", "Rejected"},
    "Accepted": {"Accepted", "Superseded"},
    "Rejected": {"Rejected"},
    "Deprecated": {"Deprecated", "Superseded"},
    "Amended": {"Amended", "Superseded"},
    "Superseded": {"Superseded"},
}


class AdrLifecycleError(Exception):
    """Raised on lifecycle command input or mutation errors."""


def normalize_adr_id(value: str) -> str:
    match = re.search(r"(\d{1,4})", value)
    if not match:
        raise AdrLifecycleError(f"invalid ADR id: {value}")
    return f"ADR-{int(match.group(1)):03d}"


def find_adr_file(adr_dir: Path, adr_id: str) -> Path:
    num = int(re.search(r"\d+", adr_id).group(0))
    matches = sorted(adr_dir.glob(f"ADR-{num:03d}-*.md"))
    if len(matches) != 1:
        raise AdrLifecycleError(
            f"expected one file for {adr_id} in {adr_dir}, found {len(matches)}"
        )
    return matches[0]


def load_adr(path: Path) -> Tuple[Dict, str]:
    text = path.read_text(encoding="utf-8")
    migrated, _changed, issues = migrate_text(text, path)
    if issues:
        raise AdrLifecycleError(f"{path}: cannot normalize frontmatter: {issues}")
    raw_frontmatter, body = split_frontmatter(migrated)
    if raw_frontmatter is None:
        raise AdrLifecycleError(f"{path}: frontmatter normalization failed")
    return parse_frontmatter(raw_frontmatter), body


def _atomic_write_text(path: Path, text: str) -> None:
    """Write one file through a unique same-directory temporary and replace."""
    path.parent.mkdir(parents=True, exist_ok=True)
    temp_path: Path | None = None
    try:
        with tempfile.NamedTemporaryFile(
            mode="w",
            encoding="utf-8",
            newline="",
            dir=path.parent,
            prefix=f".{path.name}.",
            suffix=".tmp",
            delete=False,
        ) as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
            temp_path = Path(handle.name)
        os.replace(temp_path, path)
        temp_path = None
    finally:
        if temp_path is not None:
            temp_path.unlink(missing_ok=True)


def write_adr(path: Path, data: Dict, body: str) -> None:
    _atomic_write_text(path, render_frontmatter(data) + body)


def _snapshot_files(paths: List[Path]) -> Dict[Path, Optional[bytes]]:
    return {
        path: path.read_bytes() if path.exists() else None
        for path in dict.fromkeys(paths)
    }


def _restore_snapshot(snapshot: Dict[Path, Optional[bytes]]) -> None:
    errors = []
    for path, content in snapshot.items():
        try:
            if content is None:
                path.unlink(missing_ok=True)
            else:
                _atomic_write_text(path, content.decode("utf-8"))
        except BaseException as exc:  # pragma: no cover - catastrophic filesystem failure
            errors.append(f"{path}: {exc}")
    if errors:
        raise AdrLifecycleError("snapshot restore failed: " + "; ".join(errors))


def _write_transaction(changes: List[Tuple[Path, str]]) -> None:
    """Apply multiple atomic replacements and restore originals on any failure."""
    originals = _snapshot_files([path for path, _ in changes])
    try:
        for path, text in changes:
            _atomic_write_text(path, text)
    except BaseException as exc:
        try:
            _restore_snapshot(originals)
        except AdrLifecycleError as rollback_exc:
            raise AdrLifecycleError(
                f"transaction failed ({exc}); rollback also failed: {rollback_exc}"
            ) from exc
        raise AdrLifecycleError(f"transaction failed and was rolled back: {exc}") from exc


def assert_legal_transition(current: str, target: str) -> None:
    legal = LEGAL_TRANSITIONS.get(current)
    if legal is None or target not in legal:
        allowed = ", ".join(sorted(legal or set())) or "none"
        raise AdrLifecycleError(
            f"illegal lifecycle transition {current} -> {target}; allowed: {allowed}"
        )


def set_status_line(body: str, status_line: str) -> str:
    if STATUS_RE.search(body):
        return STATUS_RE.sub(rf"\g<1>{status_line}", body, count=1)
    return f"\n## Status\n\n{status_line}\n\n{body}"


# A plain (unquoted) YAML scalar cannot contain ": ", cannot end in ":", and
# cannot begin with an indicator character. Emitting one anyway does not fail
# loudly: it re-reads as a nested mapping and takes the WHOLE status_history
# block down with it (TASK-70). Three ADRs in this repository were written that
# way before this guard existed, all through a `reason` holding free text like
# "Human approval: records the ...", and the recommended
# `--changed-by "User: <name>"` produces the same shape.
#
# It stayed invisible because adr-kit reads these blocks with its own
# line-oriented mini-parser, which takes everything after the first colon as
# the value. Only an external consumer with a real YAML parser sees the damage.
_YAML_INDICATORS = "-?:,[]{}#&*!|>'\"%@`"


def _yaml_scalar(value: str) -> str:
    """Render a string as YAML, quoting only when a plain scalar would not survive."""
    text = "" if value is None else str(value)
    needs_quotes = (
        text == ""
        or text != text.strip()
        or ": " in text
        or text.endswith(":")
        or " #" in text
        or text[0] in _YAML_INDICATORS
    )
    if not needs_quotes:
        return text
    # Double-quoted style: the only YAML style that can represent every scalar.
    escaped = text.replace("\\", "\\\\").replace('"', '\\"')
    return f'"{escaped}"'


def history_entry(status: str, changed_by: str, reason: str, changed_via: str, when: str) -> str:
    return (
        f"  - date: {_yaml_scalar(when)}\n"
        f"    status: {_yaml_scalar(status)}\n"
        f"    changed_by: {_yaml_scalar(changed_by)}\n"
        f"    reason: {_yaml_scalar(reason)}\n"
        f"    changed_via: {_yaml_scalar(changed_via)}\n"
    )


def append_status_history(
    body: str,
    status: str,
    changed_by: str,
    reason: str,
    changed_via: str,
    when: str,
) -> str:
    entry = history_entry(status, changed_by, reason, changed_via, when)
    start = HISTORY_START_RE.search(body)
    if start:
        closing = body.find("```", start.end())
        if closing != -1:
            return body[:closing] + entry + body[closing:]

    section = (
        "\n## Status History\n\n"
        "```yaml\n"
        "status_history:\n"
        f"{entry}"
        "```\n"
    )
    match = STATUS_RE.search(body)
    if match:
        insert_at = body.find("\n", match.end())
        if insert_at == -1:
            insert_at = match.end()
        return body[:insert_at] + section + body[insert_at:]
    return body + section


def read_status_line(body: str) -> Tuple[Optional[str], Optional[str]]:
    """Return the (status, date) written in the body's Status section line."""
    match = STATUS_RE.search(body)
    if not match:
        return None, None
    line = match.group(2).strip()
    word = re.match(r"([A-Za-z]+)", line)
    status = word.group(1).capitalize() if word else None
    if status not in VALID_STATUSES:
        status = None
    found_date = DATE_RE.search(line)
    return status, (found_date.group(1) if found_date else None)


def prior_transition(path: Path, data: Dict, body: str) -> Tuple[str, str]:
    """Return the (status, date) this ADR carried before the current mutation.

    The Status line comes first because it is the half a lifecycle command is
    about to overwrite; frontmatter fills in whichever field the prose omits.
    Both are consulted before giving up: an ADR whose frontmatter plainly
    records `status: "Accepted"` and `date: "2026-05-31"` has a recoverable
    transition even when its Status line is unparseable prose.
    """
    status, when = read_status_line(body)
    if status is None and data.get("status") in VALID_STATUSES:
        status = str(data["status"])
    if when is None and isinstance(data.get("date"), str):
        when = data["date"]
    if status is None or when is None:
        missing = " and ".join(
            name
            for name, value in (("status", status), ("date", when))
            if value is None
        )
        raise AdrLifecycleError(
            f"{path}: refusing to mutate: this ADR has no '## Status History' "
            f"block and its existing transition cannot be recovered (no {missing} "
            "in the Status line or the frontmatter). Writing a history that "
            "starts at this transition would drop the earlier one. Add a "
            "'## Status History' block, or a Status line such as "
            "'Accepted, YYYY-MM-DD.', and rerun."
        )
    return status, when


def ensure_status_history(
    path: Path,
    data: Dict,
    body: str,
    pending: Tuple[str, str],
) -> str:
    """Seed a missing status_history block with the transition already on file.

    ADRs authored before the status_history convention record their acceptance
    in exactly two places, the frontmatter `date` and the Status line, and a
    lifecycle command overwrites both. Appending the new entry to a freshly
    created block then loses that earlier transition for good (TASK-68), so it
    is recovered here, from the record as it stands, before anything is
    rewritten. Call this BEFORE set_status_line: afterwards the line it reads
    is already the new one.
    """
    if HISTORY_START_RE.search(body):
        return body
    status, when = prior_transition(path, data, body)
    if (status, when) == pending:
        # Same status on the same day: there is no earlier transition to keep.
        return body
    return append_status_history(
        body,
        status,
        # The actor genuinely was never recorded. Naming the current user or
        # "adr-kit" would put a signature on a transition neither performed.
        "unknown",
        "Recovered from the record as it stood before this transition; this "
        "ADR predates the status_history convention. The actor was never "
        "recorded and is not guessed here.",
        "unrecorded",
        when,
    )


def mutate_status(
    path: Path,
    status: str,
    status_line: str,
    when: str,
    changed_by: str,
    reason: str,
    changed_via: str,
) -> str:
    data, body = load_adr(path)
    assert_legal_transition(str(data.get("status")), status)
    # Signer resolution comes after legality on purpose: an illegal transition
    # must report that it is illegal, not that it is unsigned. Validate the act
    # before validating the actor.
    changed_by = resolve_signer(path.parent, changed_by)
    body = ensure_status_history(path, data, body, (status, when))
    data["status"] = status
    data["date"] = when
    if status != "Superseded":
        data["superseded_by"] = None
    body = set_status_line(body, status_line)
    body = append_status_history(body, status, changed_by, reason, changed_via, when)
    return render_frontmatter(data) + body


def run_index(adr_dir: Path) -> None:
    script = Path(__file__).resolve().with_name("adr-index")
    result = subprocess.run(
        [sys.executable, str(script), str(adr_dir)],
        capture_output=True,
        text=True,
    )
    if result.returncode != 0:
        raise AdrLifecycleError(result.stderr or result.stdout)


def _commit_lifecycle_changes(
    adr_dir: Path,
    changes: List[Tuple[Path, str]],
) -> None:
    """Commit ADR and generated-index changes as one recoverable operation."""
    snapshot = _snapshot_files(
        [path for path, _ in changes]
        + [
            adr_dir / "README.md",
            adr_dir / "ADR-INDEX.md",
            adr_dir / "ADR-INDEX.json",
        ]
    )
    try:
        _write_transaction(changes)
        run_index(adr_dir)
    except BaseException as exc:
        try:
            _restore_snapshot(snapshot)
        except AdrLifecycleError as rollback_exc:
            raise AdrLifecycleError(
                f"lifecycle transaction failed ({exc}); rollback also failed: "
                f"{rollback_exc}"
            ) from exc
        raise AdrLifecycleError(
            "lifecycle transaction failed; ADRs and generated indexes were "
            f"rolled back: {exc}"
        ) from exc


def load_config(adr_dir: Path, explicit: str | None = None) -> Dict:
    candidates = []
    if explicit:
        candidates.append(Path(explicit))
    candidates.extend([adr_dir / ".adr-kit.json", adr_dir.parent.parent / ".adr-kit.json"])
    for path in candidates:
        if path.exists():
            try:
                return json.loads(path.read_text(encoding="utf-8"))
            except json.JSONDecodeError as exc:
                raise AdrLifecycleError(f"malformed config {path}: {exc}") from exc
    return {}


def _slugify(title: str) -> str:
    slug = re.sub(r"[^a-z0-9]+", "-", title.lower()).strip("-")
    if not slug:
        raise AdrLifecycleError("title must contain at least one letter or number")
    return slug


def command_new(args) -> List[str]:
    adr_dir = Path(args.adr_dir)
    cfg = load_config(adr_dir, args.config)
    try:
        profile = normalize_profile(args.profile) if args.profile else configured_profile(cfg)
        template_dir = Path(__file__).resolve().parent.parent / "templates"
        template = profile_template_path(profile, template_dir)
    except AdrFormatError as exc:
        raise AdrLifecycleError(str(exc)) from exc

    adr_dir.mkdir(parents=True, exist_ok=True)
    used = []
    for path in adr_dir.glob("ADR-*.md"):
        match = re.match(r"(?i)^ADR-(\d{1,4})-", path.name)
        if match:
            used.append(int(match.group(1)))
    number = max(used, default=0) + 1
    adr_id = f"ADR-{number:03d}"
    destination = adr_dir / f"{adr_id}-{_slugify(args.title)}.md"
    if destination.exists():
        raise AdrLifecycleError(f"ADR already exists: {destination}")

    body = template.read_text(encoding="utf-8")
    body = body.replace("ADR-NNN", adr_id)
    body = body.replace('"Short Imperative Title"', json.dumps(args.title, ensure_ascii=False))
    body = body.replace("Short Imperative Title", args.title)
    body = body.replace("YYYY-MM-DD", args.date)
    # The placeholder sits inside the status_history YAML block, so the actor
    # has to survive as a YAML scalar. "User: Robert" - the very shape R8 of
    # spec.md prescribes - is a mapping to a YAML parser, and an unquoted one
    # makes the whole block unparseable. accept/supersede already route through
    # _yaml_scalar; creation did not.
    body = body.replace("user@example.com", _yaml_scalar(resolve_signer(adr_dir, args.changed_by)))
    _commit_lifecycle_changes(adr_dir, [(destination, body)])
    # Say it now, while the author is here. Retrieval metadata is optional
    # frontmatter that nothing used to ask about, and 12 of this repository's
    # 28 records ended up with none -- including the one that defines context
    # injection, which a query about context injection therefore did not return.
    # The tool cannot fill these in without inventing them, so it names them
    # instead, in the same shape the signer proposal uses.
    print(
        f"[adr-kit] {destination.name} has no retrieval metadata yet. Fill in "
        f"topics, aliases and components before accepting it, or an agent's "
        f"query will not surface this decision. Components name what the ADR "
        f"*defines*, not everything it touches.",
        file=sys.stderr,
    )
    return [f"created: {destination} ({profile})"]


def command_profiles(args) -> List[str]:
    template_dir = Path(__file__).resolve().parent.parent / "templates"
    catalog = profile_catalog(template_dir)
    if args.format == "json":
        return [
            json.dumps(
                {
                    "default": DEFAULT_PROFILE,
                    "all_templates_available": all(
                        item["available"] for item in catalog
                    ),
                    "profiles": catalog,
                },
                indent=2,
            )
        ]

    lines = [
        "Shipped ADR profiles (only these identifiers are selectable):",
    ]
    for item in catalog:
        preference = " (preferred)" if item["preferred"] else ""
        availability = "available" if item["available"] else "MISSING"
        lines.extend(
            [
                f"- {item['id']}{preference}: {item['label']} [{availability}]",
                f"  Template: {item['template']}",
                f"  Best for: {item['best_for']}",
                f"  Trade-off: {item['trade_off']}",
            ]
        )
    lines.append(
        "Select with `adr new --profile <id>` or "
        '`template.profile: "<id>"`; do not invent profile names.'
    )
    return lines


def _auto_accept_config(args, adr_dir: Path) -> Tuple[str, float]:
    cfg = load_config(adr_dir, getattr(args, "config", None))
    auto_cfg = cfg.get("lifecycle", {}).get("auto_accept", {})
    mode = args.auto_mode or auto_cfg.get("mode", "assist")
    if mode not in {"auto", "assist"}:
        raise AdrLifecycleError("auto_accept mode must be 'auto' or 'assist'")
    threshold = (
        args.quality_threshold
        if args.quality_threshold is not None
        else float(auto_cfg.get("quality_threshold", 0.70))
    )
    return mode, threshold


def _run_json_tool(command: List[str]) -> Tuple[int, Dict]:
    result = subprocess.run(command, capture_output=True, text=True)
    if result.returncode != 0 and not result.stdout.strip():
        # A non-zero exit with no stdout is a crash, not a gate verdict: the
        # tool never reached its JSON writer. Surface stderr instead of
        # swallowing it behind an empty payload (which read as "{}" downstream).
        stderr = result.stderr.strip() or "<no stderr>"
        raise AdrLifecycleError(
            f"tool crashed (exit {result.returncode}): {' '.join(command)}: {stderr}"
        )
    try:
        payload = json.loads(result.stdout) if result.stdout.strip() else {}
    except json.JSONDecodeError as exc:
        raise AdrLifecycleError(
            f"tool returned non-JSON output: {' '.join(command)}: {exc}"
        ) from exc
    return result.returncode, payload


def _scaffold_residue(text: str) -> List[str]:
    """Instruction lines from the shipped templates that survived authoring.

    Every gate the auto path runs is structural: is the section present, does
    the frontmatter parse, does the quality heuristic score high enough. An
    untouched scaffold satisfies all three -- it is a complete, well-formed ADR
    that happens to decide nothing, and it scored 0.88 against a 0.70 default.
    Auto-accepting that would put "Chosen option: **Option A**, because state
    the decisive rationale" into the record as an Accepted decision.

    These strings are literal instructions to the author. Their presence is not
    a heuristic about quality; it is proof that a section was never written.
    """
    markers = (
        "because state the decisive rationale",
        "State how implementation of the decision will be verified.",
        "Describe the context and problem statement",
        "{Describe",
        "<!-- adr-kit:template-placeholder -->",
    )
    return [marker for marker in markers if marker in text]


def _assert_auto_accept_eligible(path: Path, args, threshold: float) -> Dict:
    data, _body = load_adr(path)
    if data.get("documents_shipped") is not True:
        raise AdrLifecycleError("auto accept requires documents_shipped:true")
    if not data.get("verified_in"):
        raise AdrLifecycleError("auto accept requires at least one verified_in pointer")

    residue = _scaffold_residue(path.read_text(encoding="utf-8"))
    if residue:
        raise AdrLifecycleError(
            "auto accept blocked: the record still contains template instructions "
            f"({'; '.join(repr(item) for item in residue)}). A scaffold is "
            "structurally complete and decides nothing; write the sections, then "
            "accept."
        )

    lint_summary = _assert_acceptance_gates(path, args)
    quality_script = Path(__file__).resolve().with_name("adr-quality")
    _quality_code, quality_payload = _run_json_tool(
        [sys.executable, str(quality_script), "--format", "json", str(path)]
    )
    overall = float(quality_payload.get("overall", 0.0))
    if overall < threshold:
        raise AdrLifecycleError(
            f"auto accept blocked: quality {overall:.2f} below threshold {threshold:.2f}"
        )
    return {"quality": overall, "threshold": threshold, "lint": lint_summary}


def _assert_acceptance_gates(path: Path, args) -> Dict:
    """Require deterministic versions of all four named gates before acceptance."""
    open_questions = unresolved_open_questions(path.read_text(encoding="utf-8"))
    if open_questions:
        raise AdrLifecycleError(
            "acceptance blocked: unresolved Open Questions: "
            + "; ".join(open_questions)
        )
    root = Path(args.repo_root).resolve() if args.repo_root else Path.cwd().resolve()
    lint_script = Path(__file__).resolve().with_name("adr-lint")
    # --context-dir hands the lint the sibling ADRs to resolve cross-references
    # against while it still reports on this file alone. Without it a
    # `supersedes` entry could never find its target and every acceptance of a
    # correctly linked successor failed with "target not found" (TASK-67).
    lint_code, lint_payload = _run_json_tool(
        [
            sys.executable,
            str(lint_script),
            "--strict",
            "--format",
            "json",
            "--gates",
            "schema,completeness,audit,evidence,clarity,consistency,policy",
            "--repo-root",
            str(root),
            "--context-dir",
            str(path.parent),
            str(path),
        ]
    )
    if lint_code != 0:
        # Report what failed, not just how many did. The counts alone sent
        # readers back to adr-lint to find out what the blocker actually was.
        failures = [
            f"{finding.get('gate', '?')}: {finding.get('summary', '')}".strip()
            for entry in lint_payload.get("files", [])
            for finding in entry.get("findings", [])
            if finding.get("level") == "FAIL"
        ]
        detail = "; ".join(failures) if failures else "see adr-lint output"
        raise AdrLifecycleError(
            "acceptance blocked: strict lint failed ("
            + json.dumps(lint_payload.get("summary", {}), sort_keys=True)
            + f"): {detail}"
        )
    return lint_payload.get("summary", {})


def command_document(args) -> List[str]:
    adr_dir = Path(args.adr_dir)
    adr_id = normalize_adr_id(args.adr)
    path = find_adr_file(adr_dir, adr_id)
    if not args.verified_in:
        raise AdrLifecycleError("document requires at least one --verified-in pointer")
    data, body = load_adr(path)
    # `document` writes a history entry like every other lifecycle command, so
    # it has to resolve a signer like every other lifecycle command. It did not,
    # and wrote `changed_by: ""` -- which the audit gate then rejected, so an
    # ADR that had just been correctly marked as documenting shipped behaviour
    # could never be accepted. The failure surfaced two commands later, blaming
    # acceptance for a defect introduced here.
    changed_by = resolve_signer(adr_dir, args.changed_by)
    body = ensure_status_history(
        path, data, body, (str(data["status"]), args.date)
    )
    data["documents_shipped"] = True
    data["verified_in"] = args.verified_in
    body = append_status_history(
        body,
        data["status"],
        changed_by,
        args.reason or "Documented already-shipped behavior",
        "adr-kit lifecycle",
        args.date,
    )
    _commit_lifecycle_changes(
        adr_dir,
        [(path, render_frontmatter(data) + body)],
    )
    return [f"documented shipped behavior: {path.name}"]


def command_auto_accept(args) -> List[str]:
    adr_dir = Path(args.adr_dir)
    adr_id = normalize_adr_id(args.adr)
    path = find_adr_file(adr_dir, adr_id)
    mode, threshold = _auto_accept_config(args, adr_dir)
    eligibility = _assert_auto_accept_eligible(path, args, threshold)
    if mode == "assist" and not args.confirm:
        return [
            f"assist: {path.name} is eligible for auto accept "
            f"(quality={eligibility['quality']:.2f}, threshold={threshold:.2f}); "
            "rerun with --confirm to mutate"
        ]
    changed = mutate_status(
        path,
        "Accepted",
        f"Accepted, {args.date}.",
        args.date,
        args.changed_by,
        args.reason or "Auto-accepted already-shipped ADR with verified evidence",
        "adr-kit lifecycle",
    )
    _commit_lifecycle_changes(adr_dir, [(path, changed)])
    return [f"auto-accepted: {path.name}"]


def _assert_acceptance_was_asked_for(path: Path, args) -> None:
    """Acceptance is the one transition that must be typed on purpose.

    Every other lifecycle command records something. This one *decides*, and it
    writes a name and a date into a history that is immutable from that moment
    on. With `lifecycle.signer` configured -- the common case now that the signer
    is derived rather than demanded -- a call that nobody meant to make wrote the
    user's own name, a plausible reason and today's date into a record they never
    saw. A false attribution is worse than a missing one; that is spec R8's own
    argument, turned against the command that implements it.

    So acceptance requires `--confirm`, the same shape auto-accept's assist mode
    already uses. What that buys is narrow and worth stating exactly: an
    acceptance can no longer happen *by accident* -- from a script written for an
    older interface, from a CI job, from an agent following a stale instruction.
    It does not stop a caller who deliberately passes the flag, and nothing at
    the process level could: an agent runs with the user's own terminal, working
    directory and environment, so there is no signal that distinguishes it from
    the user typing.

    Inferring presence from `sys.stdin.isatty()` was tried first and is wrong on
    the platform this kit marks release-required. Measured: a Windows subprocess
    with `stdin=DEVNULL` reports `isatty() == True`, because `NUL` is a character
    device and the C runtime answers about the device rather than about a
    terminal. A presence test that returns "someone is there" for /dev/null is
    worse than no test, because it reads as a guarantee.

    `accept --auto` is untouched. spec R1 grants the init flow that exception
    explicitly: there the user asked for a batch of records covering code that
    already exists, and that request is the consent.
    """
    if args.confirm:
        return
    signer = resolve_signer(Path(args.adr_dir), args.changed_by, announce=False)
    raise AdrLifecycleError(
        f"acceptance blocked: {path.name} would be signed as {signer!r}.\n"
        "  Acceptance writes that name into a history that is immutable "
        "afterwards,\n"
        "  so it has to be asked for rather than arrived at.\n"
        "  Re-run with --confirm once a human has agreed to this decision."
    )


def command_accept(args) -> List[str]:
    adr_dir = Path(args.adr_dir)
    adr_id = normalize_adr_id(args.adr)
    path = find_adr_file(adr_dir, adr_id)
    # Gates first, then the flag. A record that cannot be accepted should say
    # why it cannot be accepted; telling the author to add --confirm and only
    # then telling them the record is incomplete costs a round trip and buries
    # the actual problem. The flag is the last thing checked before the write,
    # which is also where it means what it says.
    _assert_acceptance_gates(path, args)
    _assert_acceptance_was_asked_for(path, args)
    changed = mutate_status(
        path,
        "Accepted",
        f"Accepted, {args.date}.",
        args.date,
        args.changed_by,
        args.reason or "Accepted decision after all four verification gates passed",
        "adr-kit lifecycle",
    )
    _commit_lifecycle_changes(adr_dir, [(path, changed)])
    return [f"accepted: {path.name}"]


def command_set_status(args, status: str, status_line: str, default_reason: str) -> List[str]:
    adr_dir = Path(args.adr_dir)
    adr_id = normalize_adr_id(args.adr)
    path = find_adr_file(adr_dir, adr_id)
    changed = mutate_status(
        path,
        status,
        status_line,
        args.date,
        args.changed_by,
        args.reason or default_reason,
        "adr-kit lifecycle",
    )
    _commit_lifecycle_changes(adr_dir, [(path, changed)])
    return [f"{status.lower()}: {path.name}"]


ANSWERED_LINE_RE = re.compile(
    r"^\s*[-*+]\s*\[[xX]\]\s+(?P<question>.+?)\s+—\s+\*\*Answered\b", re.MULTILINE
)


def _open_questions_section(body: str) -> Tuple[int, int, str]:
    """(start, end, text) of the Open Questions section body. Raises if absent."""
    match = re.search(
        r"^##\s+Open Questions\s*$\n(?P<body>.*?)(?=\n##\s+|\Z)",
        body,
        re.MULTILINE | re.DOTALL,
    )
    if not match:
        raise AdrLifecycleError(
            "this ADR has no `## Open Questions` section; add one, or the answer "
            "has nowhere durable to live"
        )
    return match.start("body"), match.end("body"), match.group("body")


def command_answer(args) -> List[str]:
    """Resolve an open question in place, keeping both halves of the exchange.

    Grilling asks a question and gets an answer, and until now only one of the
    two survived. `## Open Questions` holds unresolved items by design, and
    acceptance requires the list to be empty, so an author who answered a
    question had to *delete* it to accept the ADR. What remained was the Status
    History: who flipped the status and when, never what they were asked.

    That reasoning is exactly what a future reader needs to re-evaluate a
    decision, and re-evaluation is what supersession depends on.

    Nothing new had to be invented to fix it. `unresolved_open_questions`
    already skips a `[x]` item, so a checked line with the answer written into
    it survives acceptance untouched and stays in the record forever. This
    command writes that line, so the convention is a mechanism rather than a
    hope, and the signer and date come from the same resolution every other
    lifecycle command uses.
    """
    adr_dir = Path(args.adr_dir)
    adr_id = normalize_adr_id(args.adr)
    path = find_adr_file(adr_dir, adr_id)
    if not str(args.answer).strip():
        raise AdrLifecycleError("an answer with no text is a deletion with extra steps")

    data, body = load_adr(path)
    start, end, section = _open_questions_section(body)

    lines = section.splitlines()
    unresolved = [
        (index, line)
        for index, line in enumerate(lines)
        if re.match(r"^\s*[-*+]\s*(?:\[\s\]\s+)?\S", line)
        and not re.match(r"^\s*[-*+]\s*\[[xX]\]", line)
        and re.sub(r"^\s*[-*+]\s*(?:\[\s\]\s+)?", "", line).strip().casefold().rstrip(".")
        not in {"none", "no open questions", "no unresolved questions"}
    ]
    if not unresolved:
        raise AdrLifecycleError(f"{adr_id} has no unresolved question to answer")

    target = _select_question(unresolved, args.question)
    index, line = target
    question_text = re.sub(r"^\s*[-*+]\s*(?:\[\s\]\s+)?", "", line).strip()
    changed_by = resolve_signer(adr_dir, args.changed_by)
    lines[index] = (
        f"- [x] {question_text} — **Answered {args.date} by {changed_by}:** "
        f"{str(args.answer).strip()}"
    )

    # splitlines() drops the section's trailing newline; putting it back is what
    # keeps the blank line before the next heading, and a heading that loses its
    # blank line stops being a heading to some Markdown readers.
    rewritten = "\n".join(lines) + ("\n" if section.endswith("\n") else "")
    body = body[:start] + rewritten + body[end:]
    _commit_lifecycle_changes(adr_dir, [(path, render_frontmatter(data) + body)])
    return [
        f"answered in {path.name}: {question_text[:70]}",
        "the question and its answer stay in the record; acceptance is no longer blocked by it",
    ]


def _select_question(unresolved: List[Tuple[int, str]], wanted: Optional[str]):
    """Pick the question to answer: the only one, an index, or a substring."""
    if wanted is None:
        if len(unresolved) > 1:
            listing = "; ".join(
                f"{position}: "
                + re.sub(r"^\s*[-*+]\s*(?:\[\s\]\s+)?", "", line).strip()[:60]
                for position, (_index, line) in enumerate(unresolved, 1)
            )
            raise AdrLifecycleError(
                f"{len(unresolved)} unresolved questions; name one with "
                f"--question <number|text>. {listing}"
            )
        return unresolved[0]

    if re.fullmatch(r"\d+", str(wanted).strip()):
        position = int(str(wanted).strip())
        if not 1 <= position <= len(unresolved):
            raise AdrLifecycleError(
                f"--question {position} is out of range (1..{len(unresolved)})"
            )
        return unresolved[position - 1]

    needle = str(wanted).casefold()
    matches = [item for item in unresolved if needle in item[1].casefold()]
    if not matches:
        raise AdrLifecycleError(f"no unresolved question matches {wanted!r}")
    if len(matches) > 1:
        raise AdrLifecycleError(
            f"{wanted!r} matches {len(matches)} unresolved questions; be more specific"
        )
    return matches[0]


def command_relate(args) -> List[str]:
    """Write a cross-reference on both sides, or remove it from both.

    Supersession has always been reciprocal: `bin/adr supersede` writes the
    predecessor's `superseded_by` and the successor's `supersedes` in one
    transaction, so neither side can carry half a link. A plain cross-reference
    had no such writer. An ADR could cite ADR-009 forever while ADR-009 never
    learned it was cited, which is exactly the half-link the supersession check
    refuses to tolerate.

    The link goes in frontmatter, next to `supersedes`, not into the prose. That
    keeps this inside the mutation envelope the kit already permits on an
    Accepted record -- reference bookkeeping, never the decision itself. The
    body of an Accepted ADR stays untouched here, as it must.

    A pair that already has a supersession relationship is refused rather than
    doubled: superseded-by is the stronger and more specific edge, and recording
    both would let a reader believe there are two relationships where there is
    one.
    """
    adr_dir = Path(args.adr_dir)
    left_id = normalize_adr_id(args.adr)
    right_id = normalize_adr_id(args.to)
    if left_id == right_id:
        raise AdrLifecycleError("an ADR cannot be related to itself")
    left_path = find_adr_file(adr_dir, left_id)
    right_path = find_adr_file(adr_dir, right_id)

    left_data, left_body = load_adr(left_path)
    right_data, right_body = load_adr(right_path)

    for this_id, this_data, other_id in (
        (left_id, left_data, right_id),
        (right_id, right_data, left_id),
    ):
        if other_id in (this_data.get("supersedes") or []):
            raise AdrLifecycleError(
                f"{this_id} already supersedes {other_id}; supersession is the "
                "stronger relationship and is already recorded on both sides"
            )
        if this_data.get("superseded_by") == other_id:
            raise AdrLifecycleError(
                f"{this_id} is already superseded by {other_id}; supersession is "
                "the stronger relationship and is already recorded on both sides"
            )

    def apply(data: Dict, other_id: str) -> bool:
        current = [normalize_adr_id(item) or item for item in (data.get("related") or [])]
        wanted = [item for item in current if item != other_id]
        if not args.remove:
            wanted.append(other_id)
        wanted = sorted(set(wanted))
        if wanted == sorted(set(current)):
            return False
        # An empty list would be an assertion that the question was asked and
        # the answer was none. It was not: the link was simply removed. Drop the
        # key so absent keeps meaning "nothing declared here".
        if wanted:
            data["related"] = wanted
        else:
            data.pop("related", None)
        return True

    left_changed = apply(left_data, right_id)
    right_changed = apply(right_data, left_id)
    if not left_changed and not right_changed:
        verb = "not related" if args.remove else "already related"
        return [f"{left_id} and {right_id} are {verb}; nothing to do"]

    # The signer is resolved once, before any write, so a machine with no
    # configured signer refuses the whole operation instead of half of it.
    changed_by = resolve_signer(adr_dir, args.changed_by)
    action = "Unrelated" if args.remove else "Related"
    changes: List[Tuple[Path, str]] = []
    for path, data, body, other_id in (
        (left_path, left_data, left_body, right_id),
        (right_path, right_data, right_body, left_id),
    ):
        body = ensure_status_history(path, data, body, (str(data.get("status")), args.date))
        body = append_status_history(
            body,
            str(data.get("status")),
            changed_by,
            args.reason or f"{action} to {other_id}",
            "adr-kit lifecycle",
            args.date,
        )
        changes.append((path, render_frontmatter(data) + body))
    _commit_lifecycle_changes(adr_dir, changes)
    joiner = "no longer related to" if args.remove else "related to"
    return [
        f"{left_path.name}: {joiner} {right_id}",
        f"{right_path.name}: {joiner} {left_id}",
    ]


def command_supersede(args) -> List[str]:
    adr_dir = Path(args.adr_dir)
    old_id = normalize_adr_id(args.old)
    new_id = normalize_adr_id(args.by)
    old_path = find_adr_file(adr_dir, old_id)
    new_path = find_adr_file(adr_dir, new_id)
    if old_id == new_id:
        raise AdrLifecycleError("an ADR cannot supersede itself")

    old_data, old_body = load_adr(old_path)
    new_data, new_body = load_adr(new_path)
    assert_legal_transition(str(old_data.get("status")), "Superseded")
    if old_data.get("superseded_by") not in (None, new_id):
        raise AdrLifecycleError(
            f"{old_id} already has superseded_by={old_data.get('superseded_by')}"
        )
    if new_data.get("status") not in {"Proposed", "Accepted"}:
        raise AdrLifecycleError(f"{new_id} must be Proposed or Accepted")
    if new_data.get("superseded_by") is not None:
        raise AdrLifecycleError(
            f"{new_id} is itself superseded by {new_data.get('superseded_by')}"
        )
    # A successor may supersede several predecessors: `supersedes` is a list in
    # the schema, the index and the lint both resolve every entry, and one
    # decision can legitimately retire more than one record. What stays
    # exclusive is the other direction, enforced below: each predecessor gets
    # exactly one successor.
    for candidate in sorted(adr_dir.glob("ADR-*.md")):
        if candidate in {old_path, new_path}:
            continue
        candidate_data, _candidate_body = load_adr(candidate)
        if old_id in candidate_data.get("supersedes", []):
            raise AdrLifecycleError(
                f"{old_id} already has competing successor "
                f"{candidate_data.get('id', candidate.name)}"
            )

    # Both files are seeded before either is mutated: prior_transition reads the
    # frontmatter status and date that the lines below overwrite.
    old_body = ensure_status_history(
        old_path, old_data, old_body, ("Superseded", args.date)
    )
    new_body = ensure_status_history(
        new_path, new_data, new_body, (str(new_data["status"]), args.date)
    )

    # Resolved here, after both seeds. Every other lifecycle command gets its
    # signer inside `mutate_status`; supersede appends to the history directly
    # and so has to resolve it itself, or both entries land with an empty
    # `changed_by` -- which the audit gate rejects on the successor, at the
    # exact moment someone tries to accept it.
    #
    # After, not before: `ensure_status_history` above refuses a record whose
    # prior transition cannot be recovered, and that is a fact about the record,
    # not about who is asking. Resolving the actor first makes an unconfigured
    # machine report a missing signer for a record that could not be superseded
    # by anyone. Validate the act, then the actor.
    changed_by = resolve_signer(adr_dir, args.changed_by)

    old_data["status"] = "Superseded"
    old_data["date"] = args.date
    old_data["superseded_by"] = new_id
    old_body = set_status_line(old_body, f"Superseded by {new_id}, {args.date}.")
    old_body = append_status_history(
        old_body,
        "Superseded",
        changed_by,
        args.reason or f"Superseded by {new_id}",
        "adr-kit lifecycle",
        args.date,
    )
    supersedes = list(new_data.get("supersedes", []))
    if old_id not in supersedes:
        supersedes.append(old_id)
    new_data["supersedes"] = sorted(supersedes)
    new_body = append_status_history(
        new_body,
        new_data["status"],
        changed_by,
        args.reason or f"Supersedes {old_id}",
        "adr-kit lifecycle",
        args.date,
    )
    changes = [
        (new_path, render_frontmatter(new_data) + new_body),
        (old_path, render_frontmatter(old_data) + old_body),
    ]
    _commit_lifecycle_changes(adr_dir, changes)
    return [f"superseded: {old_path.name} -> {new_id}", f"updated successor: {new_path.name}"]



# --- Signer resolution (spec R8/R8.1) -------------------------------------
#
# The actor written into Status History used to default to the literal
# "adr-kit", so forgetting the flag produced a durable record saying the tool
# accepted its own ADR. That is worse than an unsigned record: it is a false
# attribution in the one place an auditor looks.
#
# The signer lives in the gitignored machine-local config, not in the tracked
# one. A committed signer would put one person's name on every teammate's
# acceptance.
#
# What this does NOT do, stated so nobody mistakes it: it does not prove a human
# was present, and it authenticates nothing. It makes the signature attributable
# and deliberate. Real non-repudiation needs signed commits, which is a separate
# decision nobody has taken yet.

LOCAL_CONFIG_NAME = ".adr-kit.local.json"


def read_local_config(adr_dir: Path) -> dict:
    """Read the machine-local config, or {} when absent or unreadable."""
    try:
        data = json.loads((Path(adr_dir) / LOCAL_CONFIG_NAME).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def configured_signer(adr_dir: Path) -> Optional[str]:
    signer = (read_local_config(adr_dir).get("lifecycle") or {}).get("signer")
    return signer.strip() if isinstance(signer, str) and signer.strip() else None


def git_user_name() -> Optional[str]:
    """`git config user.name`, or None."""
    try:
        out = subprocess.run(
            ["git", "config", "user.name"],
            capture_output=True, text=True, encoding="utf-8", errors="replace",
            timeout=5, check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    name = (out.stdout or "").strip()
    return name or None


# Identities that are configured but are not a person. Adopting one would put a
# machine's name under a human acceptance, which is the exact thing R8 exists to
# prevent -- so these fall through to the refusal, where a human is asked.
_NON_PERSON_SIGNER_RE = re.compile(
    r"(?i)^(?:"
    r".*\[bot\]|"
    r"github[-_ ]?actions?|dependabot|renovate(?:\[bot\])?|"
    r"semantic-release|release[-_ ]?bot|.*\bbot\b|"
    r"ci|build|builder|runner|jenkins|buildkite|circleci|travis|"
    r"root|admin|administrator|user|unknown|your name|"
    r"adr-kit"
    r")$"
)


def github_identity() -> List[Dict[str, str]]:
    """The signed-in GitHub account's real name and login, if `gh` can say.

    Asked for at install and upgrade time, never on the lifecycle hot path: it
    is a network call through someone else's CLI, and a tool that blocks an ADR
    write on GitHub being reachable would be trading a good property for a bad
    one.
    """
    if shutil.which("gh") is None:
        return []
    try:
        out = subprocess.run(
            ["gh", "api", "user", "--jq", "{name: .name, login: .login}"],
            capture_output=True, text=True, encoding="utf-8", errors="replace",
            timeout=10, check=False,
        )
    except (OSError, subprocess.SubprocessError):
        return []
    if out.returncode != 0:
        return []
    try:
        payload = json.loads(out.stdout or "{}")
    except (json.JSONDecodeError, ValueError):
        return []
    found: List[Dict[str, str]] = []
    if isinstance(payload, dict):
        if payload.get("name"):
            found.append({"name": str(payload["name"]).strip(),
                          "source": "gh api user (.name)"})
        if payload.get("login"):
            found.append({"name": str(payload["login"]).strip(),
                          "source": "gh api user (.login)"})
    return found


def signer_candidates() -> List[Dict[str, str]]:
    """Ranked identities to propose at install or upgrade time.

    Ordered by how well each names a human: the GitHub profile name first
    because it is the one a person actually chose to be called, then the git
    identity that already signs their commits, then the GitHub login. Each
    carries its source, because a proposal the user cannot trace is one they
    cannot judge -- and this value ends up in an immutable Status History.

    Duplicates collapse: on most machines the GitHub name and `git config
    user.name` are the same string, and offering it twice would look like two
    different options.
    """
    raw: List[Dict[str, str]] = []
    github = github_identity()
    raw.extend(entry for entry in github if entry["source"].endswith("(.name)"))
    name = git_user_name()
    if name:
        raw.append({"name": name, "source": "git config user.name"})
    raw.extend(entry for entry in github if entry["source"].endswith("(.login)"))

    seen: set[str] = set()
    candidates: List[Dict[str, str]] = []
    for entry in raw:
        key = entry["name"].casefold()
        if key in seen or not person_shaped(entry["name"]):
            continue
        seen.add(key)
        candidates.append({
            "name": entry["name"],
            "source": entry["source"],
            "actor": f"User: {entry['name']}",
        })
    return candidates


def person_shaped(name: Optional[str]) -> bool:
    """Does this identity plausibly name a human who could accept a decision?"""
    if not name or not name.strip():
        return False
    candidate = name.strip()
    if _NON_PERSON_SIGNER_RE.match(candidate):
        return False
    # An email-only identity is a person, but a bare address reads badly in a
    # history line; git's user.name is expected to be a name.
    return not candidate.startswith("<") and "@" not in candidate.split()[0]


def resolve_signer(
    adr_dir: Path,
    explicit: Optional[str],
    announce: bool = True,
) -> str:
    """Explicit flag, then configured signer, then git, then refuse.

    Reading `git config user.name` is not the tool signing on someone's behalf.
    R8.1 forbids "a default that names the tool" -- the old `adr-kit` actor,
    where the toolkit wrote itself into the record as the decider. A git
    identity is the opposite of that: it is a value the human configured on
    this machine, and every commit in the repository already carries it.

    What survives from the stricter version is the *silence*, not the refusal.
    A derived actor is announced on stderr the first time it is used, because a
    name that lands in an immutable Status History should never be one the user
    did not know was being written. And an identity that is configured but is
    not a person -- `github-actions[bot]`, `runner`, a bare `user` -- is refused
    rather than adopted, since R8 asks for evidence of which *human* accepted.
    """
    if explicit and explicit.strip():
        return explicit.strip()
    signer = configured_signer(adr_dir)
    if signer:
        return signer

    proposal = git_user_name()
    if person_shaped(proposal):
        actor = f"User: {proposal.strip()}"
        if announce:
            print(
                f"[adr-kit] signing as {actor!r}, from git config user.name.\n"
                f'[adr-kit] set a different one with: python bin/adr signer --set "User: <name>"',
                file=sys.stderr,
            )
        return actor

    if proposal:
        hint = (
            f'  python bin/adr signer --set "User: <your name>"\n'
            f"  (git config user.name is {proposal!r}, which does not name a person)"
        )
    else:
        hint = '  python bin/adr signer --set "User: <your name>"'
    raise AdrLifecycleError(
        "no signer configured, so this transition would be unsigned. "
        "A Status History entry records who decided and when, and the tool must "
        "not fill that in on your behalf. Set it once for this machine:"
        f"\n{hint}\n"
        "or pass --changed-by for a single command."
    )


def command_signer(args) -> List[str]:
    """Show, set, or audit the machine-local signer."""
    adr_dir = Path(args.adr_dir)
    if args.set:
        value = args.set.strip()
        if not value:
            raise AdrLifecycleError("--set needs a non-empty name")
        path = adr_dir / LOCAL_CONFIG_NAME
        data = read_local_config(adr_dir)
        data.setdefault("lifecycle", {})["signer"] = value
        _atomic_write_text(path, json.dumps(data, indent=2, ensure_ascii=False) + "\n")
        return [
            f"signer set: {value}",
            f"written to {path} (machine-local, gitignored)",
        ]

    if args.audit:
        offenders = []
        for path in sorted(adr_dir.glob("ADR-*.md")):
            try:
                body = path.read_text(encoding="utf-8")
            except OSError:
                continue
            for match in re.finditer(r"^\s*changed_by:\s*(.+)$", body, re.MULTILINE):
                actor = match.group(1).strip().strip('"')
                if actor in {"adr-kit", "unknown"}:
                    offenders.append(f"{path.name}: changed_by {actor!r}")
        if not offenders:
            return ["no self-signed or unknown actors found"]
        return [
            "Status History entries with no human actor:",
            *(f"  {line}" for line in offenders),
            "",
            "These predate the signer requirement. Correcting one means editing",
            "history, so it is a deliberate act, not something this command does.",
        ]

    if args.suggest:
        candidates = signer_candidates()
        current = configured_signer(adr_dir)
        if getattr(args, "format", "text") == "json":
            print(json.dumps(
                {"configured": current, "candidates": candidates},
                indent=2, ensure_ascii=False,
            ))
            return []
        if current:
            return [
                f"already configured: {current}",
                f"  in {adr_dir / LOCAL_CONFIG_NAME}",
                "Re-run with --set to change it.",
            ]
        if not candidates:
            return [
                "no signer candidate found on this machine.",
                "  git config user.name is unset or does not name a person,",
                "  and the GitHub CLI is unavailable or not signed in.",
                'Set one: python bin/adr signer --set "User: <your name>"',
            ]
        lines = ["Signer candidates found on this machine:"]
        for index, candidate in enumerate(candidates, 1):
            lines.append(f"  {index}. {candidate['actor']}   [{candidate['source']}]")
        lines.append("")
        lines.append("Nothing is written until you choose. To adopt the first:")
        lines.append(f"  python bin/adr signer --set \"{candidates[0]['actor']}\"")
        return lines

    signer = configured_signer(adr_dir)
    if signer:
        return [
            f"signer: {signer}",
            f"source: {adr_dir / LOCAL_CONFIG_NAME} (machine-local, gitignored)",
        ]

    proposal = git_user_name()
    if person_shaped(proposal):
        return [
            f"signer: User: {proposal.strip()}",
            "source: git config user.name (derived, not written to any file)",
            'override for this machine: python bin/adr signer --set "User: <name>"',
        ]

    lines = ["signer: (unset) - lifecycle commands will refuse to write history"]
    if proposal:
        lines.append(
            f"git config user.name is {proposal!r}, which does not name a person, "
            "so it is not adopted"
        )
    lines.append('set one with: python bin/adr signer --set "User: <your name>"')
    return lines


def add_common_args(parser: argparse.ArgumentParser) -> None:
    parser.add_argument("--adr-dir", default="docs/adr", help="ADR directory")
    parser.add_argument("--date", default=date.today().isoformat(), help="transition date")
    parser.add_argument(
        "--changed-by",
        default=None,
        help=(
            "status history actor. Defaults to lifecycle.signer from the "
            "machine-local config; with neither, the command refuses rather "
            "than signing on your behalf."
        ),
    )
    parser.add_argument("--reason", default=None, help="status history reason")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(prog="adr", description="adr-kit lifecycle commands")
    sub = parser.add_subparsers(dest="command", required=True)

    signer = sub.add_parser("signer", help="show, set, or audit the status-history signer")
    signer.add_argument("--adr-dir", default="docs/adr", help="ADR directory")
    signer.add_argument("--set", default=None, metavar="NAME", help='e.g. "User: Robert van den Breemen"')
    signer.add_argument("--audit", action="store_true", help="list history entries with no human actor")
    signer.add_argument(
        "--suggest",
        action="store_true",
        help=(
            "propose signer candidates found on this machine (git config, and the "
            "signed-in GitHub account when `gh` is available). Read-only: it writes "
            "nothing, so a setup flow can show them and let the user choose."
        ),
    )
    signer.add_argument("--format", choices=["text", "json"], default="text")

    new = sub.add_parser("new", help="create a Proposed ADR from a selected profile")
    new.add_argument("title")
    add_common_args(new)
    new.add_argument("--profile", choices=list(SUPPORTED_PROFILES), default=None)
    new.add_argument("--config", default=None, help="config path")

    profiles = sub.add_parser(
        "profiles",
        help="list selectable profiles and verify their shipped templates",
    )
    profiles.add_argument(
        "--format",
        choices=["human", "json"],
        default="human",
        help="output format",
    )

    propose = sub.add_parser("propose", help="mark an ADR Proposed")
    propose.add_argument("adr")
    add_common_args(propose)

    accept = sub.add_parser("accept", help="mark an ADR Accepted")
    accept.add_argument("adr")
    add_common_args(accept)
    accept.add_argument("--auto", action="store_true", help="require after-the-fact evidence checks before accepting")
    accept.add_argument("--auto-mode", choices=["auto", "assist"], default=None, help="override lifecycle.auto_accept.mode")
    accept.add_argument("--confirm", action="store_true", help="mutate in assist mode after eligibility is shown")
    accept.add_argument("--quality-threshold", type=float, default=None, help="minimum adr-quality score")
    accept.add_argument("--config", default=None, help="config path")
    accept.add_argument("--repo-root", default=None, help="consuming repo root for verified_in/gate checks")

    reject = sub.add_parser("reject", help="mark an ADR Rejected")
    reject.add_argument("adr")
    add_common_args(reject)

    answer = sub.add_parser(
        "answer",
        help="resolve an open question in place, keeping the question and the answer",
    )
    answer.add_argument("adr")
    answer.add_argument("--answer", required=True, help="the settled answer")
    answer.add_argument(
        "--question",
        default=None,
        help="which unresolved question: a 1-based number or distinctive text",
    )
    add_common_args(answer)

    relate = sub.add_parser(
        "relate",
        help="record a cross-reference between two ADRs on both sides at once",
    )
    relate.add_argument("adr")
    relate.add_argument("--to", required=True, help="the other ADR id")
    relate.add_argument(
        "--remove",
        action="store_true",
        help="drop the cross-reference from both sides instead of adding it",
    )
    add_common_args(relate)

    supersede = sub.add_parser("supersede", help="supersede an ADR by another ADR")
    supersede.add_argument("old")
    supersede.add_argument("--by", required=True, help="successor ADR id")
    add_common_args(supersede)

    document = sub.add_parser("document", help="mark an ADR as documenting shipped behavior")
    document.add_argument("adr")
    document.add_argument("--verified-in", action="append", required=True, help="local evidence pointer")
    add_common_args(document)

    return parser


def main(argv: List[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        if args.command == "signer":
            lines = command_signer(args)
        elif args.command == "new":
            lines = command_new(args)
        elif args.command == "profiles":
            lines = command_profiles(args)
        elif args.command == "propose":
            lines = command_set_status(
                args,
                "Proposed",
                f"Proposed, {args.date}.",
                "Marked Proposed",
            )
        elif args.command == "accept":
            if args.auto:
                lines = command_auto_accept(args)
            else:
                lines = command_accept(args)
        elif args.command == "reject":
            lines = command_set_status(
                args,
                "Rejected",
                f"Rejected, {args.date}.",
                "Rejected decision",
            )
        elif args.command == "answer":
            lines = command_answer(args)
        elif args.command == "relate":
            lines = command_relate(args)
        elif args.command == "supersede":
            lines = command_supersede(args)
        elif args.command == "document":
            lines = command_document(args)
        else:
            parser.error(f"unknown command {args.command}")
            return 2
    except AdrLifecycleError as exc:
        print(f"adr: {exc}", file=sys.stderr)
        return 2
    for line in lines:
        print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
