#!/usr/bin/env python3
"""adr-context: find relevant ADRs for a given task query.

Uses heuristic scoring with 5 weighted signals. Returns top N ranked ADRs.

Usage:
  adr-context "cache invalidation strategy"
  adr-context --limit 10 "database indexes"
  adr-context --format json "authentication"
  adr-context --format text "authentication"
  adr-context --adr-dir docs/adr "authentication"
  adr-context --min-score 0.2 "authentication"
  adr-context --config /path/to/.adr-kit.json "authentication"
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from datetime import date
from pathlib import Path
from typing import Dict, List, Optional

_BIN_DIR = Path(__file__).resolve().parent
if str(_BIN_DIR) not in sys.path:
    sys.path.insert(0, str(_BIN_DIR))

from adr_query import (
    IndexQueryError,
    SUPPORTED_AUTHORITIES,
    SUPPORTED_STATUSES,
    query_adr_context,
    score_record,
)


def _index_first_cli() -> int:
    """Run the healthy CLI path before loading legacy scoring compatibility."""
    parser = argparse.ArgumentParser(
        description="Find relevant ADRs through the generated ADR graph.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument("query", nargs="?", help="Task description or question")
    parser.add_argument("--limit", type=int, default=None)
    parser.add_argument("--format", choices=["json", "text"], default="text")
    parser.add_argument("--adr-dir", default=None)
    parser.add_argument("--min-score", type=float, default=None)
    parser.add_argument("--config", default=None)
    parser.add_argument("--strict-index", action="store_true")
    parser.add_argument("--include-history", action="store_true")
    parser.add_argument(
        "--status",
        action="append",
        choices=sorted(SUPPORTED_STATUSES),
        default=[],
    )
    parser.add_argument(
        "--authority",
        action="append",
        choices=sorted(SUPPORTED_AUTHORITIES),
        default=[],
    )
    parser.add_argument("--path", action="append", default=[])
    parser.add_argument("--symbol", action="append", default=[])
    parser.add_argument("--component", action="append", default=[])
    parser.add_argument("--topic", action="append", default=[])
    parser.add_argument(
        "--check-probes",
        action="store_true",
        help="Evaluate the project's deterministic selective-context probes",
    )
    parser.add_argument(
        "--probes-file",
        default=None,
        help="Override the retrieval probe JSON path",
    )
    args = parser.parse_args()

    adr_dir = Path(args.adr_dir or "docs/adr")
    if not adr_dir.exists():
        if args.format == "json":
            print("[]")
        return 0

    config: Dict = {}
    candidates = [Path(args.config)] if args.config else []
    if not candidates:
        current = adr_dir.resolve()
        for _ in range(5):
            candidates.append(current / ".adr-kit.json")
            if current.parent == current:
                break
            current = current.parent
    for path in candidates:
        try:
            if path.is_file():
                config = json.loads(path.read_text(encoding="utf-8"))
                break
        except (OSError, UnicodeError, json.JSONDecodeError):
            continue
    ctx_cfg = config.get("context", {}) if isinstance(config, dict) else {}
    if args.check_probes:
        from adr_retrieval_health import (
            render_retrieval_health,
            run_retrieval_health,
        )

        probe_path = Path(args.probes_file) if args.probes_file else None
        if probe_path is not None and not probe_path.is_absolute():
            probe_path = adr_dir / probe_path
        health = run_retrieval_health(
            adr_dir,
            probe_path=probe_path,
            config=config,
        )
        if args.format == "json":
            print(json.dumps(health, indent=2))
        else:
            print(render_retrieval_health(health))
        return 1 if health["status"] in {"fail", "degraded"} else 0
    if not args.query:
        parser.error("query is required unless --check-probes is used")
    limit = args.limit if args.limit is not None else ctx_cfg.get("default_limit", 5)
    min_score = (
        args.min_score
        if args.min_score is not None
        else ctx_cfg.get("min_score", 0.1)
    )
    try:
        outcome = query_adr_context(
            args.query,
            adr_dir,
            limit=limit,
            min_score=min_score,
            strict_index=args.strict_index or bool(ctx_cfg.get("strict_index", False)),
            include_history=args.include_history,
            statuses=tuple(args.status),
            authorities=tuple(args.authority),
            paths=tuple(args.path),
            symbols=tuple(args.symbol),
            components=tuple(args.component),
            topics=tuple(args.topic),
        )
    except (IndexQueryError, ValueError) as exc:
        print(f"[adr-context] ERROR: {exc}", file=sys.stderr)
        return 2
    for warning in outcome["warnings"]:
        print(warning, file=sys.stderr)
    results = outcome["results"]
    if args.format == "json":
        print(json.dumps(results, indent=2))
    else:
        for result in results:
            print(
                f"{result['adr_id']}: {result['title']} "
                f"(status: {result['status']}; "
                f"{result['authority']} {result['role']}; "
                f"relevance: {result['score']}; path: {result['path']})"
            )
    return 0


if __name__ == "__main__":
    raise SystemExit(_index_first_cli())


# ---------------------------------------------------------------------------
# Domain keyword sets used by infer_task_domain()
# ---------------------------------------------------------------------------

_DOMAIN_KEYWORDS: Dict[str, List[str]] = {
    "frontend": [
        "react", "css", "html", "ui", "component", "vue", "angular",
        "frontend", "browser", "dom", "webpack", "vite", "svelte", "typescript",
        "stylesheet", "layout", "responsive", "accessibility", "a11y",
    ],
    "infra": [
        "docker", "kubernetes", "k8s", "ci", "cd", "deploy", "deployment",
        "pipeline", "terraform", "helm", "ansible", "nginx", "load", "balancer",
        "container", "cloud", "aws", "azure", "gcp", "infrastructure",
        "monitoring", "logging", "observability", "prometheus", "grafana",
    ],
    "security": [
        "auth", "authentication", "authorization", "token", "jwt", "oauth",
        "ssl", "tls", "cert", "certificate", "rbac", "acl", "permission",
        "encrypt", "encryption", "secret", "password", "hash", "hmac",
        "saml", "sso", "mfa", "2fa", "firewall", "cors", "csrf", "xss",
    ],
    "data": [
        "database", "sql", "postgres", "postgresql", "mysql", "sqlite",
        "cache", "caching", "redis", "memcache", "index", "indexing", "query",
        "migration", "schema", "orm", "etl", "data", "warehouse", "nosql",
        "mongodb", "elasticsearch", "kafka", "queue", "stream", "pipeline",
        "backup", "replication", "sharding", "partitioning",
    ],
    "backend": [
        "api", "rest", "graphql", "grpc", "rpc", "service", "microservice",
        "server", "backend", "endpoint", "route", "handler", "middleware",
        "framework", "django", "flask", "fastapi", "spring", "express",
        "async", "concurrency", "thread", "worker", "task", "job", "queue",
        "business", "logic", "domain", "model", "entity", "repository",
    ],
}


_DOMAIN_RE: Optional[Dict[str, re.Pattern]] = None


def _domain_patterns() -> Dict[str, re.Pattern]:
    """Compile legacy domain helpers only when compatibility callers use them."""
    global _DOMAIN_RE
    if _DOMAIN_RE is None:
        _DOMAIN_RE = {
            domain: re.compile(
                r"\b(?:" + "|".join(map(re.escape, keywords)) + r")\b",
                re.IGNORECASE,
            )
            for domain, keywords in _DOMAIN_KEYWORDS.items()
        }
    return _DOMAIN_RE


# ---------------------------------------------------------------------------
# Keyword extraction
# ---------------------------------------------------------------------------

def extract_keywords(query: str) -> List[str]:
    """Parse query into a sorted keyword list.

    Lowercases the query, splits on non-alphanumeric characters, and filters
    out words shorter than 3 characters.
    """
    words = re.split(r"[^a-z0-9]+", query.lower())
    keywords = sorted({w for w in words if len(w) >= 3})
    return keywords


# ---------------------------------------------------------------------------
# Domain inference
# ---------------------------------------------------------------------------

def infer_task_domain(text: str) -> Optional[str]:
    """Detect domain from text.

    Checks text against per-domain keyword sets using precompiled word-bounded
    regexes. Returns the domain with the most keyword hits. Returns ``None``
    when no domain keyword matches (true ambiguity). Callers should treat a
    ``None`` result as "domain unknown" and award no domain_tag signal credit.
    """
    scores: Dict[str, int] = {}
    for domain, pattern in _domain_patterns().items():
        count = len(pattern.findall(text))
        if count > 0:
            scores[domain] = count

    if not scores:
        return None

    # Return the domain with the highest hit count; ties broken alphabetically
    return max(scores, key=lambda d: (scores[d], d))


def _domain_has_signal(text: str) -> bool:
    """Return True if at least one domain keyword appears in text.

    Used to avoid awarding domain_tag credit when neither query nor ADR has
    any concrete domain evidence.
    """
    for pattern in _domain_patterns().values():
        if pattern.search(text):
            return True
    return False


# ---------------------------------------------------------------------------
# ADR metadata extraction
# ---------------------------------------------------------------------------

def extract_adr_metadata(adr_file: Path) -> Dict:
    """Read ADR file and extract relevant metadata.

    Returns a dict with:
      - adr_id: "ADR-001"
      - title: text after "# ADR-NNN "
      - status: Accepted / Proposed / etc.
      - domain_tags: inferred domain from title + decision text
      - related_ids: list of "ADR-NNN" strings from Related Decisions section
      - date: datetime.date or None (from ## Status section)
      - decision_text: raw text of ## Decision section (for keyword + domain scoring)
    """
    from adr_catalog import load_adr_record

    record = load_adr_record(adr_file)
    adr_date: Optional[date] = None
    if record["date"]:
        try:
            adr_date = date.fromisoformat(record["date"])
        except ValueError:
            adr_date = None

    # Domain: infer from title + decision text
    domain_source = f"{record['title']} {record['decision_text']}"
    domain_tags = infer_task_domain(domain_source)
    domain_has_keywords = _domain_has_signal(domain_source)

    return {
        "adr_id": record["adr_id"],
        "title": record["title"],
        "path": adr_file.as_posix(),
        "status": record["status"],
        "format": record["format"],
        "domain_tags": domain_tags,
        "domain_has_keywords": domain_has_keywords,
        "related_ids": record["related_ids"],
        "date": adr_date,
        "decision_text": record["decision_text"],
        "decision_summary": record["decision"],
        "topics": record["topics"],
        "aliases": record["aliases"],
        "components": record["components"],
        "symbols": record["symbols"],
        "context_scope": record["context_scope"],
        "decision_contract": record["decision_contract"],
        "scope": record["scope"],
        "metadata": {
            "binding": record["binding"],
            "gate": record["gate"],
            "documents_shipped": record["documents_shipped"],
            "verified_in": record["verified_in"],
            "supersedes": record["supersedes"],
            "superseded_by": record["superseded_by"],
        },
    }


# ---------------------------------------------------------------------------
# Scoring
# ---------------------------------------------------------------------------

def score_adr(query: str, keywords: List[str], domain: Optional[str], metadata: Dict,
              weights: Optional[Dict[str, float]] = None) -> Dict:
    """Compatibility wrapper over the index-first positive-evidence scorer.

    ``keywords``, ``domain``, and legacy ``weights`` remain accepted for one
    compatibility window, but status, age, domain, and relationship count no
    longer contribute relevance.
    """
    record = {
        "title": metadata.get("title", ""),
        "decision_summary": metadata.get("decision_summary")
        or metadata.get("decision_text", ""),
        "scope": {"path_globs": metadata.get("scope", [])},
        "topics": metadata.get("topics", []),
        "aliases": metadata.get("aliases", []),
        "components": metadata.get("components", []),
        "symbols": metadata.get("symbols", []),
        "decision_contract": metadata.get("decision_contract", {}),
    }
    return score_record(record, query)


# ---------------------------------------------------------------------------
# Main loader
# ---------------------------------------------------------------------------

def load_adr_context(
    query: str,
    adr_dir: Path,
    limit: int = 5,
    min_score: float = 0.1,
    config: Optional[Dict] = None,
    strict_index: bool = False,
    include_history: bool = False,
    statuses: tuple[str, ...] = (),
    authorities: tuple[str, ...] = (),
    paths: tuple[str, ...] = (),
    symbols: tuple[str, ...] = (),
    components: tuple[str, ...] = (),
    topics: tuple[str, ...] = (),
) -> List[Dict]:
    """Return ranked ADRs from the graph, with visible Markdown fallback."""
    ctx_cfg = config.get("context", {}) if isinstance(config, dict) else {}
    outcome = query_adr_context(
        query,
        adr_dir,
        limit=limit,
        min_score=min_score,
        strict_index=strict_index or bool(ctx_cfg.get("strict_index", False)),
        include_history=include_history,
        statuses=statuses,
        authorities=authorities,
        paths=paths,
        symbols=symbols,
        components=components,
        topics=topics,
    )
    for warning in outcome["warnings"]:
        print(warning, file=sys.stderr)
    return outcome["results"]


# ---------------------------------------------------------------------------
# Config loading
# ---------------------------------------------------------------------------

def load_config(config_path: Optional[Path], adr_dir: Path) -> Dict:
    """Load .adr-kit.json from explicit path or auto-discover near adr_dir."""
    candidates: List[Path] = []
    if config_path:
        candidates.append(config_path)
    else:
        # Walk up from adr_dir to find .adr-kit.json
        current = adr_dir.resolve()
        for _ in range(5):
            candidates.append(current / ".adr-kit.json")
            parent = current.parent
            if parent == current:
                break
            current = parent

    for path in candidates:
        if path.exists():
            try:
                return json.loads(path.read_text(encoding="utf-8"))
            except Exception:
                pass
    return {}


# ---------------------------------------------------------------------------
# CLI
# ---------------------------------------------------------------------------

def main() -> None:
    parser = argparse.ArgumentParser(
        description="Find relevant ADRs for a task query using weighted signals.",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    parser.add_argument("query", nargs="?", help="Task description or question")
    parser.add_argument("--limit", type=int, default=None,
                        help="Maximum number of results (default: 5 or from config)")
    parser.add_argument("--format", choices=["json", "text"], default="text",
                        help="Output format (default: text)")
    parser.add_argument("--adr-dir", default=None,
                        help="Directory containing ADR-*.md files (default: docs/adr)")
    parser.add_argument("--min-score", type=float, default=None,
                        help="Minimum relevance score threshold (default: 0.1 or from config)")
    parser.add_argument("--config", default=None,
                        help="Path to .adr-kit.json config file")
    parser.add_argument("--strict-index", action="store_true",
                        help="Fail instead of using the Markdown compatibility fallback")
    parser.add_argument("--include-history", action="store_true",
                        help="Include non-governing historical ADR statuses")
    parser.add_argument("--status", action="append",
                        choices=sorted(SUPPORTED_STATUSES), default=[],
                        help="Lifecycle status filter; may be repeated")
    parser.add_argument("--authority", action="append",
                        choices=sorted(SUPPORTED_AUTHORITIES), default=[],
                        help="Authority filter; may be repeated")
    parser.add_argument("--path", action="append", default=[],
                        help="Changed or target path; may be repeated")
    parser.add_argument("--symbol", action="append", default=[],
                        help="Code symbol; may be repeated")
    parser.add_argument("--component", action="append", default=[],
                        help="Architectural component; may be repeated")
    parser.add_argument("--topic", action="append", default=[],
                        help="Explicit retrieval topic; may be repeated")
    parser.add_argument("--check-probes", action="store_true",
                        help="Evaluate deterministic selective-context probes")
    parser.add_argument("--probes-file", default=None,
                        help="Override the retrieval probe JSON path")

    args = parser.parse_args()

    # Resolve config
    config_path = Path(args.config) if args.config else None
    adr_dir_raw = args.adr_dir or "docs/adr"
    adr_dir = Path(adr_dir_raw)

    config = load_config(config_path, adr_dir)
    ctx_cfg = config.get("context", {})
    if args.check_probes:
        from adr_retrieval_health import (
            render_retrieval_health,
            run_retrieval_health,
        )
        probe_path = Path(args.probes_file) if args.probes_file else None
        if probe_path is not None and not probe_path.is_absolute():
            probe_path = adr_dir / probe_path
        health = run_retrieval_health(
            adr_dir,
            probe_path=probe_path,
            config=config,
        )
        if args.format == "json":
            print(json.dumps(health, indent=2))
        else:
            print(render_retrieval_health(health))
        sys.exit(1 if health["status"] in {"fail", "degraded"} else 0)
    if not args.query:
        parser.error("query is required unless --check-probes is used")

    # Apply config defaults, CLI flags take priority
    limit = args.limit if args.limit is not None else ctx_cfg.get("default_limit", 5)
    # Canonical key is "min_score"; legacy "min_relevance_threshold" was removed.
    cfg_min_score = ctx_cfg.get("min_score", 0.1)
    min_score = args.min_score if args.min_score is not None else cfg_min_score

    if not adr_dir.exists():
        if args.format == "json":
            print("[]")
        # In text mode, print nothing for a missing directory
        sys.exit(0)

    try:
        results = load_adr_context(
            query=args.query,
            adr_dir=adr_dir,
            limit=limit,
            min_score=min_score,
            config=config,
            strict_index=args.strict_index,
            include_history=args.include_history,
            statuses=tuple(args.status),
            authorities=tuple(args.authority),
            paths=tuple(args.path),
            symbols=tuple(args.symbol),
            components=tuple(args.component),
            topics=tuple(args.topic),
        )
    except (IndexQueryError, ValueError) as exc:
        print(f"[adr-context] ERROR: {exc}", file=sys.stderr)
        sys.exit(2)

    if args.format == "json":
        print(json.dumps(results, indent=2))
    else:
        for r in results:
            print(
                f"{r['adr_id']}: {r['title']} "
                f"(status: {r['status']}; {r['authority']} {r['role']}; "
                f"relevance: {r['score']}; path: {r['path']})"
            )


if __name__ == "__main__":
    main()
