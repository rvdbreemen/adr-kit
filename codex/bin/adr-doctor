#!/usr/bin/env python3
"""Fast, evidence-backed ADR Kit health checks and bounded deep probes."""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
_BIN_DIR = ROOT / "bin"


def _is_bin_dir(entry: str) -> bool:
    """True when a sys.path entry resolves to this script's own directory.

    Compared resolved, not textually: CPython only guarantees an absolute
    sys.path[0] from 3.11 onward, and "" (cwd) must also be caught when bin/
    happens to be the working directory.
    """
    try:
        return Path(entry or ".").resolve() == _BIN_DIR
    except (OSError, ValueError):
        return False


# SEC-HIGH (TASK-62): ROOT/"bin" used to go on sys.path at position 0 together
# with these two, which let any module committed next to this script shadow the
# standard library. The bin siblings are now loaded by explicit file location
# (below), so that entry is gone.
#
# ROOT and ROOT/"scripts" must stay importable: adr_doctor_checks and
# adr_doctor_probes reach into scripts/adr_settings.py, scripts/project_setup.py,
# clients.installer.* and hooks.hook_benchmark, which are packages and flat
# modules in OTHER directories, not siblings. They are APPENDED so the standard
# library and site-packages still resolve first.
#
# In a generated client tree those same relative paths exist because
# client_generation_model.RUNTIME_SUPPORT_FILES declares them, which is what
# lets this file run from codex/ and copilot/ at all (TASK-125).
# scripts/client_generation.py is deliberately NOT among them -- a mirror has no
# canonical inputs to diff -- so adr_doctor_checks imports it lazily, behind
# adr_doctor_models.generated_tree_owner().
#
# That alone is not enough here. CPython puts this script's own directory at
# sys.path[0] regardless, ahead of these appends, so a committed
# bin/adr_settings.py shadowed scripts/adr_settings.py and executed --
# reproduced against this file after the sibling conversion. The bin entry is
# therefore masked for the duration of the import block below and restored
# afterwards; restoring is safe because nothing in that dependency tree imports
# lazily, and it keeps an in-process importer (pytest) from losing an entry
# other test modules put there deliberately.
for import_root in (ROOT, ROOT / "scripts"):
    if str(import_root) not in sys.path:
        sys.path.append(str(import_root))

_SAVED_SYS_PATH = list(sys.path)
sys.path[:] = [entry for entry in _SAVED_SYS_PATH if not _is_bin_dir(entry)]


def _load_sibling(name: str):
    """Import bin/<name>.py by explicit path, WITHOUT touching sys.path.

    Registered in sys.modules under the bare name so each module's own sibling
    imports (adr_doctor_core -> adr_schema + adr_retrieval_health, and so on)
    resolve from the cache. bin/adr-judge carries the full rationale.
    """
    cached = sys.modules.get(name)
    if cached is not None:
        return cached
    loader = importlib.machinery.SourceFileLoader(name, str(_BIN_DIR / f"{name}.py"))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


# Dependency order: adr_catalog needs adr_format + adr_schema; adr_query lazily
# needs adr_catalog; adr_retrieval_health needs adr_query; adr_doctor_core needs
# adr_schema + adr_retrieval_health; adr_doctor_checks and adr_doctor_probes
# need adr_doctor_models (plus the scripts/ packages appended above).
for _sibling in (
    "adr_format",
    "adr_schema",
    "adr_catalog",
    "adr_query",
    "adr_retrieval_health",
    "adr_doctor_models",
    "adr_doctor_core",
    "adr_doctor_checks",
    "adr_doctor_probes",
):
    _load_sibling(_sibling)

from adr_doctor_checks import run_client_checks
from adr_doctor_probes import run_deep_extensions
from adr_doctor_core import render_text as render_adr_text
from adr_doctor_core import run_doctor as run_adr_doctor
from adr_doctor_models import build_report, render_human

sys.path[:] = _SAVED_SYS_PATH
del _SAVED_SYS_PATH


def _parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="adr-doctor",
        description="Check ADR state and Claude/Codex/Copilot integration.",
    )
    parser.add_argument("adr_dir", nargs="?", default="docs/adr")
    parser.add_argument("--repo-root")
    parser.add_argument("--plugin-root", type=Path, default=ROOT)
    parser.add_argument("--config")
    parser.add_argument("--global-settings", type=Path)
    parser.add_argument("--stale-days", type=int)
    parser.add_argument("--format", choices=("text", "human", "json"), default="text")
    parser.add_argument("--check", action="store_true", help="Diagnose without repair.")
    parser.add_argument("--fix", action="store_true", help="Permit backed-up managed rewrites.")
    parser.add_argument("--deep", action="store_true", help="Run bounded native, MCP, and model probes.")
    parser.add_argument("--fix-index", action="store_true", help=argparse.SUPPRESS)
    return parser


def main(argv: list[str] | None = None) -> int:
    args = _parser().parse_args(argv)
    root = Path(args.repo_root).resolve() if args.repo_root else Path.cwd().resolve()
    # Backward compatibility: --fix-index is an explicit safe-repair request.
    # Default mode also repairs safe owned state; --check is the read-only gate.
    args.fix_index = bool(args.fix_index or not args.check)
    adr = run_adr_doctor(args)
    checks, repairs = run_client_checks(
        root,
        args.plugin_root.resolve(),
        global_settings=args.global_settings,
        check_only=args.check,
        allow_fix=args.fix,
    )
    extensions = run_deep_extensions(
        root,
        args.plugin_root.resolve(),
        checks=checks,
        global_settings=args.global_settings,
        check_only=args.check,
    ) if args.deep else []
    report = build_report(
        root=root,
        mode="deep" if args.deep else "fast",
        adr=adr,
        checks=[*checks, *extensions],
        repairs=repairs,
    )
    if args.format == "json":
        print(json.dumps(report, indent=2, sort_keys=True))
    elif args.format == "text" and not checks and not extensions:
        print(render_adr_text(adr))
    else:
        print(render_human(report))
    return int(report["exit_code"])


if __name__ == "__main__":
    raise SystemExit(main())
