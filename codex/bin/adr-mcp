# ---------------------------------------------------------------------------
# CLI subprocess plumbing
# ---------------------------------------------------------------------------

def run_cli(
    script: str,
    args: List[str],
    root: Path,
    stdin_text: Optional[str] = None,
    env_extra: Optional[Dict[str, str]] = None,
) -> Tuple[int, str, str]:
    """Run a sibling bin/ script via the current interpreter.

    Returns (exit_code, stdout, stderr). Raises subprocess.TimeoutExpired
    on timeout; callers convert that into a tool error.
    """
    cmd = [sys.executable, str(BIN_DIR / script)] + args
    env = dict(os.environ)
    if env_extra:
        env.update(env_extra)
    # Make the child WRITE utf-8, since we decode it as utf-8 just below.
    #
    # Honest scope (measured, TASK-69): every CLI wrapped here emits JSON with
    # ensure_ascii=True, so their *stdout* is pure ASCII today and this line
    # changes nothing on that path -- an A/B with it disabled produced
    # byte-identical output. It is kept for the two places that are not
    # ASCII-safe by construction: the child's *stderr*, which carries free-form
    # warning text that can quote a non-ASCII path, and any future CLI that
    # dumps with ensure_ascii=False. Without it those decode through
    # errors="replace" and become U+FFFD.
    #
    # It is NOT what fixed the corruption this task was filed for; that was
    # _pin_stdio_to_utf8 on our own stdout. Set after env_extra so a caller
    # cannot unset it by accident.
    env["PYTHONIOENCODING"] = "utf-8"
    proc = subprocess.run(
        cmd,
        input=stdin_text,
        capture_output=True,
        text=True,
        encoding="utf-8",
        errors="replace",
        cwd=str(root),
        env=env,
        timeout=CLI_TIMEOUT_S,
    )
    return proc.returncode, proc.stdout, proc.stderr


def _parse_json_or_raw(text: str) -> Any:
    try:
        return json.loads(text)
    except ValueError:
        return text


def _text_result(payload: Any, is_error: bool = False) -> Dict[str, Any]:
    """Wrap a payload as an MCP tools/call result: one text content item."""
    if isinstance(payload, str):
        text = payload
    else:
        text = json.dumps(payload, indent=2, ensure_ascii=False)
    result: Dict[str, Any] = {"content": [{"type": "text", "text": text}]}
    if is_error:
        result["isError"] = True
    return result


def _call_paths(
    arguments: Dict[str, Any],
    default_root: Path,
    default_adr_dir: Path,
) -> Tuple[Path, Path]:
    """Resolve optional per-call workspace paths without changing server state."""
    raw_root = arguments.get("project_root")
    if raw_root is not None and (not isinstance(raw_root, str) or not raw_root.strip()):
        raise ValueError("'project_root' must be a non-empty string")
    if raw_root and not Path(raw_root).expanduser().is_absolute():
        raise ValueError("'project_root' must be an absolute path")
    root = Path(raw_root).expanduser().resolve() if raw_root else default_root
    if not root.is_dir():
        raise ValueError(f"project root not found: {root}")

    raw_adr_dir = arguments.get("adr_dir")
    if raw_adr_dir is not None and (
        not isinstance(raw_adr_dir, str) or not raw_adr_dir.strip()
    ):
        raise ValueError("'adr_dir' must be a non-empty string")
    if raw_adr_dir:
        candidate = Path(raw_adr_dir).expanduser()
        adr_dir = (candidate if candidate.is_absolute() else root / candidate).resolve()
    elif raw_root:
        adr_dir = root / "docs" / "adr"
    else:
        adr_dir = default_adr_dir
    try:
        adr_dir.relative_to(root)
    except ValueError as exc:
        raise ValueError(f"ADR directory must stay within project root: {adr_dir}") from exc
    return root, adr_dir


# ---------------------------------------------------------------------------
# Tool handlers
# ---------------------------------------------------------------------------

def tool_adr_context(arguments: Dict[str, Any], root: Path, adr_dir: Path) -> Dict[str, Any]:
    try:
        root, adr_dir = _call_paths(arguments, root, adr_dir)
    except ValueError as exc:
        return _text_result(f"adr_context: {exc}", is_error=True)
    query = arguments.get("query")
    if not isinstance(query, str) or not query.strip():
        return _text_result("adr_context: 'query' must be a non-empty string", is_error=True)
    args = ["--format", "json", "--adr-dir", str(adr_dir)]
    limit = arguments.get("limit")
    if limit is not None:
        if (
            not isinstance(limit, int)
            or isinstance(limit, bool)
            or not 1 <= limit <= 100
        ):
            return _text_result(
                "adr_context: 'limit' must be an integer between 1 and 100",
                is_error=True,
            )
        args += ["--limit", str(limit)]
    list_options = {
        "paths": "--path",
        "components": "--component",
        "symbols": "--symbol",
        "topics": "--topic",
        "statuses": "--status",
        "authorities": "--authority",
    }
    allowed_values = {
        "statuses": {
            "Accepted", "Proposed", "Superseded", "Rejected",
            "Deprecated", "Amended", "Unknown",
        },
        "authorities": {"governing", "advisory", "historical"},
    }
    for field, option in list_options.items():
        values = arguments.get(field, [])
        if (
            not isinstance(values, list)
            or len(values) > 32
            or any(
                not isinstance(value, str)
                or not value.strip()
                or len(value) > 240
                for value in values
            )
        ):
            return _text_result(
                f"adr_context: '{field}' must be an array of at most 32 "
                "non-empty strings",
                is_error=True,
            )
        if field in allowed_values and any(
            value not in allowed_values[field] for value in values
        ):
            return _text_result(
                f"adr_context: '{field}' contains an unsupported value",
                is_error=True,
            )
        for value in values:
            args += [option, value]
    for field, option in (
        ("include_history", "--include-history"),
        ("strict_index", "--strict-index"),
    ):
        value = arguments.get(field, False)
        if not isinstance(value, bool):
            return _text_result(
                f"adr_context: '{field}' must be a boolean",
                is_error=True,
            )
        if value:
            args.append(option)
    min_score = arguments.get("min_score")
    if min_score is not None:
        if (
            not isinstance(min_score, (int, float))
            or isinstance(min_score, bool)
            or not 0 <= float(min_score) <= 1
        ):
            return _text_result(
                "adr_context: 'min_score' must be a number between 0 and 1",
                is_error=True,
            )
        args += ["--min-score", str(min_score)]
    args.append(query)
    rc, out, err = run_cli("adr-context", args, root)
    if rc != 0:
        return _text_result(f"adr-context exited {rc}: {err.strip() or out.strip()}", is_error=True)
    return _text_result(_parse_json_or_raw(out))


def tool_adr_judge(arguments: Dict[str, Any], root: Path, adr_dir: Path) -> Dict[str, Any]:
    try:
        root, adr_dir = _call_paths(arguments, root, adr_dir)
    except ValueError as exc:
        return _text_result(f"adr_judge: {exc}", is_error=True)
    diff = arguments.get("diff")
    if not isinstance(diff, str) or not diff.strip():
        return _text_result("adr_judge: 'diff' must be a non-empty string", is_error=True)
    args = [
        "--diff", "-",
        "--adr-dir", str(adr_dir),
        "--repo-root", str(root),
        "--snapshot", "worktree",  # TASK-65: the caller has a worktree; "diff" cannot see a modified file's post-image.
        "--json",
    ]
    # Never run the LLM pass from the MCP server: key-free by design.
    # --llm is simply not passed; ADR_KIT_NO_LLM=1 is belt and braces.
    rc, out, err = run_cli(
        "adr-judge", args, root, stdin_text=diff, env_extra={"ADR_KIT_NO_LLM": "1"},
    )
    if rc == 2:
        return _text_result(f"adr-judge exited 2 (config/input error): {err.strip()}", is_error=True)
    # rc 0 (clean) and rc 1 (violations) are both valid judge outcomes.
    payload = {"exit_code": rc, "verdict": "violation" if rc == 1 else "ok",
               "result": _parse_json_or_raw(out)}
    return _text_result(payload)


def tool_adr_status(arguments: Dict[str, Any], root: Path, adr_dir: Path) -> Dict[str, Any]:
    try:
        root, adr_dir = _call_paths(arguments, root, adr_dir)
    except ValueError as exc:
        return _text_result(f"adr_status: {exc}", is_error=True)
    rc, out, err = run_cli("adr-status", ["--format", "json", "--adr-dir", str(adr_dir)], root)
    if rc != 0:
        return _text_result(f"adr-status exited {rc}: {err.strip() or out.strip()}", is_error=True)
    return _text_result(_parse_json_or_raw(out))


def _resolve_adr_files(adr_dir: Path, adr_id: Optional[str]) -> List[Path]:
    """List ADR markdown files, optionally filtered to one numeric id."""
    files = sorted(p for p in adr_dir.glob("ADR-*.md") if p.is_file())
    if adr_id is None:
        return files
    match = _ADR_ID_RE.search(adr_id) or re.fullmatch(r"0*(\d{1,4})", adr_id.strip())
    if not match:
        return []
    wanted = int(match.group(1))
    selected = []
    for path in files:
        m = _ADR_ID_RE.search(path.name)
        if m and int(m.group(1)) == wanted:
            selected.append(path)
    return selected


def tool_adr_quality(arguments: Dict[str, Any], root: Path, adr_dir: Path) -> Dict[str, Any]:
    try:
        root, adr_dir = _call_paths(arguments, root, adr_dir)
    except ValueError as exc:
        return _text_result(f"adr_quality: {exc}", is_error=True)
    adr_id = arguments.get("adr_id")
    if adr_id is not None and not isinstance(adr_id, str):
        return _text_result("adr_quality: 'adr_id' must be a string", is_error=True)
    if not adr_dir.is_dir():
        return _text_result(f"adr_quality: ADR directory not found: {adr_dir}", is_error=True)
    files = _resolve_adr_files(adr_dir, adr_id)
    if not files:
        what = f"no ADR matching '{adr_id}'" if adr_id else "no ADR files"
        return _text_result(f"adr_quality: {what} in {adr_dir}", is_error=True)
    reports = []
    for path in files:
        rc, out, err = run_cli("adr-quality", ["--format", "json", str(path)], root)
        if rc == 2:
            reports.append({"file": path.name, "error": err.strip() or f"exit {rc}"})
        else:
            entry = _parse_json_or_raw(out)
            if isinstance(entry, dict):
                entry.setdefault("file", path.name)
            reports.append(entry)
    payload: Any = reports[0] if adr_id else {"adrs": reports}
    return _text_result(payload)


def tool_adr_readiness(
    arguments: Dict[str, Any], root: Path, adr_dir: Path
) -> Dict[str, Any]:
    try:
        root, adr_dir = _call_paths(arguments, root, adr_dir)
    except ValueError as exc:
        return _text_result(f"adr_readiness: {exc}", is_error=True)
    cli_args = [
        "--format",
        "json",
        "--repo-root",
        str(root),
        "--adr-dir",
        str(adr_dir),
    ]
    adr_id = arguments.get("adr_id")
    if adr_id is not None:
        if not isinstance(adr_id, str) or not adr_id.strip():
            return _text_result(
                "adr_readiness: 'adr_id' must be a non-empty string",
                is_error=True,
            )
        cli_args.append(adr_id)
    if arguments.get("all_proposed") is True:
        cli_args.append("--all-proposed")
    elif arguments.get("all_proposed") not in {None, False}:
        return _text_result(
            "adr_readiness: 'all_proposed' must be a boolean",
            is_error=True,
        )
    base = arguments.get("base")
    head = arguments.get("head")
    if (base is None) != (head is None):
        return _text_result(
            "adr_readiness: 'base' and 'head' must be supplied together",
            is_error=True,
        )
    if base is not None:
        if not all(isinstance(value, str) and value.strip() for value in (base, head)):
            return _text_result(
                "adr_readiness: 'base' and 'head' must be non-empty strings",
                is_error=True,
            )
        cli_args.extend(["--base", base, "--head", head])
    today = arguments.get("today")
    if today is not None:
        if not isinstance(today, str) or not today.strip():
            return _text_result(
                "adr_readiness: 'today' must be a non-empty string",
                is_error=True,
            )
        cli_args.extend(["--today", today])
    rc, out, err = run_cli("adr-readiness", cli_args, root)
    if rc != 0:
        return _text_result(
            f"adr-readiness exited {rc}: {err.strip() or out.strip()}",
            is_error=True,
        )
    return _text_result(_parse_json_or_raw(out))


def tool_adr_lint(arguments: Dict[str, Any], root: Path, adr_dir: Path) -> Dict[str, Any]:
    try:
        root, adr_dir = _call_paths(arguments, root, adr_dir)
    except ValueError as exc:
        return _text_result(f"adr_lint: {exc}", is_error=True)
    strict = arguments.get("strict", False)
    if not isinstance(strict, bool):
        return _text_result("adr_lint: 'strict' must be a boolean", is_error=True)
    args = ["--format", "json", "--repo-root", str(root)]
    if strict:
        args.append("--strict")
    args.append(str(adr_dir))
    rc, out, err = run_cli("adr-lint", args, root)
    if rc == 2:
        return _text_result(
            f"adr-lint exited 2 (config/input error): {err.strip() or out.strip()}",
            is_error=True,
        )
    # rc 0 (clean) and rc 1 (failing findings) are both valid lint outcomes.
    payload = {"exit_code": rc, "verdict": "findings" if rc == 1 else "ok",
               "result": _parse_json_or_raw(out)}
    return _text_result(payload)


def tool_adr_related(arguments: Dict[str, Any], root: Path, adr_dir: Path) -> Dict[str, Any]:
    try:
        root, adr_dir = _call_paths(arguments, root, adr_dir)
    except ValueError as exc:
        return _text_result(f"adr_related: {exc}", is_error=True)
    adr_id = arguments.get("adr_id")
    if not isinstance(adr_id, str) or not adr_id.strip():
        return _text_result(
            "adr_related: 'adr_id' must be a non-empty string", is_error=True
        )
    args = ["--format", "json", "--adr-dir", str(adr_dir), adr_id]
    rc, out, err = run_cli("adr-related", args, root)
    if rc != 0:
        return _text_result(
            f"adr-related exited {rc}: {err.strip() or out.strip()}", is_error=True
        )
    return _text_result(_parse_json_or_raw(out))


TOOL_HANDLERS = {
    "adr_context": tool_adr_context,
    "adr_judge": tool_adr_judge,
    "adr_status": tool_adr_status,
    "adr_quality": tool_adr_quality,
    "adr_readiness": tool_adr_readiness,
    "adr_lint": tool_adr_lint,
    "adr_related": tool_adr_related,
}


# ---------------------------------------------------------------------------
# JSON-RPC 2.0 plumbing (newline-delimited over stdio)
# ---------------------------------------------------------------------------

JSONRPC_VERSION = "2.0"

PARSE_ERROR = -32700
INVALID_REQUEST = -32600
METHOD_NOT_FOUND = -32601
INVALID_PARAMS = -32602
INTERNAL_ERROR = -32603

# Specification-reserved range (-32020..-32099). Only the one code this
# server can legitimately reach is defined here: -32020 (HeaderMismatch) is
# HTTP-only and unreachable on stdio, and -32021 (MissingRequiredClient-
# Capability) has no code path because the server never samples, elicits or
# asks for roots. Neither may be emitted (ADR-016).
UNSUPPORTED_PROTOCOL_VERSION = -32022


def _pin_stdio_to_utf8() -> None:
    """Force UTF-8, LF-terminated stdio regardless of the host's locale.

    The MCP stdio transport mandates UTF-8 and newline-delimited framing. Python
    opens std streams in text mode using the platform default, which on a cp1252
    Windows host breaks both (TASK-69):

    * ``bin/adr-status`` emits U+2014 in "Superseded - consider archiving"; it
      left as the cp1252 byte 0x97, so the frame was not valid UTF-8. Strict
      readers abort the session; lenient ones silently accept mojibake.
    * U+2192 from ``adr-context`` has no cp1252 mapping at all, so
      ``_write_message`` raised ``UnicodeEncodeError``, which ``dispatch``'s
      broad handler turned into JSON-RPC -32603. The tool result was lost.
    * Text-mode writes translated the trailing "\\n" to "\\r\\n".

    ``newline=""`` disables that translation, so the "\\n" appended in
    ``_write_message`` reaches the wire as one byte. Reconfiguration happens
    once in ``main`` before ``serve``; the ``hasattr`` guard covers a caller
    that replaced a std stream with an object lacking ``reconfigure``.
    """
    for stream, kwargs in (
        (sys.stdin, {"encoding": "utf-8"}),
        (sys.stdout, {"encoding": "utf-8", "newline": ""}),
        # stderr carries diagnostics, not protocol. errors="replace" keeps an
        # unmappable character in a log line from raising inside the server.
        (sys.stderr, {"encoding": "utf-8", "errors": "replace"}),
    ):
        if hasattr(stream, "reconfigure"):
            try:
                stream.reconfigure(**kwargs)
            except (ValueError, OSError):
                # A detached or non-seekable stream; the default encoding stays.
                pass


def _write_message(payload: Dict[str, Any]) -> None:
    sys.stdout.write(json.dumps(payload, ensure_ascii=False) + "\n")
    sys.stdout.flush()


def request_id_is_valid(value: Any) -> bool:
    """True when this server may echo `value` as a JSON-RPC id.

    `RequestId` is `string | number` in schema.ts and `string | integer` in the
    generated schema.json. Floats are refused even when integral: Python cannot
    echo 1.0 without serialising it as `1.0`, which is not an integer in JSON,
    and the echo lands in the server's OWN outgoing frame - the one place a
    non-conformant peer cannot correct for us. Normalising 1.0 to 1 would keep
    the value but silently change the representation the client chose, against
    "It MUST be the same as the value of the id member in the Request Object".
    JSON-RPC 2.0 itself says numbers SHOULD NOT contain fractional parts.

    `bool` is excluded explicitly, because isinstance(True, int) is True.
    """
    if isinstance(value, bool):
        return False
    return isinstance(value, (str, int))


def _reply_result(req_id: Any, result: Dict[str, Any]) -> None:
    _write_message({"jsonrpc": JSONRPC_VERSION, "id": req_id, "result": result})


def _reply_error(
    req_id: Any, code: int, message: str, data: Optional[Dict[str, Any]] = None
) -> None:
    error: Dict[str, Any] = {"code": code, "message": message}
    if data is not None:
        error["data"] = data
    _write_message({"jsonrpc": JSONRPC_VERSION, "id": req_id, "error": error})


# ---------------------------------------------------------------------------
# Method handlers
# ---------------------------------------------------------------------------

def frame_is_modern(method: str, params: Dict[str, Any]) -> bool:
    """Classify one frame's protocol era. A PURE FUNCTION of that frame.

    No per-process and no per-connection state is consulted or kept, so the
    same bytes always get the same answer. Exactly two rules (ADR-016):

    1. `server/discover`, or a `params._meta` carrying the reserved
       `io.modelcontextprotocol/protocolVersion` key -> modern. The sentinel
       is that one key, not the required pair: its prefix is spec-reserved so
       a legacy client cannot mint it, while a bare `_meta` is no evidence at
       all (legacy requests already put `progressToken` there). Checking only
       the version key means a half-built envelope still routes modern and
       gets a -32602 naming what is missing, instead of being misrouted to
       legacy and failing confusingly.
    2. Anything else -> legacy.

    `initialize` is the one explicit exception to rule 1: it routes legacy
    even when the modern envelope is stamped on it, because `initialize`
    does not exist at 2026-07-28 at all, so an envelope on it is a client
    defect rather than an era signal (TASK-58.1 AC #6).

    There is deliberately NO era lock: locking would make a byte-identical
    frame get two different answers depending on what arrived earlier on the
    same stdin, which is what "Servers MUST NOT rely on prior requests over
    the same connection to establish context" forbids.
    """
    if method == "initialize":
        return False
    if method == "server/discover":
        return True
    meta = params.get("_meta")
    return isinstance(meta, dict) and PROTOCOL_VERSION_META_KEY in meta


def modern_envelope_error(
    params: Dict[str, Any]
) -> Optional[Tuple[int, str, Optional[Dict[str, Any]]]]:
    """Validate a modern-routed frame's envelope and negotiate its version.

    Returns (code, message, data) for the first failure, or None when the
    frame may be served. Routing signal and validation stay separate: a
    frame routed modern on the sentinel alone is still rejected here when
    the rest of the envelope is absent.
    """
    meta = params.get("_meta")
    if not isinstance(meta, dict):
        meta = {}
    missing = [
        key
        for key in (PROTOCOL_VERSION_META_KEY, CLIENT_CAPABILITIES_META_KEY)
        if key not in meta
    ]
    if missing:
        return (
            INVALID_PARAMS,
            "Invalid params: modern request is missing required _meta key(s): "
            + ", ".join(missing),
            None,
        )
    requested = meta[PROTOCOL_VERSION_META_KEY]
    if not isinstance(requested, str):
        # A shape defect, not a negotiation failure: -32022 is the one code
        # auto-negotiating clients do not fall back from.
        return (
            INVALID_PARAMS,
            f"Invalid params: '{PROTOCOL_VERSION_META_KEY}' must be a string",
            None,
        )
    if not isinstance(meta[CLIENT_CAPABILITIES_META_KEY], dict):
        # Also a shape defect, and deliberately decided before negotiation:
        # RequestMetaObject types this key as ClientCapabilities, so a scalar
        # there is a malformed envelope rather than a version disagreement.
        return (
            INVALID_PARAMS,
            f"Invalid params: '{CLIENT_CAPABILITIES_META_KEY}' must be an object",
            None,
        )
    if requested not in MODERN_PROTOCOL_VERSIONS:
        # Era-scoped: a modern answer lists modern versions only, because a
        # handshake revision cannot be reached through a modern envelope.
        return (
            UNSUPPORTED_PROTOCOL_VERSION,
            f"Unsupported protocol version: {requested!r}",
            {"supported": list(MODERN_PROTOCOL_VERSIONS), "requested": requested},
        )
    return None


def _modern_result(
    payload: Dict[str, Any], cacheable: bool = False
) -> Dict[str, Any]:
    """Stamp a modern-era result: resultType, cache hints, _meta.serverInfo.

    `resultType` is always "complete": the seven tools are fully parameterised
    by their arguments, so the server never emits "input_required" and never
    invents a value of its own. Cache hints are stamped on `server/discover`
    and `tools/list` only - `CallToolResult` extends `Result`, not
    `CacheableResult`.
    """
    result: Dict[str, Any] = {"resultType": "complete"}
    result.update(payload)
    if cacheable:
        result["ttlMs"] = MODERN_CACHE_TTL_MS
        result["cacheScope"] = MODERN_CACHE_SCOPE
    meta = dict(result.get("_meta") or {})
    meta[SERVER_INFO_META_KEY] = {"name": "adr-kit", "version": server_version()}
    result["_meta"] = meta
    return result


def negotiate_handshake_version(requested: Any) -> str:
    """Confirm a declared handshake version, or counter-offer the newest.

    Absent, unknown, or a modern-era value such as "2026-07-28" all get the
    counter-offer. The handshake revisions mandate exactly this ("Otherwise,
    the server MUST respond with another protocol version it supports"), so
    -32022 is never emitted on the legacy surface. Nothing is ever reflected
    back unvalidated.
    """
    if isinstance(requested, str) and requested in HANDSHAKE_PROTOCOL_VERSIONS:
        return requested
    return HANDSHAKE_COUNTER_OFFER


def handle_initialize(params: Dict[str, Any]) -> Dict[str, Any]:
    return {
        "protocolVersion": negotiate_handshake_version(params.get("protocolVersion")),
        "capabilities": {"tools": {}},
        "serverInfo": {"name": "adr-kit", "version": server_version()},
    }


def handle_server_discover(params: Dict[str, Any]) -> Dict[str, Any]:
    """The modern-era replacement for the handshake.

    Returns the five required DiscoverResult fields plus the two optional
    ones this server has something to say with. There is deliberately no
    top-level `serverInfo` and no top-level `protocolVersion`: neither field
    exists in DiscoverResult this revision, and identity travels in `_meta`.
    `supportedVersions` lists the MODERN versions only - legacy reachability
    is settled by the handshake, and advertising a handshake revision here
    would invite a client to send it inside an envelope that does not exist.
    """
    return _modern_result(
        {
            "supportedVersions": list(MODERN_PROTOCOL_VERSIONS),
            "capabilities": {"tools": {}},
            "instructions": MODERN_INSTRUCTIONS,
        },
        cacheable=True,
    )


def handle_tools_list(params: Dict[str, Any]) -> Dict[str, Any]:
    return {"tools": TOOL_DEFINITIONS}


def handle_tools_call(params: Dict[str, Any], root: Path, adr_dir: Path) -> Dict[str, Any]:
    name = params.get("name")
    handler = TOOL_HANDLERS.get(name)
    if handler is None:
        raise KeyError(name)
    arguments = params.get("arguments") or {}
    if not isinstance(arguments, dict):
        return _text_result(f"{name}: 'arguments' must be an object", is_error=True)
    try:
        return handler(arguments, root, adr_dir)
    except subprocess.TimeoutExpired:
        return _text_result(f"{name}: underlying CLI timed out after {CLI_TIMEOUT_S}s", is_error=True)
    except Exception as exc:  # noqa: BLE001 - tool failure must not kill the loop
        return _text_result(f"{name}: internal error: {exc}", is_error=True)


def dispatch(message: Dict[str, Any], root: Path, adr_dir: Path) -> None:
    """Handle one JSON-RPC message. Notifications get no reply."""
    req_id = message.get("id")
    is_notification = "id" not in message
    method = message.get("method")
    params = message.get("params") or {}
    if not isinstance(params, dict):
        params = {}

    # Base protocol first, before anything era-specific. `jsonrpc` and the id
    # shape are JSON-RPC 2.0 rather than MCP, so both eras answer them alike,
    # and clearing them here means every echo further down is a shape this
    # server is allowed to emit.
    if message.get("jsonrpc") != JSONRPC_VERSION:
        if not is_notification:
            _reply_error(None, INVALID_REQUEST,
                         f"Invalid request: 'jsonrpc' must be {JSONRPC_VERSION!r}")
        return

    if not is_notification and not request_id_is_valid(req_id):
        # The id cannot be echoed without repeating the defect it carries, so
        # the reply takes the null id JSON-RPC 2.0 reserves for exactly this
        # case - the same convention serve() already uses for a parse error.
        _reply_error(None, INVALID_REQUEST,
                     "Invalid request: 'id' must be a string or an integer")
        return

    if not isinstance(method, str):
        if not is_notification:
            _reply_error(req_id, INVALID_REQUEST, "Invalid request: missing method")
        return

    if method.startswith("notifications/"):
        # notifications/initialized, notifications/cancelled,
        # notifications/progress, ...: accepted and ignored in both eras.
        # The notification rules forbid a response, and the seven tool
        # handlers are synchronous subprocess calls that cannot be
        # interrupted mid-flight, so nothing further is emitted either.
        return

    try:
        if frame_is_modern(method, params):
            _dispatch_modern(req_id, is_notification, method, params, root, adr_dir)
        else:
            _dispatch_legacy(req_id, is_notification, method, params, root, adr_dir)
    except Exception as exc:  # noqa: BLE001 - the loop must survive anything
        if not is_notification:
            _reply_error(req_id, INTERNAL_ERROR, f"Internal error: {exc}")


def _dispatch_legacy(
    req_id: Any,
    is_notification: bool,
    method: str,
    params: Dict[str, Any],
    root: Path,
    adr_dir: Path,
) -> None:
    """Handshake-era dispatch. Results keep exactly their historical shape.

    No resultType, no _meta.serverInfo, no ttlMs and no cacheScope:
    CacheableResult does not exist in the handshake revisions, so stamping
    those fields here would invent wire fields the client's schema does not
    define.
    """
    if method == "initialize":
        _reply_result(req_id, handle_initialize(params))
    elif method == "ping":
        _reply_result(req_id, {})
    elif method == "tools/list":
        _reply_result(req_id, handle_tools_list(params))
    elif method == "tools/call":
        try:
            _reply_result(req_id, handle_tools_call(params, root, adr_dir))
        except KeyError:
            _reply_error(req_id, INVALID_PARAMS,
                         f"Unknown tool: {params.get('name')!r}")
    else:
        if not is_notification:
            _reply_error(req_id, METHOD_NOT_FOUND, f"Method not found: {method}")


def _dispatch_modern(
    req_id: Any,
    is_notification: bool,
    method: str,
    params: Dict[str, Any],
    root: Path,
    adr_dir: Path,
) -> None:
    """Modern-era (2026-07-28) dispatch.

    Envelope validation and version negotiation run first and take
    precedence over any result, including on `server/discover`: a probe
    without the required keys is malformed, and a probe naming an
    unsupported version gets -32022 whose `data.supported` carries exactly
    the list `supportedVersions` would have carried.
    """
    failure = modern_envelope_error(params)
    if failure is not None:
        code, message, data = failure
        if not is_notification:
            _reply_error(req_id, code, message, data)
        return

    if method == "server/discover":
        _reply_result(req_id, handle_server_discover(params))
    elif method == "tools/list":
        _reply_result(req_id, _modern_result(handle_tools_list(params), cacheable=True))
    elif method == "tools/call":
        try:
            _reply_result(
                req_id, _modern_result(handle_tools_call(params, root, adr_dir))
            )
        except KeyError:
            _reply_error(req_id, INVALID_PARAMS,
                         f"Unknown tool: {params.get('name')!r}")
    else:
        # `ping` lands here: revision 2026-07-28 removed it, so it is not
        # advertised or served in this era. There is no result to stamp.
        if not is_notification:
            _reply_error(req_id, METHOD_NOT_FOUND, f"Method not found: {method}")


def serve(root: Path, adr_dir: Path) -> int:
    """Main loop: one JSON-RPC message per line on stdin until EOF."""
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            message = json.loads(line)
        except ValueError:
            _reply_error(None, PARSE_ERROR, "Parse error")
            continue
        if not isinstance(message, dict):
            _reply_error(None, INVALID_REQUEST, "Invalid request: expected object")
            continue
        dispatch(message, root, adr_dir)
    return 0


# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def main() -> int:
    parser = argparse.ArgumentParser(
        prog="adr-mcp",
        description="Thin MCP stdio server wrapping the adr-kit CLIs.",
    )
    parser.add_argument(
        "--root",
        default=None,
        help="Project root the tools operate on. Default: PROJECT_ROOT env, "
        "then the current working directory.",
    )
    parser.add_argument(
        "--adr-dir",
        default=None,
        help="Directory containing ADR-*.md files. Default: <root>/docs/adr.",
    )
    args = parser.parse_args()

    # Before anything writes a byte: the transport contract is UTF-8 + LF.
    _pin_stdio_to_utf8()

    root = Path(args.root or os.environ.get("PROJECT_ROOT") or os.getcwd()).resolve()
    if not root.is_dir():
        print(f"adr-mcp: project root not found: {root}", file=sys.stderr)
        return 2
    adr_dir = Path(args.adr_dir).resolve() if args.adr_dir else root / "docs" / "adr"

    print(f"adr-mcp {server_version()} serving root={root} adr_dir={adr_dir}",
          file=sys.stderr)
    try:
        return serve(root, adr_dir)
    except KeyboardInterrupt:
        return 0


if __name__ == "__main__":
    sys.exit(main())
