#!/usr/bin/env python3
"""adr-mcp: thin Model Context Protocol server wrapping the adr-kit CLIs.

Speaks MCP over stdio: newline-delimited JSON-RPC 2.0 messages on
stdin/stdout (MCP stdio transport does NOT use Content-Length framing).
Hand-rolled on the Python stdlib only, so no `mcp` package is required.

The protocol surface is deliberately tiny (server/discover, initialize,
initialized, tools/list, tools/call, ping); the dispatch table in serve() is
shaped so swapping in the official `mcp` SDK later is a local change.

Protocol era: this server is dual-era (ADR-016). MCP revision 2026-07-28
removed the initialize handshake in favour of stateless per-request
envelopes, so both surfaces are served from one process:

  * handshake era (2024-11-05 .. 2025-11-25) - reached through `initialize`,
    which confirms a declared version or counter-offers the newest one.
  * modern era (2026-07-28) - reached through `server/discover` or through
    the reserved `io.modelcontextprotocol/protocolVersion` key in
    `params._meta`. Modern results carry `resultType`, `_meta.serverInfo`
    and, on `server/discover` and `tools/list`, `ttlMs` / `cacheScope`.

The era is a PURE FUNCTION of the single frame being answered: no
per-process and no per-connection era state, so the same bytes always get
the same answer. That is deliberate - the spec forbids relying on prior
requests over the same connection to establish context. See ADR-016 and
docs/research/2026-07-29-mcp-2026-07-28-revision.md.

Exposes exactly 7 tools, each a subprocess call into a sibling bin/ script:

  adr_context   {query, limit?, paths?, components?, symbols?, topics?,
                 statuses?, authorities?, include_history?, strict_index?}
                                    -> bin/adr-context --format json
  adr_judge     {diff}           -> bin/adr-judge --json (declarative pass
                                    only, never --llm: key-free by design)
  adr_status    {}               -> bin/adr-status --format json
  adr_quality   {adr_id?}        -> bin/adr-quality --format json per ADR
  adr_readiness {adr_id?, all_proposed?, base?, head?, today?}
                                  -> bin/adr-readiness --format json
  adr_lint      {strict?}        -> bin/adr-lint --format json
  adr_related   {adr_id}         -> bin/adr-related --format json

Admission is governed by ADR-040: a CLI joins this surface only when it is
read-only, deterministic and key-free, agent-query-shaped, and covers an
agent-guide cycle step no exposed tool already covers.

adr-suggest is intentionally NOT exposed: it is an LLM-only advisory (its
deterministic part is just a docs-only skip filter), and this server stays
key-free. Thin beats feature count; see docs/research/2026-06-12-adr-landscape.md.

Usage:
  adr-mcp [--root DIR] [--adr-dir DIR]

Project root resolution: --root flag > PROJECT_ROOT env > current directory.
ADR directory defaults to <root>/docs/adr.

Every tool also accepts optional ``project_root`` and ``adr_dir`` arguments.
They let plugin clients select the active workspace per call even when the
MCP process itself starts inside an installed plugin cache.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from typing import Any, Dict, List, Optional, Tuple

BIN_DIR = Path(__file__).resolve().parent
REPO_ROOT = BIN_DIR.parent

# ---------------------------------------------------------------------------
# Protocol version registry (ADR-016)
# ---------------------------------------------------------------------------
#
# Versions are an ENUMERATED SET, never a sortable scalar. Membership is a
# tuple lookup; an unrecognised peer string is never ordered against a known
# one, because date-shaped strings only happen to sort lexicographically
# ("zzz" > "2025-11-25" is True) and future identifiers may not be dates.

# Reachable through the `initialize` handshake. One stateless code path
# serves all four: the tools-only subset (initialize / tools/list /
# tools/call / ping) is identical across them, so nothing has to remember
# which revision was negotiated.
HANDSHAKE_PROTOCOL_VERSIONS = ("2024-11-05", "2025-03-26", "2025-06-18", "2025-11-25")

# The stateless per-request envelope era.
MODERN_PROTOCOL_VERSIONS = ("2026-07-28",)

# Every version this server implements, oldest first.
KNOWN_PROTOCOL_VERSIONS = HANDSHAKE_PROTOCOL_VERSIONS + MODERN_PROTOCOL_VERSIONS

# Counter-offered when an `initialize` names a version outside the handshake
# set, or names none. The handshake revisions mandate a counter-offer, never
# an error, so -32022 must never reach an `initialize` response.
HANDSHAKE_COUNTER_OFFER = HANDSHAKE_PROTOCOL_VERSIONS[-1]

# Reserved `_meta` keys, spelled exactly as the specification does. The
# `io.modelcontextprotocol/` prefix is spec-reserved, so legacy traffic
# cannot mint these.
PROTOCOL_VERSION_META_KEY = "io.modelcontextprotocol/protocolVersion"
CLIENT_CAPABILITIES_META_KEY = "io.modelcontextprotocol/clientCapabilities"
CLIENT_INFO_META_KEY = "io.modelcontextprotocol/clientInfo"
SERVER_INFO_META_KEY = "io.modelcontextprotocol/serverInfo"
LOG_LEVEL_META_KEY = "io.modelcontextprotocol/logLevel"

# Cache hints for modern `server/discover` and `tools/list` results only.
# `tools/call` is not a cacheable operation. "public" because the tool list
# is identical for every caller and carries no user-specific data. An int is
# emitted deliberately: schema.ts says `ttlMs: number` (@minimum 0) while the
# generated schema.json says "type": "integer"; an int satisfies both.
MODERN_CACHE_TTL_MS = 300000
MODERN_CACHE_SCOPE = "public"

MODERN_INSTRUCTIONS = (
    "adr-kit: read-only Architecture Decision Record tooling. Call tools/list "
    "for the seven deterministic, key-free tools (adr_context, adr_judge, "
    "adr_status, adr_quality, adr_readiness, adr_lint, adr_related). Every "
    "tool accepts optional project_root and adr_dir arguments to select the "
    "active workspace."
)

# Per-tool subprocess timeout. The wrapped CLIs are regex-only and fast;
# this only guards against pathological inputs.
CLI_TIMEOUT_S = 60

_ADR_ID_RE = re.compile(r"ADR-0*(\d{1,4})", re.IGNORECASE)

WORKSPACE_PROPERTIES: Dict[str, Dict[str, Any]] = {
    "project_root": {
        "type": "string",
        "description": (
            "Absolute path to the active project. Use this for plugin-provided "
            "servers whose process starts in a plugin cache."
        ),
    },
    "adr_dir": {
        "type": "string",
        "description": (
            "Optional ADR directory. Relative paths are resolved from project_root."
        ),
    },
}


# ---------------------------------------------------------------------------
# Server metadata
# ---------------------------------------------------------------------------

def server_version() -> str:
    """Read the version from the native manifest in any client distribution."""
    manifests = (
        REPO_ROOT / ".claude-plugin" / "plugin.json",
        REPO_ROOT / ".codex-plugin" / "plugin.json",
        REPO_ROOT / "plugin.json",
    )
    for manifest in manifests:
        try:
            data = json.loads(manifest.read_text(encoding="utf-8"))
            version = data.get("version")
            if isinstance(version, str) and version:
                return version
        except (OSError, ValueError):
            continue
    return "0.0.0"


