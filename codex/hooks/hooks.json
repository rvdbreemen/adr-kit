{
  "description": "ADR Kit deterministic fail-open lifecycle hooks.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.cmd\" session-start codex-cli",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"if (([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) -and (Test-Path -LiteralPath (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/run-hook.cmd') -PathType Leaf)) { & (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/run-hook.cmd') session-start codex-cli }; exit 0\"",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.cmd\" user-prompt-submit codex-cli",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"if (([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) -and (Test-Path -LiteralPath (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/run-hook.cmd') -PathType Leaf)) { & (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/run-hook.cmd') user-prompt-submit codex-cli }; exit 0\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.cmd\" pre-tool-use codex-cli",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"if (([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) -and (Test-Path -LiteralPath (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/run-hook.cmd') -PathType Leaf)) { & (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/run-hook.cmd') pre-tool-use codex-cli }; exit 0\"",
            "timeout": 5
          }
        ],
        "matcher": "Edit|MultiEdit|Write"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.cmd\" pre-tool-use codex-cli",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"if (([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) -and (Test-Path -LiteralPath (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/run-hook.cmd') -PathType Leaf)) { & (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/run-hook.cmd') pre-tool-use codex-cli }; exit 0\"",
            "timeout": 5
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.cmd\" post-tool-use codex-cli",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"if (([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) -and (Test-Path -LiteralPath (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/run-hook.cmd') -PathType Leaf)) { & (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/run-hook.cmd') post-tool-use codex-cli }; exit 0\"",
            "timeout": 5
          }
        ],
        "matcher": "Edit|MultiEdit|Write"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.cmd\" subagent-start codex-cli",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"if (([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) -and (Test-Path -LiteralPath (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/run-hook.cmd') -PathType Leaf)) { & (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/run-hook.cmd') subagent-start codex-cli }; exit 0\"",
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.cmd\" pre-compact codex-cli",
            "commandWindows": "powershell.exe -NoProfile -NonInteractive -Command \"if (([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) -and (Test-Path -LiteralPath (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/run-hook.cmd') -PathType Leaf)) { & (Join-Path ([Environment]::GetEnvironmentVariable('PLUGIN_ROOT')) 'hooks/run-hook.cmd') pre-compact codex-cli }; exit 0\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
