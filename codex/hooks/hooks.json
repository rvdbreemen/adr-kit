{
  "description": "ADR Kit deterministic fail-open lifecycle hooks.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.cmd\" session-start codex-cli",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" session-start codex-cli",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.cmd\" user-prompt-submit codex-cli",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" user-prompt-submit codex-cli",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.cmd\" pre-tool-use codex-cli",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" pre-tool-use codex-cli",
            "timeout": 1
          }
        ],
        "matcher": "Edit|MultiEdit|Write"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.cmd\" pre-tool-use codex-cli",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" pre-tool-use codex-cli",
            "timeout": 5
          }
        ],
        "matcher": "Bash"
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.cmd\" post-tool-use codex-cli",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" post-tool-use codex-cli",
            "timeout": 1
          }
        ],
        "matcher": "Edit|MultiEdit|Write"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.cmd\" subagent-start codex-cli",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" subagent-start codex-cli",
            "timeout": 1
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.cmd\" pre-compact codex-cli",
            "commandWindows": "\"%PLUGIN_ROOT%\\hooks\\run-hook.cmd\" pre-compact codex-cli",
            "timeout": 1
          }
        ]
      }
    ]
  }
}
