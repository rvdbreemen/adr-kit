{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adr-kit.dev/schemas/adr-context-probes.schema.json",
  "title": "ADR Kit selective-context retrieval probes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "probes"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "probes": {
      "type": "array",
      "maxItems": 100,
      "items": {"$ref": "#/$defs/probe"}
    }
  },
  "$defs": {
    "strings": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 240}
    },
    "adrIds": {
      "type": "array",
      "maxItems": 20,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^ADR-[0-9]{3,4}$"}
    },
    "probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "query", "expect"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,79}$"
        },
        "query": {"type": "string", "minLength": 1, "maxLength": 1000},
        "paths": {"$ref": "#/$defs/strings"},
        "components": {"$ref": "#/$defs/strings"},
        "symbols": {"$ref": "#/$defs/strings"},
        "topics": {"$ref": "#/$defs/strings"},
        "limit": {"type": "integer", "minimum": 1, "maximum": 20, "default": 3},
        "expect": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include": {"$ref": "#/$defs/adrIds"},
            "exclude": {"$ref": "#/$defs/adrIds"}
          }
        }
      }
    }
  }
}
