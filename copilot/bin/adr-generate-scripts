#!/usr/bin/env python3
"""adr-generate-scripts: generate standalone validation scripts from ADR Enforcement blocks.

Creates executable scripts (Python, Shell) that validate code against ADR Enforcement
rules without requiring adr-kit. Generated scripts read from stdin and exit 0 on clean,
1 on violation.

Usage:
  adr-generate-scripts
  adr-generate-scripts --output .generated/
  adr-generate-scripts --lang shell
  adr-generate-scripts --lang python
  adr-generate-scripts --lang all
  adr-generate-scripts --adr-dir docs/decisions
"""

from __future__ import annotations

import argparse
import json
import re
import sys
from pathlib import Path
from typing import Dict, List, Optional, Tuple

# Mirrors adr-judge's ENFORCEMENT_BLOCK_RE exactly so extraction is consistent.
ENFORCEMENT_BLOCK_RE = re.compile(
    r"^##\s+Enforcement\s*$\n+.*?```json\s*\n(.*?)\n```",
    re.IGNORECASE | re.MULTILINE | re.DOTALL,
)

ADR_FILENAME_RE = re.compile(r"(?i)^ADR-(\d{1,4})-.*\.md$")


def adr_id_from_filename(name: str) -> Optional[str]:
    """Return normalised ADR-NNN id from a filename, or None."""
    m = ADR_FILENAME_RE.match(name)
    if not m:
        return None
    return f"ADR-{int(m.group(1)):03d}"


def extract_enforcement(content: str) -> Optional[Dict]:
    """Extract and parse the Enforcement JSON block from an ADR.

    Returns None when no Enforcement section is present.
    Raises ValueError when the section exists but contains malformed JSON.
    """
    m = ENFORCEMENT_BLOCK_RE.search(content)
    if not m:
        return None
    raw = m.group(1)
    try:
        data = json.loads(raw)
    except json.JSONDecodeError as e:
        raise ValueError(f"malformed JSON in ## Enforcement block: {e}")
    if not isinstance(data, dict):
        raise ValueError(f"Enforcement JSON must be an object, got {type(data).__name__}")
    return data


def _collect_rules(enforcement: Dict) -> Tuple[List[Dict], List[str]]:
    """Compile the standalone-safe rule subset and list unsupported semantics."""
    rules: List[Dict] = []
    unsupported: List[str] = []
    for kind in ("forbid_pattern", "forbid_import", "require_pattern"):
        for index, rule in enumerate(enforcement.get(kind, [])):
            pattern = rule.get("pattern", "")
            message = rule.get("message") or f"{kind}: {pattern}"
            if rule.get("path_glob"):
                unsupported.append(f"{kind}[{index}].path_glob")
                continue
            if not pattern:
                unsupported.append(f"{kind}[{index}].pattern")
                continue
            try:
                re.compile(pattern)
            except re.error as exc:
                unsupported.append(f"{kind}[{index}].pattern ({exc})")
                continue
            rules.append({"kind": kind, "pattern": pattern, "message": message})
    if enforcement.get("llm_judge"):
        unsupported.append("llm_judge")
    return rules, unsupported


def generate_python_script(adr_id: str, rules: List[Dict]) -> str:
    """Generate a standalone validator with killable per-rule regex workers."""
    template = """\
#!/usr/bin/env python3
# Generated by adr-kit for __ADR_ID__. Do not edit manually.
# Validates stdin against __ADR_ID__ enforcement rules.
# Usage: cat file.py | python validate.py
# Exit 0 = clean, exit 1 = violations, exit 2 = incomplete enforcement.

import json
import re
import subprocess
import sys

RULES = __RULES__
MAX_INPUT_BYTES = 2 * 1024 * 1024
REGEX_TIMEOUT_SECONDS = 1.0


def _regex_worker():
    try:
        request = json.load(sys.stdin)
        pattern = re.compile(request["pattern"], re.MULTILINE)
        match = pattern.search(request["text"])
        response = {"ok": True, "matched": match is not None}
        if match is not None:
            response["line"] = request["text"].count("\\n", 0, match.start()) + 1
            response["snippet"] = request["text"].splitlines()[
                response["line"] - 1
            ][:200]
        json.dump(response, sys.stdout)
        return 0
    except (KeyError, TypeError, ValueError, re.error) as exc:
        json.dump({"ok": False, "error": str(exc)}, sys.stdout)
        return 2


def _search(pattern, text):
    request = json.dumps({"pattern": pattern, "text": text})
    try:
        result = subprocess.run(
            [sys.executable, __file__, "--regex-worker"],
            input=request,
            capture_output=True,
            text=True,
            encoding="utf-8",
            errors="replace",
            timeout=REGEX_TIMEOUT_SECONDS,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return None, (
            f"regex exceeded {REGEX_TIMEOUT_SECONDS:.3f}s wall-clock budget"
        )
    try:
        response = json.loads(result.stdout)
    except json.JSONDecodeError:
        return None, "isolated regex worker returned invalid JSON"
    if result.returncode != 0 or not response.get("ok"):
        return None, response.get("error", "isolated regex worker failed")
    return response, None


def main():
    text = sys.stdin.read()
    input_bytes = len(text.encode("utf-8", errors="replace"))
    if input_bytes > MAX_INPUT_BYTES:
        print(
            f"ERROR: input is {input_bytes} bytes; safety budget is "
            f"{MAX_INPUT_BYTES} bytes",
            file=sys.stderr,
        )
        return 2
    violations = 0
    for rule in RULES:
        response, error = _search(rule["pattern"], text)
        if error is not None:
            print(
                f"ERROR: {rule['kind']} pattern {rule['pattern']!r} could not "
                f"be evaluated safely: {error}",
                file=sys.stderr,
            )
            return 2
        matched = response["matched"]
        if rule["kind"] == "require_pattern":
            if not matched:
                print(f"VIOLATION: {rule['message']}", file=sys.stderr)
                violations += 1
        elif matched:
            print(
                f"VIOLATION line {response['line']}: {rule['message']}",
                file=sys.stderr,
            )
            print(f"  {response['snippet']}", file=sys.stderr)
            violations += 1
    return 1 if violations else 0


if __name__ == "__main__":
    if len(sys.argv) == 2 and sys.argv[1] == "--regex-worker":
        raise SystemExit(_regex_worker())
    raise SystemExit(main())
"""
    return template.replace("__ADR_ID__", adr_id).replace(
        "__RULES__",
        json.dumps(rules, indent=2, ensure_ascii=False),
    )


def generate_shell_script(adr_id: str, rules: List[Dict]) -> str:
    """Generate a POSIX launcher for the parity-preserving Python validator."""
    del rules
    return f"""\
#!/bin/bash
# Generated by adr-kit for {adr_id}. Do not edit manually.
# Launches the bounded Python validator so regex semantics remain identical.
# Usage: cat file.py | bash validate.sh
# Exit 0 = clean, exit 1 = violations, exit 2 = incomplete enforcement.

set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
if command -v python3 >/dev/null 2>&1; then
    PYTHON=python3
elif command -v python >/dev/null 2>&1; then
    PYTHON=python
else
    printf '%s\\n' '[adr-validate] ERROR: Python 3.10+ is required.' >&2
    exit 2
fi
exec "$PYTHON" "$SCRIPT_DIR/validate.py"
"""


def _make_executable(path: Path) -> None:
    """Add user-execute bit to path. No-op on Windows.

    Deliberately user-only (S_IXUSR) — generated scripts may live in shared
    work-trees; world/group +x is unnecessary and a mild SEC concern.
    """
    try:
        import stat
        current = path.stat().st_mode
        path.chmod(current | stat.S_IXUSR)
    except (AttributeError, NotImplementedError):
        pass  # Windows — chmod is a no-op


def generate_scripts_for_adr(
    adr_id: str,
    enforcement: Dict,
    output_dir: Path,
    langs: List[str],
) -> Tuple[List[Path], List[str]]:
    """Generate scripts plus capability metadata for one ADR."""
    rules, unsupported = _collect_rules(enforcement)
    if not rules and not unsupported:
        return [], []

    adr_output = output_dir / adr_id
    adr_output.mkdir(parents=True, exist_ok=True)

    capabilities = {
        "schema_version": 1,
        "adr_id": adr_id,
        "status": "unsupported" if unsupported else "supported",
        "rule_types": sorted({rule["kind"] for rule in rules}),
        "regex_engine": "python-re-isolated-subprocess",
        "regex_timeout_seconds": 1.0,
        "max_input_bytes": 2 * 1024 * 1024,
        "path_scope": False,
        "shell_mode": "python-launcher" if "shell" in langs else None,
        "unsupported": unsupported,
    }
    capability_path = adr_output / "capabilities.json"
    capability_path.write_text(
        json.dumps(capabilities, indent=2, ensure_ascii=False) + "\n",
        encoding="utf-8",
    )
    written = [capability_path]
    if unsupported:
        return written, unsupported

    if "python" in langs or "shell" in langs:
        p = adr_output / "validate.py"
        p.write_text(generate_python_script(adr_id, rules), encoding="utf-8")
        _make_executable(p)
        written.append(p)

    if "shell" in langs:
        p = adr_output / "validate.sh"
        p.write_bytes(generate_shell_script(adr_id, rules).encode("utf-8"))
        _make_executable(p)
        written.append(p)

    return written, []


def main() -> int:
    parser = argparse.ArgumentParser(
        description="Generate standalone ADR enforcement validation scripts."
    )
    parser.add_argument(
        "--output",
        type=Path,
        default=Path(".generated"),
        help="Output directory (default: .generated)",
    )
    parser.add_argument(
        "--lang",
        choices=["python", "shell", "all"],
        default="all",
        help="Language(s) to generate (default: all)",
    )
    parser.add_argument(
        "--adr-dir",
        type=Path,
        default=None,
        help="Directory containing ADR-*.md files (default: docs/adr)",
    )
    parser.add_argument(
        "adr_dir_positional",
        nargs="?",
        default=None,
        metavar="adr_dir",
        help="Directory containing ADR-*.md files (positional alternative to --adr-dir)",
    )

    args = parser.parse_args()

    # Resolve ADR dir: --adr-dir wins over positional, then default.
    if args.adr_dir is not None:
        adr_dir = args.adr_dir
    elif args.adr_dir_positional is not None:
        adr_dir = Path(args.adr_dir_positional)
    else:
        adr_dir = Path("docs/adr")

    if args.lang == "all":
        langs = ["python", "shell"]
    else:
        langs = [args.lang]

    output_dir = args.output
    output_dir.mkdir(parents=True, exist_ok=True)

    if not adr_dir.is_dir():
        print(f"[adr-generate-scripts] ERROR: ADR directory not found: {adr_dir}", file=sys.stderr)
        return 2

    adr_files = sorted(adr_dir.glob("ADR-*.md"))
    if not adr_files:
        print(f"[adr-generate-scripts] No ADR-*.md files found in {adr_dir}", file=sys.stderr)
        return 0

    total_written: List[Path] = []
    skipped_no_enforcement = 0
    skipped_no_rules = 0
    errors = 0

    for adr_path in adr_files:
        adr_id = adr_id_from_filename(adr_path.name)
        if not adr_id:
            continue

        try:
            content = adr_path.read_text(encoding="utf-8")
        except OSError as e:
            print(f"[adr-generate-scripts] WARN: cannot read {adr_path}: {e}", file=sys.stderr)
            errors += 1
            continue

        try:
            enforcement = extract_enforcement(content)
        except ValueError as e:
            print(f"[adr-generate-scripts] WARN: {adr_path.name}: {e}", file=sys.stderr)
            errors += 1
            continue

        if enforcement is None:
            skipped_no_enforcement += 1
            continue

        written, unsupported = generate_scripts_for_adr(
            adr_id, enforcement, output_dir, langs
        )
        if unsupported:
            print(
                f"[adr-generate-scripts] ERROR: {adr_path.name}: standalone "
                f"validator cannot preserve: {', '.join(unsupported)}; see "
                f"{output_dir / adr_id / 'capabilities.json'}",
                file=sys.stderr,
            )
            errors += 1
            total_written.extend(written)
            continue
        if not written:
            skipped_no_rules += 1
            continue

        total_written.extend(written)
        for p in written:
            print(f"  generated  {p}")

    print(
        f"\n[adr-generate-scripts] done: {len(total_written)} file(s) written, "
        f"{skipped_no_enforcement} ADR(s) without Enforcement skipped, "
        f"{skipped_no_rules} ADR(s) with no forbid rules skipped"
        + (f", {errors} error(s)" if errors else "")
    )
    return 0 if errors == 0 else 2


if __name__ == "__main__":
    sys.exit(main())
