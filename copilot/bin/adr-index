#!/usr/bin/env python3
"""adr-index: generate ADR indexes for context injection and local README navigation.

Two modes intentionally share one command:

Context mode, used by ADR-004 and CI:
  adr-index
  adr-index --adr-dir docs/adr -o docs/adr/ADR-INDEX.md
  adr-index --adr-dir docs/adr --format json
  adr-index --adr-dir docs/adr --format graph

README mode, used by lifecycle and doctor tooling:
  adr-index docs/adr/
  adr-index --check docs/adr/
  adr-index --check --format json docs/adr/

The context index is a compact one-row-per-ADR map imported by CLAUDE.md. The
README index owns only the sentinel-delimited block in docs/adr/README.md and
preserves all human prose outside it.
"""

from __future__ import annotations

import argparse
import io
import json
import re
import sys
from pathlib import Path
from typing import Dict, List, Optional

sys.path.insert(0, str(Path(__file__).resolve().parent))

_BIN_DIR = Path(__file__).resolve().parent
if str(_BIN_DIR) not in sys.path:
    sys.path.insert(0, str(_BIN_DIR))

from adr_catalog import (
    build_graph_document,
    discover_adr_files,
    enforcement_globs as catalog_enforcement_globs,
    load_adr_records,
)


BEGIN = "<!-- adr-kit-index:begin -->"
END = "<!-- adr-kit-index:end -->"

TITLE_RE = re.compile(r"^#\s+ADR-\d+[:\s]\s*(.+)$", re.MULTILINE)
DECISION_SECTION_RE = re.compile(
    r"^##\s+Decision(.*?)(?=^##|\Z)", re.IGNORECASE | re.MULTILINE | re.DOTALL
)


def _ensure_utf8_streams() -> None:
    for stream_name in ("stdout", "stderr"):
        stream = getattr(sys, stream_name, None)
        if stream is None:
            continue
        buffer = getattr(stream, "buffer", None)
        if buffer is None:
            continue
        try:
            setattr(
                sys,
                stream_name,
                io.TextIOWrapper(buffer, encoding="utf-8", newline="\n"),
            )
        except (AttributeError, ValueError):
            pass


def enforcement_globs(text: str) -> List[str]:
    """Return all path_glob strings from the ADR's Enforcement block."""
    return catalog_enforcement_globs(text)


def discover_files(adr_dir: Path) -> List[Path]:
    return discover_adr_files(adr_dir)


def load_index(adr_dir: Path) -> List[Dict]:
    """Load every ADR in adr_dir as a context-index row. One read per file."""
    return load_adr_records(adr_dir)


def _escape_cell(value: str) -> str:
    return value.replace("|", "\\|").replace("\n", " ").strip()


def render_markdown(rows: List[Dict]) -> str:
    lines = [
        "<!-- Generated by bin/adr-index. Do not edit by hand; regenerate with: bin/adr-index -o docs/adr/ADR-INDEX.md -->",
        "",
        "# ADR Index",
        "",
        "One row per Architecture Decision Record. Scope is the Enforcement "
        "`path_glob` set that governs where the decision applies; only "
        "`Accepted` ADRs are injected at edit time (ADR-004).",
        "",
        "| ADR | Status | Scope | Decision |",
        "| --- | --- | --- | --- |",
    ]
    for row in rows:
        scope = ", ".join(f"`{glob}`" for glob in row["scope"]) if row["scope"] else "-"
        decision = _escape_cell(row["decision"]) or "-"
        lines.append(
            f"| {row['adr_id']} | {row['status']} | {scope} | {decision} |"
        )
    if not rows:
        lines.append("| _(none)_ | | | |")
    return "\n".join(lines) + "\n"


def render_context_json(rows: List[Dict]) -> str:
    payload = [
        {
            "adr_id": row["adr_id"],
            "title": row["title"],
            "status": row["status"],
            "format": row["format"],
            "scope": row["scope"],
            "decision": row["decision"],
            "path": row["path"],
        }
        for row in rows
    ]
    return json.dumps(payload, indent=2, ensure_ascii=False) + "\n"


def render_graph_json(rows: List[Dict]) -> str:
    return json.dumps(
        build_graph_document(rows),
        indent=2,
        ensure_ascii=False,
    ) + "\n"


def _find_adr_dir(explicit: Optional[str]) -> Optional[Path]:
    if explicit:
        path = Path(explicit)
        return path if path.is_dir() else None
    for candidate in (Path("docs/adr"), Path("adr"), Path(".")):
        if candidate.is_dir() and discover_files(candidate):
            return candidate
    return None


def _readme_record(record: Dict) -> Dict:
    return {
        "id": record["adr_id"],
        "title": record["title"],
        "status": record["status"],
        "date": record["date"],
        "supersedes": record["supersedes"],
        "superseded_by": record["superseded_by"],
        "file": record["path"],
    }


def _supersession_note(record: Dict) -> str:
    notes: List[str] = []
    if record.get("superseded_by"):
        notes.append(f"Superseded by {record['superseded_by']}")
    supersedes = record.get("supersedes") or []
    if supersedes:
        notes.append("Supersedes " + ", ".join(supersedes))
    return "; ".join(notes) if notes else "-"


def render_generated_readme_block(records: List[Dict], issues: List[str]) -> str:
    status_counts: Dict[str, int] = {}
    for record in records:
        status_counts[record["status"]] = status_counts.get(record["status"], 0) + 1

    lines = [
        BEGIN,
        "## ADR Index",
        "",
        "Generated by `bin/adr-index`. Do not edit between the sentinels.",
        "",
        "### Summary",
        "",
        "| Metric | Count |",
        "| --- | ---: |",
        f"| Total ADRs | {len(records)} |",
    ]
    for status, count in sorted(status_counts.items()):
        lines.append(f"| {status} | {count} |")
    lines.extend(
        [
            f"| Duplicate IDs | {len(issues)} |",
            "",
            "### Decisions",
            "",
            "| ADR | Title | Status | Date | Supersession | File |",
            "| --- | --- | --- | --- | --- | --- |",
        ]
    )
    for record in records:
        lines.append(
            "| "
            + " | ".join(
                [
                    _escape_cell(record["id"]),
                    _escape_cell(record["title"]),
                    _escape_cell(record["status"]),
                    _escape_cell(record["date"] or "-"),
                    _escape_cell(_supersession_note(record)),
                    _escape_cell(record["file"]),
                ]
            )
            + " |"
        )
    if issues:
        lines.extend(["", "### Index Issues", ""])
        lines.extend(f"- {issue}" for issue in issues)
    lines.append(END)
    lines.append("")
    return "\n".join(lines)


def default_readme(block: str) -> str:
    return "\n".join(
        [
            "# Architecture Decision Records",
            "",
            "This README contains the generated local ADR index.",
            "",
            block.rstrip(),
            "",
        ]
    )


def update_readme(existing: Optional[str], block: str) -> str:
    if existing is None:
        return default_readme(block)
    if BEGIN in existing and END in existing:
        before, rest = existing.split(BEGIN, 1)
        _old, after = rest.split(END, 1)
        return before.rstrip() + "\n\n" + block.rstrip() + after
    return existing.rstrip() + "\n\n" + block.rstrip() + "\n"


def build_readme_payload(adr_dir: Path, readme: Path) -> Dict:
    index_rows = load_index(adr_dir)
    records = [_readme_record(record) for record in index_rows]
    grouped: Dict[str, List[str]] = {}
    for record in records:
        grouped.setdefault(record["id"], []).append(record["file"])
    issues = [
        f"{adr_id} appears in multiple files: {', '.join(files)}"
        for adr_id, files in sorted(grouped.items())
        if len(files) > 1
    ]
    block = render_generated_readme_block(records, issues)
    existing = readme.read_text(encoding="utf-8") if readme.exists() else None
    desired_readme = update_readme(existing, block)
    markdown_path = adr_dir / "ADR-INDEX.md"
    json_path = adr_dir / "ADR-INDEX.json"
    desired_markdown = render_markdown(index_rows)
    desired_json = render_graph_json(index_rows)
    current_markdown = (
        markdown_path.read_text(encoding="utf-8") if markdown_path.exists() else None
    )
    current_json = json_path.read_text(encoding="utf-8") if json_path.exists() else None
    readme_changed = existing != desired_readme
    markdown_changed = current_markdown != desired_markdown
    json_changed = current_json != desired_json
    return {
        "adr_dir": str(adr_dir),
        "readme": str(readme),
        "context_markdown": str(markdown_path),
        "context_json": str(json_path),
        "summary": {
            "total": len(records),
            "duplicates": len(issues),
            "changed": readme_changed or markdown_changed or json_changed,
            "readme_changed": readme_changed,
            "context_markdown_changed": markdown_changed,
            "context_json_changed": json_changed,
        },
        "issues": issues,
        "records": records,
        "_desired_readme": desired_readme,
        "_desired_markdown": desired_markdown,
        "_desired_json": desired_json,
    }


def render_readme_text(payload: Dict, check: bool) -> str:
    summary = payload["summary"]
    lines = [
        f"adr-index {'check' if check else 'write'}: {payload['readme']}",
        f"ADRs: {summary['total']}; duplicates: {summary['duplicates']}; changed: {summary['changed']}",
        "Artifacts: "
        f"README={summary['readme_changed']}; "
        f"Markdown={summary['context_markdown_changed']}; "
        f"JSON={summary['context_json_changed']}",
    ]
    for issue in payload["issues"]:
        lines.append(f"  issue: {issue}")
    return "\n".join(lines)


def _should_use_context_mode(args: argparse.Namespace) -> bool:
    if args.output or args.adr_dir_opt:
        return True
    if args.check or args.readme:
        return False
    return args.adr_dir_arg is None


def _run_context_mode(args: argparse.Namespace) -> int:
    fmt = args.format or "md"
    if fmt not in {"md", "json", "graph"}:
        sys.stderr.write("adr-index: context mode supports --format md|json|graph\n")
        return 2
    adr_dir = _find_adr_dir(args.adr_dir_opt or args.adr_dir_arg)
    rows = load_index(adr_dir) if adr_dir is not None else []
    if fmt == "graph":
        text = render_graph_json(rows)
    elif fmt == "json":
        text = render_context_json(rows)
    else:
        text = render_markdown(rows)

    if args.output:
        try:
            Path(args.output).write_text(text, encoding="utf-8")
        except OSError as exc:
            sys.stderr.write(f"adr-index: cannot write {args.output}: {exc}\n")
            return 0
    else:
        sys.stdout.write(text)
    return 0


def _run_readme_mode(args: argparse.Namespace) -> int:
    fmt = args.format or "text"
    if fmt not in {"text", "json"}:
        sys.stderr.write("adr-index: README mode supports --format text|json\n")
        return 2

    adr_dir = Path(args.adr_dir_arg or args.adr_dir_opt or "docs/adr")
    readme = Path(args.readme) if args.readme else adr_dir / "README.md"
    payload = build_readme_payload(adr_dir, readme)
    desired_readme = payload.pop("_desired_readme")
    desired_markdown = payload.pop("_desired_markdown")
    desired_json = payload.pop("_desired_json")

    if fmt == "json":
        print(json.dumps(payload, indent=2))
    else:
        print(render_readme_text(payload, args.check))

    if payload["issues"]:
        return 1
    if args.check:
        return 1 if payload["summary"]["changed"] else 0

    adr_dir.mkdir(parents=True, exist_ok=True)
    readme.parent.mkdir(parents=True, exist_ok=True)
    readme.write_text(desired_readme, encoding="utf-8")
    (adr_dir / "ADR-INDEX.md").write_text(desired_markdown, encoding="utf-8")
    (adr_dir / "ADR-INDEX.json").write_text(desired_json, encoding="utf-8")
    return 0


def main(argv: Optional[List[str]] = None) -> int:
    _ensure_utf8_streams()
    parser = argparse.ArgumentParser(
        prog="adr-index",
        description="Generate compact ADR context indexes and docs/adr README indexes.",
    )
    parser.add_argument(
        "adr_dir_arg",
        nargs="?",
        help="ADR directory. Positional form selects README mode unless -o/--adr-dir is used.",
    )
    parser.add_argument(
        "--adr-dir",
        dest="adr_dir_opt",
        default=None,
        help="Directory holding ADR-*.md for context mode.",
    )
    parser.add_argument(
        "--format",
        choices=("md", "text", "json", "graph"),
        default=None,
        help="Output format. Context: md/json (legacy list)/graph. README: text/json.",
    )
    parser.add_argument(
        "-o",
        "--output",
        default=None,
        help="Context mode output path, usually docs/adr/ADR-INDEX.md.",
    )
    parser.add_argument(
        "--readme",
        default=None,
        help="README path for README mode (default: <adr_dir>/README.md).",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="README mode: exit 1 if README is stale or duplicate ADR ids exist.",
    )
    args = parser.parse_args(argv)

    if _should_use_context_mode(args):
        return _run_context_mode(args)
    return _run_readme_mode(args)


if __name__ == "__main__":
    sys.exit(main())
