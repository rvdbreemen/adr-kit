#!/usr/bin/env python3
"""adr-index: generate ADR indexes for context injection and local README navigation.

Two modes intentionally share one command:

Context mode, used by ADR-004 and CI:
  adr-index
  adr-index --adr-dir docs/adr -o docs/adr/ADR-INDEX.md
  adr-index --adr-dir docs/adr --format json
  adr-index --adr-dir docs/adr --format graph

README mode, used by lifecycle and doctor tooling:
  adr-index docs/adr/
  adr-index --check docs/adr/
  adr-index --check --format json docs/adr/

The context index is a compact one-row-per-ADR map imported by CLAUDE.md. The
README index owns only the sentinel-delimited block in docs/adr/README.md and
preserves all human prose outside it.
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import io
import json
import re
import sys
from pathlib import Path
from typing import Dict, List, Optional

_BIN_DIR = Path(__file__).resolve().parent


def _load_sibling(name: str):
    """Import bin/<name>.py by explicit path, WITHOUT touching sys.path.

    SEC-HIGH (TASK-62): `sys.path.insert(0, _BIN_DIR)` put this directory ahead
    of the standard library for every import, so a module committed next to
    this script executed as code -- and it re-added the very directory
    CPython's -P / PYTHONSAFEPATH removes. Siblings are registered in
    sys.modules under their bare name, so the plain `from adr_* import ...`
    statements below (and the lazy ones inside functions) resolve from the
    cache instead of the path. bin/adr-judge carries the full rationale.
    """
    cached = sys.modules.get(name)
    if cached is not None:
        return cached
    loader = importlib.machinery.SourceFileLoader(name, str(_BIN_DIR / f"{name}.py"))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


# Dependency order: adr_catalog imports adr_format and adr_schema.
_load_sibling("adr_format")
_load_sibling("adr_schema")
_load_sibling("adr_catalog")

_load_sibling("adr_index_core")

from adr_index_core import (
    BEGIN,
    END,
    INDEX_ARTIFACTS,
    _ensure_utf8_streams,
    build_readme_payload,
    default_readme,
    discover_files,
    enforcement_globs,
    index_probably_fresh,
    load_index,
    render_context_json,
    render_generated_readme_block,
    render_graph_json,
    render_markdown,
    render_readme_text,
    stale_index_artifacts,
    update_readme,
    _find_adr_dir,
)


def _should_use_context_mode(args: argparse.Namespace) -> bool:
    if args.output or args.adr_dir_opt:
        return True
    if args.check or args.readme:
        return False
    return args.adr_dir_arg is None


def _run_context_mode(args: argparse.Namespace) -> int:
    fmt = args.format or "md"
    if fmt not in {"md", "json", "graph"}:
        sys.stderr.write("adr-index: context mode supports --format md|json|graph\n")
        return 2
    adr_dir = _find_adr_dir(args.adr_dir_opt or args.adr_dir_arg)
    rows = load_index(adr_dir) if adr_dir is not None else []
    if fmt == "graph":
        text = render_graph_json(rows)
    elif fmt == "json":
        text = render_context_json(rows)
    else:
        text = render_markdown(rows)

    if args.output:
        try:
            Path(args.output).write_text(text, encoding="utf-8")
        except OSError as exc:
            sys.stderr.write(f"adr-index: cannot write {args.output}: {exc}\n")
            return 0
    else:
        sys.stdout.write(text)
    return 0


def _run_readme_mode(args: argparse.Namespace) -> int:
    fmt = args.format or "text"
    if fmt not in {"text", "json"}:
        sys.stderr.write("adr-index: README mode supports --format text|json\n")
        return 2

    adr_dir = Path(args.adr_dir_arg or args.adr_dir_opt or "docs/adr")
    readme = Path(args.readme) if args.readme else adr_dir / "README.md"
    payload = build_readme_payload(adr_dir, readme)
    desired_readme = payload.pop("_desired_readme")
    desired_markdown = payload.pop("_desired_markdown")
    desired_json = payload.pop("_desired_json")

    if fmt == "json":
        print(json.dumps(payload, indent=2))
    else:
        print(render_readme_text(payload, args.check))

    if payload["issues"]:
        return 1
    if args.check:
        return 1 if payload["summary"]["changed"] else 0

    adr_dir.mkdir(parents=True, exist_ok=True)
    readme.parent.mkdir(parents=True, exist_ok=True)
    readme.write_text(desired_readme, encoding="utf-8")
    (adr_dir / "ADR-INDEX.md").write_text(desired_markdown, encoding="utf-8")
    (adr_dir / "ADR-INDEX.json").write_text(desired_json, encoding="utf-8")
    return 0


def main(argv: Optional[List[str]] = None) -> int:
    _ensure_utf8_streams()
    parser = argparse.ArgumentParser(
        prog="adr-index",
        description="Generate compact ADR context indexes and docs/adr README indexes.",
    )
    parser.add_argument(
        "adr_dir_arg",
        nargs="?",
        help="ADR directory. Positional form selects README mode unless -o/--adr-dir is used.",
    )
    parser.add_argument(
        "--adr-dir",
        dest="adr_dir_opt",
        default=None,
        help="Directory holding ADR-*.md for context mode.",
    )
    parser.add_argument(
        "--format",
        choices=("md", "text", "json", "graph"),
        default=None,
        help="Output format. Context: md/json (legacy list)/graph. README: text/json.",
    )
    parser.add_argument(
        "-o",
        "--output",
        default=None,
        help="Context mode output path, usually docs/adr/ADR-INDEX.md.",
    )
    parser.add_argument(
        "--readme",
        default=None,
        help="README path for README mode (default: <adr_dir>/README.md).",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="README mode: exit 1 if README is stale or duplicate ADR ids exist.",
    )
    args = parser.parse_args(argv)

    if _should_use_context_mode(args):
        return _run_context_mode(args)
    return _run_readme_mode(args)


if __name__ == "__main__":
    sys.exit(main())
