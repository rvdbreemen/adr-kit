#!/usr/bin/env python3
"""adr-migrate: plan or apply safe ADR metadata and profile migrations.

Migration preserves decision prose and invariant sections. For recognizable
legacy filenames it can also normalize the H1 and supported profile extensions
so the reported rename produces a strict-lintable ADR.

Usage:
  adr-migrate                         # migrate docs/adr/
  adr-migrate docs/decisions/         # migrate a directory
  adr-migrate docs/adr/ADR-001-x.md   # migrate one file
  adr-migrate --plan docs/adr/        # detect formats; never write
  adr-migrate --check docs/adr/       # exit 1 when any file needs migration
  adr-migrate --dry-run --format json docs/adr/
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import re
import sys
from pathlib import Path
from typing import Dict, List

_BIN_DIR = Path(__file__).resolve().parent


def _load_sibling(name: str):
    """Import bin/<name>.py by explicit path, WITHOUT touching sys.path.

    SEC-HIGH (TASK-62): `sys.path.insert(0, _BIN_DIR)` put this directory ahead
    of the standard library for every import, so a module committed next to
    this script executed as code -- and it re-added the very directory
    CPython's -P / PYTHONSAFEPATH removes. Siblings are registered in
    sys.modules under their bare name, so the plain `from adr_* import ...`
    statements below (and the lazy ones inside functions) resolve from the
    cache instead of the path. bin/adr-judge carries the full rationale.
    """
    cached = sys.modules.get(name)
    if cached is not None:
        return cached
    loader = importlib.machinery.SourceFileLoader(name, str(_BIN_DIR / f"{name}.py"))
    spec = importlib.util.spec_from_loader(name, loader)
    module = importlib.util.module_from_spec(spec)
    sys.modules[name] = module
    loader.exec_module(module)
    return module


# Dependency order: adr_catalog imports adr_format and adr_schema.
_load_sibling("adr_format")
_load_sibling("adr_schema")
_load_sibling("adr_catalog")

from adr_format import (
    AdrFormatError,
    classify_format,
    convert_profile,
    is_migration_candidate,
    migration_notice,
    normalize_profile,
    unfilled_required_sections,
)
from adr_schema import migrate_text
from adr_catalog import load_adr_record


ADR_FILE_RE = re.compile(r"(?i)^ADR-\d{1,4}-.*\.md$")
SUGGESTION_STOP_WORDS = {
    "adopt",
    "and",
    "for",
    "from",
    "into",
    "the",
    "use",
    "with",
}


def discover_files(target: Path) -> List[Path]:
    if target.is_file():
        return [target]
    if not target.is_dir():
        return []
    return sorted(
        (path for path in target.glob("ADR-*.md") if ADR_FILE_RE.match(path.name)),
        key=lambda p: p.name.lower(),
    )


def discover_plan_files(target: Path) -> List[Path]:
    """Find canonical and recognizable legacy ADR files for read-only planning."""
    if target.is_file():
        return [target]
    if not target.is_dir():
        return []
    candidates: List[Path] = []
    for path in sorted(target.glob("*.md"), key=lambda p: p.name.lower()):
        try:
            text = path.read_text(encoding="utf-8", errors="replace")
        except OSError:
            if ADR_FILE_RE.match(path.name):
                candidates.append(path)
            continue
        if is_migration_candidate(path, text):
            candidates.append(path)
    return candidates


def plan_file(path: Path) -> Dict:
    try:
        before = path.read_text(encoding="utf-8", errors="replace")
    except OSError as exc:
        notice = {
            "file": str(path),
            "detected_format": "unknown",
            "supported": False,
            "deterministic": False,
            "action": "guided-migration",
            "message": f"Could not read ADR: {exc}",
            "preview_command": None,
            "apply_command": None,
            "guided_command": None,
            "rename_to": None,
            "metadata_change": False,
            "metadata_issues": [str(exc)],
            "writes_automatically": False,
        }
        return {
            "file": str(path),
            "detected_format": "unknown",
            "notice": notice,
        }
    _after, changed, issues = migrate_text(before, path)
    return {
        "file": str(path),
        "detected_format": classify_format(before),
        "notice": migration_notice(
            before,
            path,
            metadata_changed=changed,
            metadata_issues=issues,
            migrate_command=str(Path(__file__).resolve()),
        ),
    }


def migrate_file(
    path: Path,
    write: bool,
    to_profile: str | None = None,
    from_profile: str | None = None,
) -> Dict:
    try:
        before = path.read_text(encoding="utf-8")
    except OSError as exc:
        return {
            "file": str(path),
            "changed": False,
            "ok": False,
            "issues": [str(exc)],
        }

    after, changed, issues = migrate_text(before, path)
    detected_source = None
    unfilled: List[str] = []
    if not issues and to_profile is not None:
        try:
            after, detected_source = convert_profile(
                after, to_profile, source=from_profile
            )
            changed = after != before
            # A conversion that adds a missing heading writes a TODO placeholder
            # into it. That is a hole, not content, and saying nothing about it
            # is how a migrated record reaches `adr accept` still unwritten.
            # Report only what THIS run left unfilled, so a hole the author
            # already had is not blamed on the migration.
            unfilled = [
                s
                for s in unfilled_required_sections(after, to_profile)
                if s not in unfilled_required_sections(before, to_profile)
            ]
        except AdrFormatError as exc:
            issues = [str(exc)]
    if not issues and changed and write:
        try:
            path.write_text(after, encoding="utf-8")
        except OSError as exc:
            return {
                "file": str(path),
                "changed": False,
                "ok": False,
                "issues": [str(exc)],
            }

    return {
        "file": str(path),
        "changed": changed,
        "ok": not issues,
        "issues": issues,
        "source_profile": detected_source,
        "target_profile": to_profile,
        "unfilled_sections": unfilled,
    }


def render_text(target: Path, results: List[Dict], check: bool, dry_run: bool) -> str:
    changed = [r for r in results if r["changed"]]
    failed = [r for r in results if not r["ok"]]
    mode = "check" if check else ("dry-run" if dry_run else "write")
    lines = [
        f"adr-migrate {mode}: {target}",
        f"Files: {len(results)}; changed: {len(changed)}; failed: {len(failed)}",
    ]
    unfilled_any = False
    for result in results:
        if result["changed"]:
            prefix = "needs migration" if check or dry_run else "migrated"
            lines.append(f"  {prefix}: {result['file']}")
        # Say what the conversion could not write for you. A required section
        # that still carries a TODO placeholder reads as complete to anything
        # counting headings, so leaving this unsaid is what lets an unfinished
        # record reach acceptance.
        for section in result.get("unfilled_sections") or []:
            unfilled_any = True
            lines.append(f"    needs content: ## {section}")
        if result["issues"]:
            lines.append(f"  failed: {result['file']}")
            for issue in result["issues"]:
                lines.append(f"    {issue}")
    if unfilled_any:
        lines.append(
            "Sections marked 'needs content' hold a placeholder, not an answer. "
            "Nothing blocks on that: an imported record must not fail a gate on "
            "arrival. adr-readiness reports it and adr accept will not refuse, "
            "so write them before you accept."
        )
    if not results:
        lines.append("No ADR files found.")
    return "\n".join(lines)


def render_plan_text(target: Path, scanned: List[Dict]) -> str:
    notices = [item["notice"] for item in scanned if item["notice"] is not None]
    deterministic = [item for item in notices if item["deterministic"]]
    guided = [item for item in notices if not item["deterministic"]]
    formats: Dict[str, int] = {}
    for item in scanned:
        profile = item["detected_format"]
        formats[profile] = formats.get(profile, 0) + 1

    lines = [
        f"adr-migrate plan: {target}",
        (
            f"Files scanned: {len(scanned)}; notices: {len(notices)}; "
            f"deterministic: {len(deterministic)}; guided: {len(guided)}"
        ),
    ]
    if formats:
        lines.append(
            "Detected formats: "
            + ", ".join(f"{name}={formats[name]}" for name in sorted(formats))
        )
    for notice in notices:
        mode = "deterministic" if notice["deterministic"] else "guided"
        lines.append(
            f"  {notice['detected_format']} ({mode}): {notice['file']}"
        )
        lines.append(f"    {notice['message']}")
        if notice.get("preview_command"):
            lines.append(f"    preview: {notice['preview_command']}")
        if notice.get("rename_to"):
            lines.append(
                "    after approved migration, rename to: "
                + notice["rename_to"]
            )
        if notice.get("guided_command"):
            lines.append(f"    next: {notice['guided_command']}")
    if not notices:
        lines.append("No migration notices.")
    lines.append("No files changed. Migration is never automatic.")
    return "\n".join(lines)


def suggest_retrieval_file(path: Path) -> Dict:
    """Derive review-only retrieval candidates from existing ADR evidence."""
    try:
        record = load_adr_record(path)
    except (OSError, UnicodeError, ValueError) as exc:
        return {
            "file": str(path),
            "ok": False,
            "issues": [str(exc)],
            "requires_human_approval": True,
            "writes_automatically": False,
        }
    title_topics = [
        token
        for token in re.findall(r"[A-Za-z0-9][A-Za-z0-9_.-]{2,}", record["title"])
        if token.casefold() not in SUGGESTION_STOP_WORDS
    ][:8]
    path_components = []
    symbol_candidates = []
    for pointer in record.get("verified_in", []):
        path_part, separator, symbol = pointer.partition(":")
        if separator and symbol and not re.match(r"^[A-Za-z]$", path_part):
            symbol_candidates.append(symbol)
        parts = Path(path_part.replace("\\", "/")).parts
        if parts:
            path_components.append(parts[0])
    for pattern in record.get("scope", []):
        parts = Path(pattern.replace("\\", "/")).parts
        if parts and not parts[0].startswith("*"):
            path_components.append(parts[0])
    existing = {
        field: list(record.get(field, []))
        for field in ("topics", "aliases", "components", "symbols")
    }
    contract = record.get("decision_contract", {})
    has_contract = any(contract.get(key) for key in contract)
    candidates = {
        "topics": existing["topics"] or sorted(
            set(title_topics), key=lambda value: (value.casefold(), value)
        ),
        "aliases": existing["aliases"],
        "components": existing["components"] or sorted(
            set(path_components), key=lambda value: (value.casefold(), value)
        )[:8],
        "symbols": existing["symbols"] or sorted(
            set(symbol_candidates), key=lambda value: (value.casefold(), value)
        )[:8],
        "context_scope": record.get("context_scope", "selective"),
    }
    decision_contract = contract if has_contract else {
        "must": [record["decision"]] if record.get("decision") else [],
        "must_not": [],
        "exceptions": [],
        "verification": [
            *(
                [f"Run the named gate: {record['gate']}"]
                if record.get("gate")
                else []
            ),
            *[f"Verify: {pointer}" for pointer in record.get("verified_in", [])[:8]],
        ],
    }
    return {
        "file": str(path),
        "adr_id": record["adr_id"],
        "ok": True,
        "status": record["status"],
        "binding": record["binding"],
        "existing": {**existing, "decision_contract": contract},
        "suggested": {
            **candidates,
            "decision_contract": decision_contract,
        },
        "source_evidence": {
            "title": record["title"],
            "decision_summary": record["decision"],
            "scope": record["scope"],
            "verified_in": record["verified_in"],
            "gate": record["gate"],
        },
        "requires_human_approval": True,
        "writes_automatically": False,
        "warning": (
            "Candidates are derived from existing text and paths; a human must "
            "confirm meaning before editing the ADR."
        ),
    }


def render_retrieval_suggestions(target: Path, results: List[Dict]) -> str:
    lines = [
        f"adr-migrate retrieval dry-run: {target}",
        f"Files: {len(results)}; suggestions: {sum(item.get('ok', False) for item in results)}",
    ]
    for item in results:
        if not item.get("ok"):
            lines.append(f"  failed: {item['file']}: {item.get('issues', [])}")
            continue
        suggested = item["suggested"]
        lines.append(f"  {item['adr_id']}: {item['file']}")
        lines.append(f"    topics: {suggested['topics']}")
        lines.append(f"    components: {suggested['components']}")
        lines.append(f"    symbols: {suggested['symbols']}")
        lines.append(
            "    Decision Contract candidate items: "
            + str(sum(len(values) for values in suggested["decision_contract"].values()))
        )
    lines.append("No files changed. Every candidate requires human approval.")
    return "\n".join(lines)


def main(argv: List[str] | None = None) -> int:
    parser = argparse.ArgumentParser(
        prog="adr-migrate",
        description="Add canonical adr-kit frontmatter to ADR files.",
    )
    parser.add_argument(
        "path",
        nargs="?",
        default="docs/adr",
        help="ADR file or directory (default: docs/adr)",
    )
    parser.add_argument(
        "--check",
        action="store_true",
        help="do not write; exit 1 if any ADR needs migration",
    )
    parser.add_argument(
        "--plan",
        action="store_true",
        help="detect supported and legacy formats; report migration advice; never write",
    )
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="do not write; report what would change",
    )
    parser.add_argument(
        "--format",
        choices=["text", "json"],
        default="text",
        help="output format (default: text)",
    )
    parser.add_argument(
        "--to-profile",
        choices=["madr", "nygard", "canonical"],
        default=None,
        help="also convert supported body headings to this profile",
    )
    parser.add_argument(
        "--from-profile",
        choices=["madr", "nygard", "canonical"],
        default=None,
        help="explicit source profile for an unknown or hybrid document",
    )
    parser.add_argument(
        "--suggest-retrieval",
        action="store_true",
        help=(
            "with --dry-run, suggest selective metadata and Decision Contract "
            "candidates from existing ADR evidence; never writes"
        ),
    )
    parser.add_argument(
        "--enable-llm-judge",
        action="store_true",
        help=(
            "opt-out migration for the LLM judge: drop the legacy "
            "llm_judge:false from every Accepted ADR so the true default "
            "applies. An ADR with no Enforcement rules has no scope to narrow "
            "with, so it is marked no-code-surface instead of becoming a call "
            "on every commit; override that per ADR with --force-enable."
        ),
    )
    parser.add_argument(
        "--except",
        dest="opt_out",
        default="",
        metavar="ADR-002,ADR-004",
        help="with --enable-llm-judge: ADRs to opt out; needs --reason",
    )
    parser.add_argument(
        "--force-enable",
        dest="force_enable",
        default="",
        metavar="ADR-014",
        help=(
            "with --enable-llm-judge: enable a rule-less ADR anyway, "
            "accepting one model call on every commit until it declares a scope"
        ),
    )
    parser.add_argument(
        "--reason",
        default="",
        help="with --except: why the LLM pass stays off, recorded in the ADR",
    )
    args = parser.parse_args(argv)

    if args.enable_llm_judge and (
        args.plan or args.check or args.to_profile or args.from_profile
        or args.suggest_retrieval
    ):
        parser.error(
            "--enable-llm-judge cannot be combined with --plan, --check, "
            "--to-profile, --from-profile, or --suggest-retrieval"
        )
    if (args.opt_out or args.force_enable or args.reason) and not args.enable_llm_judge:
        parser.error(
            "--except, --force-enable and --reason require --enable-llm-judge"
        )

    if args.plan and (
        args.check or args.dry_run or args.to_profile or args.from_profile
        or args.suggest_retrieval
    ):
        parser.error(
            "--plan cannot be combined with --check, --dry-run, "
            "--to-profile, or --from-profile"
        )
    if args.suggest_retrieval and (
        not args.dry_run
        or args.check
        or args.to_profile
        or args.from_profile
    ):
        parser.error(
            "--suggest-retrieval requires --dry-run and cannot be combined "
            "with --check, --to-profile, or --from-profile"
        )

    target = Path(args.path)
    if args.enable_llm_judge:
        migration = _load_sibling("adr_llm_judge_migration")
        adr_dir = target if target.is_dir() else target.parent
        split = lambda raw: [p.strip() for p in raw.split(",") if p.strip()]
        try:
            result = migration.apply(
                adr_dir,
                opt_out_ids=split(args.opt_out),
                force_enable_ids=split(args.force_enable),
                opt_out_reason=args.reason,
                dry_run=args.dry_run,
            )
        except ValueError as exc:
            print(f"[adr-migrate] ERROR: {exc}", file=sys.stderr)
            return 2
        if args.format == "json":
            print(json.dumps(result, indent=2, ensure_ascii=False))
        else:
            verb = "would enable" if args.dry_run else "enabled"
            print(f"LLM judge {verb}: {len(result['enabled'])} ADR(s)")
            for row in result["enabled"]:
                note = " (no scope declared: judged on every commit)" if row["unbounded_scope"] else ""
                print(f"  + {row['adr']} ({row['rules']} rule(s)){note}")
            if result["opted_out"]:
                verb = "would stay off" if args.dry_run else "left off"
                print(f"LLM judge {verb}: {len(result['opted_out'])} ADR(s)")
                for row in result["opted_out"]:
                    print(f"  - {row['adr']}: {row['reason']}")
            if not result["enabled"] and not result["opted_out"]:
                print("Nothing to change; every ADR already carries a decision.")
            # The whole-set cost picture, not just this run's delta. On an
            # upgraded repository the already-enabled ADRs dominate, and every
            # unscoped one costs an isolated model call per commit (TASK-63),
            # so the delta alone reads as cost-free when the pass is anything
            # but: one operator accepted a "0 unbounded" dry-run on a set that
            # ended at 64 unscoped of 68 judged, at ~20 s per call.
            summary = result.get("summary") or {}
            judged = summary.get("judged_after", 0)
            unbounded = summary.get("unbounded_after", 0)
            tense = "would judge" if args.dry_run else "judges"
            print(
                f"LLM pass after this migration {tense}: {judged} ADR(s), "
                f"{unbounded} without any path_glob"
            )
            if unbounded:
                print(
                    "  An unscoped ADR is in scope on EVERY commit, one "
                    "isolated call each. Narrow them with path_glob rules, or "
                    "run the LLM pass on a cadence (guardian llm tier) instead "
                    "of per commit."
                )
        return 0

    if args.plan:
        scanned = [plan_file(path) for path in discover_plan_files(target)]
        notices = [
            item["notice"] for item in scanned if item["notice"] is not None
        ]
        deterministic = [item for item in notices if item["deterministic"]]
        guided = [item for item in notices if not item["deterministic"]]
        formats: Dict[str, int] = {}
        for item in scanned:
            profile = item["detected_format"]
            formats[profile] = formats.get(profile, 0) + 1
        payload = {
            "target": str(target),
            "mode": "plan",
            "read_only": True,
            "summary": {
                "total": len(scanned),
                "notices": len(notices),
                "deterministic": len(deterministic),
                "guided": len(guided),
                "formats": formats,
            },
            "files": notices,
        }
        if args.format == "json":
            print(json.dumps(payload, indent=2))
        else:
            print(render_plan_text(target, scanned))
        return 0

    if args.suggest_retrieval:
        results = [
            suggest_retrieval_file(path)
            for path in discover_files(target)
        ]
        payload = {
            "target": str(target),
            "mode": "retrieval-suggestions",
            "read_only": True,
            "requires_human_approval": True,
            "writes_automatically": False,
            "summary": {
                "total": len(results),
                "suggestions": sum(item.get("ok", False) for item in results),
                "failed": sum(not item.get("ok", False) for item in results),
            },
            "files": results,
        }
        if args.format == "json":
            print(json.dumps(payload, indent=2))
        else:
            print(render_retrieval_suggestions(target, results))
        return 2 if payload["summary"]["failed"] else 0

    files = discover_files(target)
    write = not args.check and not args.dry_run
    try:
        to_profile = (
            normalize_profile(args.to_profile) if args.to_profile else None
        )
    except AdrFormatError as exc:
        print(f"adr-migrate: {exc}", file=sys.stderr)
        return 2
    results = [
        migrate_file(
            path,
            write=write,
            to_profile=to_profile,
            from_profile=args.from_profile,
        )
        for path in files
    ]

    failed = [r for r in results if not r["ok"]]
    changed = [r for r in results if r["changed"]]
    payload = {
        "target": str(target),
        "mode": "check" if args.check else ("dry-run" if args.dry_run else "write"),
        "summary": {
            "total": len(results),
            "changed": len(changed),
            "failed": len(failed),
        },
        "files": results,
    }

    if args.format == "json":
        print(json.dumps(payload, indent=2))
    else:
        print(render_text(target, results, check=args.check, dry_run=args.dry_run))

    if failed:
        return 2
    if args.check and changed:
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
