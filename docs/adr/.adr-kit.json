{
  "judge": {
    "llm_enabled": true,
    "pre_commit_timeout_ms": 5000,
    "pre_push_timeout_ms": 15000,
    "llm_timeout_ms": 30000,
    "max_diff_bytes": 8388608,
    "warn_on_exceed": true
  },
  "context": {
    "weights": {
      "exact_keyword": 0.4,
      "domain_tag": 0.25,
      "related_decisions": 0.15,
      "acceptance_status": 0.1,
      "recency": 0.1
    },
    "default_limit": 5,
    "min_score": 0.1,
    "probes_file": "adr-context-probes.json",
    "retrieval_completeness": "advisory"
  },
  "retirement": {
    "threshold_days": 90,
    "check_tech_removal": true,
    "check_supersession": true,
    "check_policy_mismatch": true
  },
  "inject": {
    "enabled": true,
    "max_tokens": 400,
    "cooldown_hours": 4
  }
}
