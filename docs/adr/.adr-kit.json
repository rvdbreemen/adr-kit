{
  "judge": {
    "llm_enabled": true,
    "pre_commit_timeout_ms": 5000,
    "max_diff_bytes": 2097152,
    "warn_on_exceed": true
  },
  "context": {
    "default_limit": 5,
    "min_score": 0.1,
    "probes_file": "adr-context-probes.json",
    "retrieval_completeness": "advisory"
  },
  "retirement": {
    "threshold_days": 90,
    "check_tech_removal": true,
    "check_supersession": true,
    "check_policy_mismatch": true
  },
  "inject": {
    "enabled": true,
    "max_tokens": 400,
    "cooldown_hours": 4
  }
}
