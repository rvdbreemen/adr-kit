{
  "schema_version": 1,
  "source": "hooks/manifest.json",
  "policy": {
    "fail_open": true,
    "network_allowed": false,
    "future_clients_allowed": false
  },
  "events": [
    {
      "id": "session-start",
      "command": "session-start",
      "matcher": null,
      "outcome": "task-context",
      "runner_timeout_sec": 5,
      "latency_budget_ms": 500,
      "latency": {
        "p50_ms": 50,
        "p95_ms": 150,
        "hard_timeout_ms": 500
      },
      "clients": {
        "claude-code-cli": "SessionStart",
        "codex-cli": "SessionStart",
        "github-copilot-cli": "sessionStart"
      }
    },
    {
      "id": "user-prompt-submit",
      "command": "user-prompt-submit",
      "matcher": null,
      "outcome": "task-context",
      "runner_timeout_sec": 5,
      "latency_budget_ms": 500,
      "latency": {
        "p50_ms": 75,
        "p95_ms": 250,
        "hard_timeout_ms": 500
      },
      "clients": {
        "claude-code-cli": "UserPromptSubmit",
        "codex-cli": "UserPromptSubmit",
        "github-copilot-cli": "userPromptSubmitted"
      }
    },
    {
      "id": "pre-tool-use",
