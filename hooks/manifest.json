      "latency_budget_ms": 100,
      "latency": {
        "p50_ms": 25,
        "p95_ms": 50,
        "hard_timeout_ms": 100
      },
      "clients": {
        "claude-code-cli": "PostToolUse",
        "codex-cli": "PostToolUse",
        "github-copilot-cli": "postToolUse"
      }
    },
    {
      "id": "plan-exit",
