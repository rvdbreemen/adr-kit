{
  "$comment": "Single declarative registry of every place the release version lives. Both bump writers (scripts/bump-version.py and bin/bump-version), the release gate (scripts/check-release-version.py), the client-adapter generator and the test suite all read THIS file, so adding a version-bearing file is a one-line change here instead of edits in three places that can drift. See ADR-012 and docs/RELEASING.md.",
  "schema_version": 1,
  "canonical": {
    "path": "CHANGELOG.md",
    "kind": "changelog_heading",
    "pattern": "^## \\[(\\d+\\.\\d+\\.\\d+)\\]",
    "label": "CHANGELOG top release heading"
  },
  "sites": [
    {
      "path": ".claude-plugin/plugin.json",
      "kind": "json",
      "pointer": "/version",
      "label": "Claude plugin manifest"
    },
    {
      "path": "codex/.codex-plugin/plugin.json",
      "kind": "json",
      "pointer": "/version",
      "label": "Codex plugin manifest"
    },
    {
      "path": "copilot/plugin.json",
      "kind": "json",
      "pointer": "/version",
      "label": "Copilot plugin manifest"
    },
    {
      "path": "package.json",
      "kind": "regex",
      "pattern": "(\\\"version\\\": \\\")(\\d+\\.\\d+\\.\\d+)(\\\")",
      "label": "OpenCode npm package"
    },
    {
      "path": ".claude-plugin/marketplace.json",
      "kind": "json",
      "pointer": "/plugins/0/version",
      "label": "Claude marketplace manifest"
    },
    {
      "path": ".github/plugin/marketplace.json",
      "kind": "json",
      "pointer": "/plugins/0/version",
      "label": "Copilot marketplace manifest"
    },
    {
      "path": "templates/githooks/pre-commit",
      "kind": "regex",
      "pattern": "(ADR_KIT_WRAPPER_VERSION=\")(\\d+\\.\\d+\\.\\d+)(\")",
      "label": "pre-commit wrapper version stamp"
    },
    {
      "path": ".githooks/pre-commit",
      "kind": "regex",
      "pattern": "(ADR_KIT_WRAPPER_VERSION=\")(\\d+\\.\\d+\\.\\d+)(\")",
      "label": "own pre-commit wrapper stamp (this repo dogfoods the template)"
    },
    {
      "path": "templates/cc-settings/guardian-hook-entry.json",
      "kind": "json",
      "pointer": "/_wrapper_version",
      "label": "guardian hook entry version stamp"
    },
    {
      "path": "templates/adr-kit-guide.md",
      "kind": "regex",
      "pattern": "(<!-- adr-kit-guide v)(\\d+\\.\\d+\\.\\d+)( -->)",
      "label": "adr-kit guide version stamp"
    },
    {
      "path": "README.md",
      "kind": "regex_all",
      "pattern": "(adr-judge@v)(\\d+\\.\\d+\\.\\d+)",
      "label": "README composite-action pin"
    },
    {
      "path": "README.md",
      "kind": "regex_all",
      "pattern": "(rev: v)(\\d+\\.\\d+\\.\\d+)",
      "label": "README pre-commit rev pin"
    },
    {
      "path": "templates/github-workflows/adr-readiness.yml",
      "kind": "regex_all",
      "pattern": "(adr-readiness@v)(\\d+\\.\\d+\\.\\d+)",
      "label": "readiness workflow template action pin"
    },
    {
      "path": "README.md",
      "kind": "regex_all",
      "pattern": "(adr-kit-opencode@)(\\d+\\.\\d+\\.\\d+)",
      "label": "README OpenCode npm pin"
    },
    {
      "path": "CHANGELOG.md",
      "kind": "regex",
      "pattern": "(\\[Unreleased\\]: https://github\\.com/rvdbreemen/adr-kit/compare/v)(\\d+\\.\\d+\\.\\d+)(\\.\\.\\.HEAD)",
      "label": "CHANGELOG Unreleased compare link"
    }
  ],
  "must_not_carry_version": [
    {
      "path": ".agents/plugins/marketplace.json",
      "pointer": "/plugins/0/version",
      "label": "Codex local marketplace",
      "reason": "It points at the local ./codex source and inherits the version from the Codex plugin manifest."
    }
  ],
  "notes": [
    "README history markers such as 'introduced in v0.31.0' are deliberately NOT sites: they record when a feature landed and must never move.",
    "codex/ and copilot/ trees are otherwise generated by scripts/build-client-adapters.py; only their plugin manifests are hand-held version sites listed above."
  ]
}
