{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rvdbreemen/adr-kit/schemas/client-capabilities.schema.json",
  "title": "ADR Kit three-client capability registry",
  "description": "Versioned capability and evidence references for Claude Code CLI, Codex CLI, and GitHub Copilot CLI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "program_scope",
    "ownership",
    "settings",
    "clients",
    "certification"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "program_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "first_class_clients",
        "future_epic"
      ],
      "properties": {
        "first_class_clients": {
          "const": [
            "claude-code-cli",
            "codex-cli",
            "github-copilot-cli"
          ]
        },
        "future_epic": {
          "const": "TASK-43"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical",
        "generated",
        "hand_authored_validated"
      ],
      "properties": {
        "canonical": {
          "$ref": "#/$defs/artifactPatterns"
        },
        "generated": {
          "$ref": "#/$defs/artifactPatterns"
        },
        "hand_authored_validated": {
          "$ref": "#/$defs/artifactPatterns"
        }
      }
    },
    "settings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precedence",
        "definitions"
      ],
      "properties": {
        "precedence": {
          "const": [
            "project",
            "global",
            "detected-default"
          ]
        },
        "definitions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/setting"
          },
          "uniqueItems": true
        }
      }
    },
    "clients": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/client"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "claude-code-cli"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "codex-cli"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "const": "github-copilot-cli"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        }
      ]
    },
    "certification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows_native_required",
        "best_effort_platforms",
        "all_clients_block_release",
        "evidence_schema"
      ],
      "properties": {
        "windows_native_required": {
          "const": true
        },
        "best_effort_platforms": {
          "const": [
            "macos",
            "linux"
          ]
        },
        "all_clients_block_release": {
          "const": true
        },
        "evidence_schema": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "artifactPatterns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "setting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "value_type",
        "scopes"
      ],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "value_type": {
          "enum": [
            "boolean",
            "string",
            "integer"
          ]
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "global",
              "project"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "outcome": {
      "enum": [
        "workflow-discovery",
        "task-context",
        "edit-governance",
        "mcp",
        "pre-commit",
        "lifecycle",
        "doctor"
      ]
    },
    "platformScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "windows",
        "macos",
        "linux"
      ],
      "properties": {
        "windows": {
          "const": "release-required"
        },
        "macos": {
          "const": "best-effort"
        },
        "linux": {
          "const": "best-effort"
        }
      }
    },
    "eventMapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "mode"
      ],
      "properties": {
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "mode": {
          "enum": [
            "native",
            "backstop",
            "unsupported"
          ]
        },
        "native_event": {
          "type": [
            "string",
            "null"
          ]
        },
        "degradation_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "degradation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "outcome",
        "reason",
        "user_effect",
        "backstop",
        "blocks_certification"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "$ref": "#/$defs/outcome"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "user_effect": {
          "type": "string",
          "minLength": 1
        },
        "backstop": {
          "type": "string",
          "minLength": 1
        },
        "blocks_certification": {
          "type": "boolean"
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "fixture",
        "rationale",
        "user_effect"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "fixture": {
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "user_effect": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "probes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "detect",
        "install",
        "update",
        "rollback",
        "disable",
        "remove",
        "doctor"
      ],
      "properties": {
        "detect": {
          "type": "string",
          "minLength": 1
        },
        "install": {
          "type": "string",
          "minLength": 1
        },
        "update": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string",
          "minLength": 1
        },
        "disable": {
          "type": "string",
          "minLength": 1
        },
        "remove": {
          "type": "string",
          "minLength": 1
        },
        "doctor": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "client": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "surface",
        "platforms",
        "required_outcomes",
        "event_mappings",
        "degradations",
        "probes",
        "settings_keys",
        "certification_ref"
      ],
      "properties": {
        "id": {
          "enum": [
            "claude-code-cli",
            "codex-cli",
            "github-copilot-cli"
          ]
        },
        "surface": {
          "const": "cli"
        },
        "platforms": {
          "$ref": "#/$defs/platformScope"
        },
        "required_outcomes": {
          "type": "array",
          "minItems": 7,
          "maxItems": 7,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/outcome"
          },
          "allOf": [
            {
              "contains": {
                "const": "workflow-discovery"
              }
            },
            {
              "contains": {
                "const": "task-context"
              }
            },
            {
              "contains": {
                "const": "edit-governance"
              }
            },
            {
              "contains": {
                "const": "mcp"
              }
            },
            {
              "contains": {
                "const": "pre-commit"
              }
            },
            {
              "contains": {
                "const": "lifecycle"
              }
            },
            {
              "contains": {
                "const": "doctor"
              }
            }
          ]
        },
        "event_mappings": {
          "type": "object",
          "propertyNames": {
            "minLength": 1
          },
          "additionalProperties": {
            "$ref": "#/$defs/eventMapping"
          }
        },
        "degradations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/degradation"
          },
          "uniqueItems": true
        },
        "probes": {
          "$ref": "#/$defs/probes"
        },
        "settings_keys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "certification_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
